    <!-- 3. Hoja de acciones -->
    <div id="widgetAppleActionSheet" class="apple-modal-overlay" style="display: none;">
        <div class="apple-action-sheet">
            <div class="apple-action-group">
                <div class="action-sheet-head">
                    <span class="nx-eyebrow">Acciones rápidas</span>
                    <div>Selecciona una operación para ejecutar</div>
                </div>
                <button class="apple-action-btn" onclick="showToast('Exportación', 'Generando balance general en PDF...', 'info'); closeAppleModal('widgetAppleActionSheet');">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8M16 13H8M16 17H8"/></svg>
                    <span>Exportar balance general (PDF)</span>
                </button>
                <button class="apple-action-btn" onclick="showToast('XML SAT', 'Descargando paquete de 42 comprobantes XML...', 'success'); closeAppleModal('widgetAppleActionSheet');">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.29 7 12 12l8.71-5M12 22V12"/></svg>
                    <span>Descargar paquete masivo XML</span>
                </button>
                <button class="apple-action-btn" onclick="openCustomizationDrawer(); closeAppleModal('widgetAppleActionSheet');">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2;"><circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 11.994 2z"/></svg>
                    <span>Abrir personalizador de paleta</span>
                </button>
            </div>
            <button class="apple-action-cancel" onclick="closeAppleModal('widgetAppleActionSheet')">
                Cancelar
            </button>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Scripts -->
    <script src="assets/js/nexora-common.js"></script>
    <script>
        // Global Click Outside Handler to close all active selects
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.multi-select-wrap')) {
                document.querySelectorAll('.multi-select-wrap').forEach(w => w.classList.remove('open'));
            }
        });

        function toggleSelect(wrapId) {
            const wrap = document.getElementById(wrapId);
            const isOpen = wrap.classList.contains('open');
            // Close others first
            document.querySelectorAll('.multi-select-wrap').forEach(w => w.classList.remove('open'));
            if (!isOpen) {
                wrap.classList.add('open');
                const search = wrap.querySelector('.multi-select-search-bar');
                if (search) search.focus();
            }
        }

        // Iconos SVG reutilizados en las plantillas
        const ICON_X = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:3;"><path d="M18 6 6 18M6 6l12 12"/></svg>';
        const ICON_CHECK = '<svg class="opt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2.6;"><path d="M20 6 9 17l-5-5"/></svg>';
        const ICON_PLUS = '<svg class="opt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2.4;"><path d="M5 12h14M12 5v14"/></svg>';
        const escHtml = (v) => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const ICON_DOWNLOAD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:15px;height:15px;stroke-width:2.2;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>';

        // ==========================================
        // 1. Multi-Select Depts Data & Logic
        // ==========================================
        const deptsData = [
            'Recursos Humanos & Talento',
            'Finanzas & Auditoría Fiscal',
            'Ventas Corporativas & CRM',
            'Logística & Centros de Distribución',
            'Tecnologías de la Información (TI)',
            'Marketing Digital & Growth',
            'Legal & Cumplimiento Normativo',
            'Operaciones de Campo & Mantenimiento'
        ];
        const selectedDepts = new Set(['Finanzas & Auditoría Fiscal', 'Ventas Corporativas & CRM']);

        function renderDeptOptions(filter = '') {
            const list = document.getElementById('deptOptionsList');
            const filtered = deptsData.filter(d => d.toLowerCase().includes(filter.toLowerCase()));

            if (filtered.length === 0) {
                list.innerHTML = `<div class="opt-empty">No se encontraron departamentos.</div>`;
                return;
            }

            list.innerHTML = filtered.map(dept => `
                <label class="multi-select-item">
                    <input type="checkbox" value="${dept}" ${selectedDepts.has(dept) ? 'checked' : ''} onchange="toggleDeptItem(this)">
                    <span>${dept}</span>
                </label>
            `).join('');

            updateDeptUI();
        }

        function filterDeptOptions(val) {
            renderDeptOptions(val);
        }

        function toggleDeptItem(checkbox) {
            if (checkbox.checked) {
                selectedDepts.add(checkbox.value);
            } else {
                selectedDepts.delete(checkbox.value);
            }
            updateDeptUI();
        }

        function selectAllDepts(select) {
            if (select) {
                deptsData.forEach(d => selectedDepts.add(d));
            } else {
                selectedDepts.clear();
            }
            renderDeptOptions(document.getElementById('searchDeptInput').value);
            showToast('Departamentos', select ? 'Todos seleccionados.' : 'Selección vaciada.', 'info');
        }

        function updateDeptUI() {
            const label = document.getElementById('labelDeptSelect');
            const chips = document.getElementById('deptChipsOutput');

            if (selectedDepts.size === 0) {
                label.textContent = 'Seleccionar departamentos...';
                label.className = 'trigger-placeholder';
                chips.innerHTML = `<span class="widget-empty">Ninguno seleccionado aún</span>`;
            } else {
                label.textContent = `${selectedDepts.size} departamento(s) asignado(s)`;
                label.className = 'trigger-value';
                chips.innerHTML = Array.from(selectedDepts).map(d => `
                    <span class="chip">
                        ${d}
                        <span class="chip-remove" role="button" aria-label="Quitar ${d}" onclick="removeDept('${d}')">${ICON_X}</span>
                    </span>
                `).join('');
            }
        }

        function removeDept(dept) {
            selectedDepts.delete(dept);
            renderDeptOptions(document.getElementById('searchDeptInput').value);
        }

        // ==========================================
        // 2. Multi-Select Tags / Skills Logic
        // ==========================================
        const skillsData = ['TypeScript', 'Python', 'Docker', 'Kubernetes', 'PostgreSQL', 'GraphQL', 'Redis', 'AWS Cloud', 'Node.js', 'Figma'];
        const selectedSkills = new Set(['TypeScript', 'Docker', 'PostgreSQL']);

        function renderSkillOptions(filter = '') {
            const list = document.getElementById('skillOptionsList');
            const filtered = skillsData.filter(s => s.toLowerCase().includes(filter.toLowerCase()));

            list.innerHTML = filtered.length === 0
                ? `<div class="opt-empty">Pulsa Enter para crear «${escHtml(filter)}».</div>`
                : filtered.map(skill => `
                <div class="user-option-row ${selectedSkills.has(skill) ? 'selected' : ''}" onclick="toggleSkillItem('${skill}')">
                    ${selectedSkills.has(skill) ? ICON_CHECK : ICON_PLUS}
                    <span>${skill}</span>
                </div>
            `).join('');

            updateSkillUI();
        }

        function filterSkillOptions(val) {
            renderSkillOptions(val);
        }

        // Add Enter key listener to create custom tag on the fly
        document.addEventListener('DOMContentLoaded', () => {
            const skillInput = document.getElementById('searchSkillInput');
            if (skillInput) {
                skillInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const newSkill = skillInput.value.replace(/[<>'"`\\&]/g, '').trim();
                        if (newSkill && !skillsData.includes(newSkill)) {
                            skillsData.unshift(newSkill);
                            selectedSkills.add(newSkill);
                            skillInput.value = '';
                            renderSkillOptions();
                            showToast('Tag Creado', `Etiqueta personalizada "${newSkill}" agregada.`, 'success');
                        }
                    }
                });
            }
        });

        function toggleSkillItem(skill) {
            if (selectedSkills.has(skill)) {
                selectedSkills.delete(skill);
            } else {
                selectedSkills.add(skill);
            }
            renderSkillOptions(document.getElementById('searchSkillInput').value);
        }

        function updateSkillUI() {
            const chips = document.getElementById('skillChipsOutput');
            if (selectedSkills.size === 0) {
                chips.innerHTML = `<span class="widget-empty">Sin habilidades seleccionadas</span>`;
            } else {
                chips.innerHTML = Array.from(selectedSkills).map(s => `
                    <span class="chip chip-tag">
                        ${s}
                        <span class="chip-remove" role="button" aria-label="Quitar ${s}" onclick="removeSkill('${s}')">${ICON_X}</span>
                    </span>
                `).join('');
            }
        }

        function removeSkill(skill) {
            selectedSkills.delete(skill);
            renderSkillOptions(document.getElementById('searchSkillInput').value);
        }

        // ==========================================
        // 3. Categorized Select Logic
        // ==========================================
        const categorizedData = [
            { category: 'Infraestructura & Cloud', items: ['[IT-101] Servidores & Infraestructura', '[IT-102] Licencias SaaS & Software', '[IT-103] Conectividad & Redes Fibra'] },
            { category: 'Operaciones & Logística', items: ['[OP-201] Fletes & Despacho Terrestre', '[OP-202] Almacenamiento & Bodegas', '[OP-203] Mantenimiento Flota'] },
            { category: 'Administración & Finanzas', items: ['[ADM-301] Honorarios Profesionales', '[ADM-302] Auditoría Fiscal SAT', '[ADM-303] Seguros Corporativos'] }
        ];

        let selectedCategoryItem = '[IT-101] Servidores & Infraestructura';

        function renderCategoryOptions(filter = '') {
            const list = document.getElementById('catOptionsList');
            let html = '';

            categorizedData.forEach(cat => {
                const matched = cat.items.filter(i => i.toLowerCase().includes(filter.toLowerCase()) || cat.category.toLowerCase().includes(filter.toLowerCase()));
                if (matched.length > 0) {
                    html += `<div class="group-header">${cat.category}</div>`;
                    matched.forEach(item => {
                        const m = item.match(/^\[([^\]]+)\]\s*(.*)$/);
                        html += `
                            <div class="user-option-row ${item === selectedCategoryItem ? 'selected' : ''}" onclick="selectCatItem('${item}')">
                                ${m ? `<span class="opt-code">${m[1]}</span><span>${m[2]}</span>` : `<span>${item}</span>`}
                            </div>
                        `;
                    });
                }
            });

            list.innerHTML = html || `<div class="opt-empty">Sin partidas para «${escHtml(filter)}».</div>`;
        }

        function filterCategoryOptions(val) {
            renderCategoryOptions(val);
        }

        function selectCatItem(item) {
            selectedCategoryItem = item;
            document.getElementById('labelCatSelect').textContent = item;
            document.getElementById('catDebugOutput').textContent = item;
            document.getElementById('selectCategorized').classList.remove('open');
            renderCategoryOptions();
            showToast('Centro de Costos', `Asignado a: ${item}`, 'info');
        }

        // ==========================================
        // 4. Users Combobox Logic
        // ==========================================
        const usersData = [
            { name: 'Elena Valenzuela', role: 'Administradora General', img: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80', status: 'Disponible' },
            { name: 'Carlos Mendoza', role: 'Jefe de Logística & Flota', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&h=100&q=80', status: 'Ocupado' },
            { name: 'Sofía Arismendi', role: 'Directora Financiera', img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&h=100&q=80', status: 'Disponible' },
            { name: 'Mateo Villanueva', role: 'Líder de Ciberseguridad', img: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&h=100&q=80', status: 'En reunión' }
        ];

        let selectedUser = usersData[0];

        function renderUserOptions(filter = '') {
            const list = document.getElementById('userOptionsList');
            const matched = usersData.filter(u => u.name.toLowerCase().includes(filter.toLowerCase()) || u.role.toLowerCase().includes(filter.toLowerCase()));

            if (matched.length === 0) {
                list.innerHTML = `<div class="opt-empty">Sin colaboradores para «${escHtml(filter)}».</div>`;
                return;
            }

            list.innerHTML = matched.map(u => `
                <div class="user-option-row ${u.name === selectedUser.name ? 'selected' : ''}" onclick="selectUserItem('${u.name}')">
                    <span class="user-opt-avatar-wrap">
                        <img src="${u.img}" class="user-opt-avatar" alt="">
                        <span class="user-presence ${userPresenceClass(u.status)}"></span>
                    </span>
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:700; font-size:0.86rem;">${u.name}</div>
                        <div style="font-size:0.74rem; color:var(--text-dim); font-weight:500;">${u.role}</div>
                    </div>
                    <span class="user-opt-status">${u.status}</span>
                </div>
            `).join('');
        }

        // Disponible = verde, Ocupado = rojo, En reunión = ámbar
        function userPresenceClass(status) {
            if (status === 'Ocupado') return 'is-busy';
            if (status === 'En reunión') return 'is-meeting';
            return '';
        }

        function userBadgeClass(status) {
            if (status === 'Ocupado') return 'status-cancelled';
            if (status === 'En reunión') return 'status-pending';
            return 'status-completed';
        }

        function filterUserOptions(val) {
            renderUserOptions(val);
        }

        function selectUserItem(userName) {
            selectedUser = usersData.find(u => u.name === userName);
            document.getElementById('selectedUserPreview').innerHTML = `
                <img src="${selectedUser.img}" class="trigger-avatar" alt="">
                <span class="trigger-value">${selectedUser.name} (${selectedUser.role.split(' ')[0]})</span>
            `;
            const statusBadge = document.getElementById('userStatusBadge');
            statusBadge.className = `badge-status ${userBadgeClass(selectedUser.status)}`;
            statusBadge.innerHTML = `<span class="status-dot"></span> ${selectedUser.status}`;
            document.getElementById('selectUserCombobox').classList.remove('open');
            renderUserOptions();
            showToast('Asignación', `Responsable asignado: ${selectedUser.name}`, 'success');
        }

        // ==========================================
        // 5. Simulated Async Remote Search
        // ==========================================
        let asyncDebounceTimer = null;
        const mockDb = [
            'Logística Austral S.A.', 'TechGlobal Soluciones Corp', 'Industrias Mineras del Norte',
            'Cisco Systems Latam', 'Dell Technologies México', 'Fortinet Security Latam',
            'Almacenes Generales de Depósito', 'Transportes Blindados Panamericanos'
        ];

        function handleAsyncSearch(val) {
            const spinner = document.getElementById('asyncSpinner');
            const box = document.getElementById('asyncResultsBox');

            if (!val.trim()) {
                box.style.display = 'none';
                spinner.style.display = 'none';
                return;
            }

            spinner.style.display = 'inline-block';
            clearTimeout(asyncDebounceTimer);

            asyncDebounceTimer = setTimeout(() => {
                spinner.style.display = 'none';
                const results = mockDb.filter(item => item.toLowerCase().includes(val.toLowerCase()));

                box.style.display = 'block';
                if (results.length === 0) {
                    box.innerHTML = `<div class="opt-empty">Sin resultados para «${escHtml(val)}».</div>`;
                } else {
                    const latency = 180 + Math.round(Math.random() * 140);
                    box.innerHTML = results.map((r, i) => `
                        <div class="user-option-row" onclick="selectAsyncResult('${r}')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2M10 6h4M10 10h4M10 14h4M10 18h4"/></svg>
                            <span>${r}</span>
                            ${i === 0 ? `<span class="async-latency">${latency} ms</span>` : ''}
                        </div>
                    `).join('');
                }
            }, 300);
        }

        function selectAsyncResult(val) {
            document.getElementById('asyncSearchBox').value = val;
            document.getElementById('asyncSelectedLabel').textContent = val;
            document.getElementById('asyncResultsBox').style.display = 'none';
            showToast('Proveedor Vinculado', `Entidad seleccionada: ${val}`, 'success');
        }

        // ==========================================
        // 6. Segment & Sliders
        // ==========================================
        function setSegment(btn, value) {
            document.querySelectorAll('.segment-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            showToast('Frecuencia', `Período configurado a: ${value}`, 'info');
        }

        function updateRateLimit(val) {
            document.getElementById('sliderValueNum').textContent = `${Number(val).toLocaleString('en-US')} req/s`;
            const range = document.getElementById('rateLimitRange');
            if (range) {
                const pct = ((val - range.min) / (range.max - range.min)) * 100;
                range.style.setProperty('--fill', `${pct}%`);
            }
        }

        function resetAllSelects() {
            selectedDepts.clear();
            selectedDepts.add('Finanzas & Auditoría Fiscal');
            selectedSkills.clear();
            selectedSkills.add('TypeScript');

            renderDeptOptions();
            renderSkillOptions();
            renderCategoryOptions();
            renderUserOptions();

            document.getElementById('asyncSearchBox').value = '';
            document.getElementById('asyncSelectedLabel').textContent = 'Ninguno';
            document.getElementById('asyncResultsBox').style.display = 'none';

            // Reset E-Cont widgets
            renderWidgetEmpresas();
            applyFiscalDatePreset('mes');

            showToast('Restablecido', 'Todos los widgets han vuelto a su estado original.', 'info');
        }

        // ==========================================
        // 7. Widget EmpresaSelector Logic (E-Cont Inspired)
        // ==========================================
        const widgetEmpresasData = [
            { name: 'Consorcio JFast S.A. de C.V.', rfc: 'CNE200915AB4', regimen: 'Régimen 601 General de Ley' },
            { name: 'JFast Logística Norte S.A.P.I.', rfc: 'NLN220412882', regimen: 'Régimen 626 RESICO' },
            { name: 'Distribución Austral Bajío S.A.', rfc: 'DAB210809CC1', regimen: 'Régimen 612 Personas Físicas con Actividades' },
            { name: 'Fideicomiso Inmobiliario Metropolitano', rfc: 'FIM180320KL5', regimen: 'Régimen 606 Arrendamiento' }
        ];

        let activeWidgetEmpresa = widgetEmpresasData[0];
        let activeWidgetSucursal = 'Matriz Central CDMX';

        function renderWidgetEmpresas(filter = '') {
            const container = document.getElementById('widgetEmpresasContainer');
            if (!container) return;
            const term = filter.toLowerCase().trim();
            const matched = widgetEmpresasData.filter(e => 
                e.name.toLowerCase().includes(term) || e.rfc.toLowerCase().includes(term)
            );

            if (matched.length === 0) {
                container.innerHTML = `<div class="opt-empty">Sin coincidencias para «${escHtml(filter)}».</div>`;
                return;
            }

            container.innerHTML = matched.map(e => `
                <button type="button" class="empresa-card-btn ${e.rfc === activeWidgetEmpresa.rfc ? 'active' : ''}"
                    onclick="selectWidgetEmpresa('${e.name}', '${e.rfc}', '${e.regimen}', this)">
                    <span class="empresa-main">
                        <span class="empresa-initials">${e.rfc.slice(0, 3)}</span>
                        <span style="min-width:0;">
                            <span class="empresa-name" style="display:block;">${e.name}</span>
                            <span class="empresa-meta" style="display:block;"><span class="rfc">${e.rfc}</span> · ${e.regimen}</span>
                        </span>
                    </span>
                    ${e.rfc === activeWidgetEmpresa.rfc ? '<span class="badge-status status-completed">Activa</span>' : ''}
                </button>
            `).join('');
        }

        function filterWidgetEmpresas(val) {
            renderWidgetEmpresas(val);
        }

        function selectWidgetEmpresa(name, rfc, regimen, btn) {
            activeWidgetEmpresa = { name, rfc, regimen };
            document.getElementById('widgetActiveEmpresaText').innerHTML = `${escHtml(name)} <span class="rfc-mono">(${escHtml(rfc)})</span>`;
            renderWidgetEmpresas();
            showToast('Empresa Activa', `Razón Social cambiada a: ${name}`, 'success');
        }

        function onWidgetSucursalChange(sucursal) {
            activeWidgetSucursal = sucursal;
            document.getElementById('widgetActiveSucursalBadge').textContent = sucursal;
            showToast('Sucursal', `Contexto de operaciones actualizado a: ${sucursal}`, 'info');
        }

        // ==========================================
        // 8. Widget DateRangePicker Logic (E-Cont Inspired)
        // ==========================================
        function isoDateString(d) {
            return d.toISOString().slice(0, 10);
        }

        function applyFiscalDatePreset(preset, btn) {
            document.querySelectorAll('.date-range-presets .preset-btn').forEach(b => b.classList.remove('active'));
            if (btn) {
                btn.classList.add('active');
            } else {
                const defaultBtn = document.querySelector(`.date-range-presets .preset-btn[onclick*="'${preset}'"]`);
                if (defaultBtn) defaultBtn.classList.add('active');
            }

            const hoy = new Date();
            let inicio = new Date(hoy);
            let fin = new Date(hoy);

            if (preset === 'hoy') {
                // hoy / hoy
            } else if (preset === '7d') {
                inicio.setDate(inicio.getDate() - 6);
            } else if (preset === 'mes') {
                inicio = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            } else if (preset === 'mesAnterior') {
                inicio = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 1);
                fin = new Date(hoy.getFullYear(), hoy.getMonth(), 0);
            } else if (preset === 'anio') {
                inicio = new Date(hoy.getFullYear(), 0, 1);
            }

            const inputDesde = document.getElementById('datePickerDesde');
            const inputHasta = document.getElementById('datePickerHasta');
            if (inputDesde && inputHasta) {
                inputDesde.value = isoDateString(inicio);
                inputHasta.value = isoDateString(fin);
            }

            updateDateRangeDisplay();
            if (btn) showToast('Preset Fiscal', `Período contable establecido (${preset})`, 'info');
        }

        function updateDateRangeDisplay() {
            const d1Val = document.getElementById('datePickerDesde').value;
            const d2Val = document.getElementById('datePickerHasta').value;
            if (!d1Val || !d2Val) return;

            const d1 = new Date(d1Val + 'T00:00:00');
            const d2 = new Date(d2Val + 'T00:00:00');
            const diffTime = Math.abs(d2 - d1);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

            const formatted = `${d1Val.split('-').reverse().join('/')} → ${d2Val.split('-').reverse().join('/')}`;
            document.getElementById('dateRangeFormatted').textContent = formatted;
            document.getElementById('dateRangeDaysCount').textContent = `${diffDays} días`;
        }

        // ==========================================
        // 9. Widget ReportCenter Logic (E-Cont Inspired)
        // ==========================================
        let selectedReportTitle = 'Balanza de Comprobación SAT';

        function selectReportType(title, el) {
            selectedReportTitle = title;
            document.querySelectorAll('.report-type-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            showToast('Reporte Seleccionado', `${title}`, 'info');
        }

        function simulateGenerateReport() {
            const btn = document.getElementById('btnGenerateReport');
            const progContainer = document.getElementById('reportProgressContainer');
            const progBar = document.getElementById('reportProgressBar');
            const progPercent = document.getElementById('reportProgressPercent');
            const formatInput = document.querySelector('input[name="reportFormat"]:checked');
            const format = formatInput ? formatInput.value : 'PDF';

            btn.disabled = true;
            btn.innerHTML = `<span class="btn-spinner"></span> Compilando ${selectedReportTitle}...`;
            progContainer.style.display = 'block';
            progBar.style.width = '0%';
            progPercent.textContent = '0%';

            let progress = 0;
            const interval = setInterval(() => {
                progress += 20;
                progBar.style.width = `${progress}%`;
                progPercent.textContent = `${progress}%`;

                if (progress >= 100) {
                    clearInterval(interval);
                    setTimeout(() => {
                        progContainer.style.display = 'none';
                        btn.disabled = false;
                        btn.innerHTML = `${ICON_DOWNLOAD} Generar y descargar reporte`;
                        showToast('Descarga Lista', `${selectedReportTitle} exportado en ${format}. Descarga simulada iniciada.`, 'success');
                    }, 400);
                }
            }, 120);
        }

        // ==========================================
        // 10. Widget AlertasFeed Logic (E-Cont Inspired)
        // ==========================================
        function filterWidgetFeedAlerts(type, btn) {
            const btns = btn.parentElement.querySelectorAll('button');
            btns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const items = document.querySelectorAll('#widgetAlertsFeed .widget-alert-item');
            items.forEach(item => {
                const itemType = item.getAttribute('data-type');
                if (type === 'todas' || itemType === type) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function updateWidgetAlertBadge() {
            const feed = document.getElementById('widgetAlertsFeed');
            if (!feed) return;
            const count = feed.querySelectorAll('.widget-alert-item').length;
            const badge = document.getElementById('widgetAlertBadgeCount');
            if (badge) badge.textContent = count;
        }

        function simulateIncomingAlert() {
            const feed = document.getElementById('widgetAlertsFeed');
            if (!feed) return;
            const newAlert = document.createElement('div');
            newAlert.className = 'widget-alert-item urgent';
            newAlert.setAttribute('data-type', 'sat');
            newAlert.innerHTML = `
                <div class="widget-readout-row">
                    <span class="badge-status status-danger">SAT · Nueva alerta</span>
                    <span class="alert-time">ahora</span>
                </div>
                <div class="alert-title">Notificación en Buzón Tributario SAT</div>
                <div class="alert-body">Nuevo requerimiento de contabilidad electrónica del ejercicio <span class="nx-mono">2026</span>.</div>
                <div class="alert-actions">
                    <button class="btn-modern btn-primary btn-xs" onclick="showToast('Buzón SAT', 'Accediendo a e.firma SAT...', 'info')">Abrir buzón</button>
                    <button class="btn-modern btn-outline btn-xs" onclick="this.closest('.widget-alert-item').remove(); updateWidgetAlertBadge();">Descartar</button>
                </div>
            `;
            feed.prepend(newAlert);
            updateWidgetAlertBadge();
            showToast('Alerta Entrante', 'Nuevo aviso recibido de Buzón Tributario SAT', 'warning');
        }

        // Control segmentado del modal (retención de IVA)
        function pickModalSeg(btn) {
            btn.parentElement.querySelectorAll('button').forEach(b => b.removeAttribute('data-active'));
            btn.setAttribute('data-active', 'true');
        }

        // Init all components
        updateRateLimit(document.getElementById('rateLimitRange').value);
        renderDeptOptions();
        renderSkillOptions();
        renderCategoryOptions();
        renderUserOptions();
        renderWidgetEmpresas();
        applyFiscalDatePreset('mes');
    </script>
</body>
</html>
