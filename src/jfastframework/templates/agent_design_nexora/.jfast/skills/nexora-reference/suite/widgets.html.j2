    <!-- 2. Alert -->
    <div id="widgetAppleAlert" class="apple-modal-overlay" style="display: none;">
        <div class="apple-modal-card" style="max-width: 420px;">
            <div class="alert-dialog-body">
                <div class="alert-dialog-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/></svg>
                </div>
                <h3 class="apple-modal-title">¿Revocar certificado CSD?</h3>
                <p class="apple-modal-subtitle" style="font-size: 0.85rem; margin-top: 8px;">Esta acción invalida la emisión de CFDI de la sucursal seleccionada hasta que se suba un nuevo par <span class="nx-mono">.cer</span> / <span class="nx-mono">.key</span> válido.</p>
