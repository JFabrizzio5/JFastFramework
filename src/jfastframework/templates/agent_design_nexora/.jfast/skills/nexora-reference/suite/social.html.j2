    <script>
        let attachImageActive = false;
        let postToArchive = null;

        function toggleImageAttach() {
            attachImageActive = !attachImageActive;
            document.getElementById('imageAttachPreview').style.display = attachImageActive ? 'block' : 'none';
        }

        function insertTag(tag) {
            const textarea = document.getElementById('postTextInput');
            textarea.value += ' ' + tag + ' ';
            textarea.focus();
        }

        function publishNewPost() {
            const textarea = document.getElementById('postTextInput');
            const text = textarea.value.trim();

            if (!text && !attachImageActive) {
                showToast('Campo Vacío', 'Escribe un mensaje para publicar con el equipo.', 'warning');
                return;
            }

            const stream = document.getElementById('feedStreamContainer');
            const newPostId = 'post-' + Date.now();

            let mediaHtml = '';
            if (attachImageActive) {
                mediaHtml = `<img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=80" class="post-media-img" alt="Media">`;
            }

            const newPostCard = document.createElement('article');
            newPostCard.className = 'post-card';
            newPostCard.id = newPostId;
            newPostCard.setAttribute('data-category', attachImageActive ? 'media' : 'general');
            newPostCard.innerHTML = `
                <div class="post-header">
                    <div class="post-author-wrap">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" class="post-author-img" alt="Elena">
                        <div>
                            <div class="post-author-name">
                                Elena Valenzuela
                                <span class="badge-status status-completed" style="padding: 2px 7px; font-size: 0.65rem;">Directora General</span>
                            </div>
                            <div class="post-time">Hace unos segundos • Público corporativo</div>
                        </div>
                    </div>
                    <button class="btn-modern btn-ghost post-more-btn" onclick="confirmArchivePost('${newPostId}')" aria-label="Archivar publicación">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                </div>
                <div class="post-body-text">${text}</div>
                ${mediaHtml}
                <div class="post-stats-row">
                    <span id="like-count-${newPostId}" class="like-count">1 reacción</span>
                    <span>0 comentarios • 0 compartidos</span>
                </div>
                <div class="post-actions-bar">
                    <button class="post-action-btn liked" onclick="toggleLike(this, 'like-count-${newPostId}', 1)">
                        <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        <span>Me gusta</span>
                    </button>
                    <button class="post-action-btn" onclick="openApplePostComments('Elena Valenzuela', '${text.replace(/'/g, "\\'")}', '${newPostId}')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <span>Comentar</span>
                    </button>
                    <button class="post-action-btn" onclick="openAppleModal('modalAppleShareSheet')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
                        <span>Compartir</span>
                    </button>
                </div>
            `;

            stream.prepend(newPostCard);
            textarea.value = '';
            if (attachImageActive) toggleImageAttach();

            showToast('Publicado', 'Tu publicación ya está disponible en el feed de la organización.', 'success');
        }

        function toggleLike(btn, countId, baseCount) {
            const isLiked = btn.classList.toggle('liked');
            const countLabel = document.getElementById(countId);
            const count = isLiked ? baseCount + 1 : baseCount;
            countLabel.textContent = `${count} ${count === 1 ? 'reacción' : 'reacciones'}`;
        }

        function confirmArchivePost(postId) {
            postToArchive = postId;
            openAppleModal('modalAppleConfirmArchive');
        }

        function executeArchivePost() {
            if (postToArchive) {
                const el = document.getElementById(postToArchive);
                if (el) {
                    el.style.transition = 'all 0.35s ease';
                    el.style.opacity = '0';
                    el.style.transform = 'scale(0.95)';
                    setTimeout(() => el.remove(), 350);
                }
            }
            closeAppleModal('modalAppleConfirmArchive');
            showToast('Archivada', 'La publicación ha sido archivada.', 'info');
        }

        /* Hilo de comentarios */
        let activeCommentPostId = null;
        function openApplePostComments(author, snippet, postId) {
            activeCommentPostId = postId;
            const previewEl = document.getElementById('commentModalPostPreview');
            if (previewEl) {
                previewEl.textContent = `Publicación de ${author}: "${snippet.length > 60 ? snippet.substring(0, 60) + '...' : snippet}"`;
            }
            openAppleModal('modalAppleComments');
            setTimeout(() => {
                const inp = document.getElementById('modalCommentInput');
                if (inp) inp.focus();
            }, 200);
        }

        function submitModalComment() {
            const input = document.getElementById('modalCommentInput');
            const text = input.value.trim();
            if (!text) return;

            const thread = document.getElementById('modalCommentsThread');
            const commentDiv = document.createElement('div');
            commentDiv.className = 'comment-item';
            commentDiv.innerHTML = `
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" class="comment-avatar" alt="Elena">
                <div class="comment-bubble">
                    <div class="comment-author">Elena Valenzuela <span style="font-weight:400; font-size:0.72rem; color:var(--text-muted);">• Ahora mismo</span></div>
                    <div>${text}</div>
                </div>
            `;
            thread.appendChild(commentDiv);
            input.value = '';
            thread.scrollTop = thread.scrollHeight;
            showToast('Comentario Enviado', 'Tu aportación ha sido registrada en el hilo.', 'success');
        }

        function toggleFollow(btn) {
            if (btn.textContent.includes('Conectar')) {
                btn.textContent = '✓ Conectado';
                btn.classList.remove('btn-outline');
                btn.classList.add('btn-primary');
                showToast('Conexión', 'Solicitud de conexión aprobada.', 'success');
            } else {
                btn.textContent = '+ Conectar';
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline');
            }
        }

        /* Interactive Poll */
        let pollVoted = false;
        let pollVotes = [84, 50, 27];
        function castPollVote(index) {
            if (pollVoted) {
                showToast('Encuesta', 'Ya has emitido tu voto para esta encuesta.', 'info');
                return;
            }
            pollVoted = true;
            pollVotes[index]++;
            const total = pollVotes.reduce((a, b) => a + b, 0);

            for (let i = 0; i < 3; i++) {
                const pct = Math.round((pollVotes[i] / total) * 100);
                document.getElementById(`pollBar${i}`).style.width = pct + '%';
                document.getElementById(`pollPct${i}`).textContent = `${pct}% (${pollVotes[i]} votos)`;
            }
            document.getElementById('pollTotalVotes').textContent = `Total: ${total} votos emitidos (¡Tu voto fue registrado!)`;
            showToast('Voto Registrado', '¡Gracias por participar en las decisiones corporativas!', 'success');
        }

        /* Feed Category Filter */
        function filterFeedCategory(category, btn) {
            document.querySelectorAll('.feed-filter-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');

            const posts = document.querySelectorAll('.feed-stream .post-card');
            posts.forEach(post => {
                if (category === 'all') {
                    post.style.display = 'block';
                } else {
                    const postCat = post.getAttribute('data-category') || '';
                    if (postCat.includes(category)) {
                        post.style.display = 'block';
                    } else {
                        post.style.display = 'none';
                    }
                }
            });
            showToast('Filtro de Feed', `Mostrando: ${btn.textContent.trim()}`, 'info');
        }

        /* Visor de historias con temporizador */
        let storyInterval = null;
        let storyProgress = 0;

        function openStoryModal(author, imgUrl) {
            const authorEl = document.getElementById('storyModalAuthorApple');
            const imgEl = document.getElementById('storyModalImgApple');
            const avatarEl = document.getElementById('storyModalAvatarApple');
            
            if (authorEl) authorEl.textContent = author;
            if (imgEl) imgEl.src = imgUrl;
            if (avatarEl) avatarEl.src = imgUrl;
            
            openAppleModal('modalAppleStory');

            clearInterval(storyInterval);
            storyProgress = 0;
            const bar = document.getElementById('storyProgressFillApple');
            if (bar) bar.style.width = '0%';

            storyInterval = setInterval(() => {
                storyProgress += 2;
                if (bar) bar.style.width = storyProgress + '%';
                if (storyProgress >= 100) {
                    clearInterval(storyInterval);
                    closeStoryModal();
                }
            }, 100);
        }

        function closeStoryModal() {
            clearInterval(storyInterval);
            closeAppleModal('modalAppleStory');
        }

        function sendStoryReaction(emoji) {
            showToast('Reacción Enviada', `Has reaccionado con ${emoji} a la historia`, 'success');
            setTimeout(closeStoryModal, 600);
        }

        function handleStoryReply(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const text = e.target.value.trim();
                if (!text) return;
                e.target.value = '';
                showToast('Mensaje Directo', 'Respuesta enviada a la bandeja privada.', 'success');
                setTimeout(closeStoryModal, 600);
            }
        }

        function filterFeedByTag(tag) {
            showToast('Filtro Social', `Mostrando publicaciones etiquetadas con ${tag}`, 'info');
        }
    </script>
</body>
</html>
