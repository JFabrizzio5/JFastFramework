.nx-color-row small { display: block; font-size: 0.66rem; color: var(--text-dim); }

.nx-color-row .nx-hex { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-dim); margin-right: 8px; }

.color-swatch-input {
    -webkit-appearance: none;
    appearance: none;
    width: 38px;
    height: 26px;
    padding: 0;
