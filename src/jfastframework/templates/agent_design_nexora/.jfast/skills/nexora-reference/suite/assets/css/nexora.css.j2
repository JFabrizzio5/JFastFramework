.nx-slider-row { font-family: var(--font-mono); font-size: 0.7rem; }
.nx-slider-row > div { display: flex; justify-content: space-between; margin-bottom: 6px; color: var(--text-dim); }
.nx-slider-row b { color: var(--text-main); }
.nx-slider-row input { width: 100%; }

.nx-seg {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: var(--pill-bg);
    border: 1px solid var(--badge-border);
}

.nx-seg button {
    padding: 7px 6px;
    border-radius: 9px;
    border: none;
    background: transparent;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-dim);
    cursor: pointer;
    transition: var(--transition-fast);
}

.nx-seg button:hover { color: var(--text-main); }

.nx-seg button[data-active="true"] {
    background: rgb(var(--c-accent));
    color: rgb(var(--c-on-accent));
    box-shadow: 0 4px 12px -2px rgb(var(--c-accent) / 0.5);
}

.color-swatches-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }

.color-swatch-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.color-swatch-btn:hover { transform: scale(1.12); }
.color-swatch-btn.active { box-shadow: 0 0 0 2px var(--bg-primary), 0 0 0 4px rgb(var(--c-accent)); }

.floating-customize-btn {
    position: fixed;
    bottom: 22px;
    left: 22px;
    z-index: 2000;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 9999px;
    background: var(--nav-bg);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    color: var(--text-main);
    border: 1px solid var(--nav-border);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.45), inset 0 1px 1px var(--card-specular);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.floating-customize-btn svg { color: rgb(var(--c-accent)); }
.floating-customize-btn:hover { transform: translateY(-2px); border-color: var(--card-hover-border); }

/* ==========================================================================
   Esferas de vidrio (decorativas, dependen de la paleta)
   ========================================================================== */
.liquid-orb-accent {
    border-radius: 50%;
    background: radial-gradient(circle at 32% 25%, color-mix(in srgb, rgb(var(--c-glow)) 60%, white) 0%, rgb(var(--c-accent)) 40%, rgb(var(--c-accent-deep)) 80%, #050505 100%);
    box-shadow: inset -10px -10px 24px rgba(0, 0, 0, 0.85), inset 10px 10px 20px rgba(255, 255, 255, 0.55), 0 20px 45px -8px rgb(var(--c-accent) / 0.5);
}

.liquid-orb-glow {
    border-radius: 50%;
    background: radial-gradient(circle at 35% 25%, #fff 0%, rgb(var(--c-glow)) 38%, rgb(var(--c-body)) 82%, #050505 100%);
    box-shadow: inset -10px -10px 24px rgba(0, 0, 0, 0.85), inset 8px 8px 18px rgba(255, 255, 255, 0.5), 0 20px 40px -8px rgb(var(--c-glow) / 0.4);
}

.liquid-orb-deep {
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgb(var(--c-glow)) 0%, rgb(var(--c-body)) 45%, rgb(var(--c-accent-deep)) 85%, #020202 100%);
    box-shadow: inset -6px -6px 18px rgba(0, 0, 0, 0.8), inset 6px 6px 16px rgba(255, 255, 255, 0.5), 0 16px 36px -6px rgb(var(--c-accent) / 0.35);
}

@keyframes floatGentle1 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-7px) rotate(0.5deg); }
}

@keyframes floatGentle2 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(7px) rotate(-0.5deg); }
}

.animate-float-1 { animation: floatGentle1 6.5s ease-in-out infinite; }
.animate-float-2 { animation: floatGentle2 7.5s ease-in-out 1.2s infinite; }

/* ==========================================================================
   Tarjetas 3D con auto que sale del póster
   Técnica: el póster se inclina hacia atrás (rotateX) mientras una copia
   del recorte, que NO se inclina, crece y se adelanta por encima del borde
   inferior. Así el auto queda "fuera" del marco, como en el video.
   ========================================================================== */
.reveal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 56px 28px;
    padding: 40px 12px 70px;
}

.reveal-card {
    --tilt: 0deg;
    position: relative;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 5 / 7;
    margin-inline: auto;
    cursor: pointer;
    outline: none;
    perspective: 900px;
    -webkit-tap-highlight-color: transparent;
}

/* Póster: fondo + auto integrado + textos. Es lo que se inclina. */
.reveal-card-poster {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #08090d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 60px -22px rgba(0, 0, 0, 0.85), inset 0 1px 1.5px rgba(255, 255, 255, 0.16);
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s ease, border-color 0.6s ease;
    will-change: transform;
}

.reveal-card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) contrast(1.08) saturate(1.05);
    transition: transform 0.8s var(--ease-out), filter 0.6s ease;
}

/* Auto dentro del póster (recortado por el borde) */
.reveal-card-car {
    position: absolute;
    left: 0;
    top: 30%;
    width: 100%;
    filter: drop-shadow(0 14px 12px rgba(0, 0, 0, 0.7));
    transition: opacity 0.35s ease;
}

/* Degradado de lectura: se oscurece en hover (como article::before del video) */
.reveal-card-poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15) 0%, transparent 28%, transparent 52%, rgba(3, 3, 5, 0.75) 82%, rgba(3, 3, 5, 0.95) 100%);
    transition: opacity 0.5s ease;
    z-index: 2;
}

.reveal-card-poster::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background-image: linear-gradient(to bottom, transparent 10%, rgba(0, 0, 0, 0.5) 50%, rgb(0, 0, 0) 95%);
    opacity: 0;
    transition: opacity 0.5s ease;
}

.reveal-card-meta {
    position: absolute;
    z-index: 5;
    left: 14px;
    top: 14px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 5px 11px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: all 0.4s ease;
}

.reveal-card-info {
    position: absolute;
    z-index: 5;
    left: 18px;
    right: 18px;
    bottom: 18px;
    transition: opacity 0.35s ease, transform 0.5s var(--ease-out);
}

.reveal-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.15;
}

.reveal-card-sub {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 3px;
}

/* Auto que sale: misma caja que .reveal-card-car, pero fuera del póster */
.reveal-card-popout {
    position: absolute;
    z-index: 10;
    left: 0;
    top: 30%;
    width: 100%;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 81%;
    transform: translateZ(0);
    filter: drop-shadow(0 14px 12px rgba(0, 0, 0, 0.7));
    transition: transform 0.6s var(--ease-out), opacity 0.3s ease, filter 0.6s ease;
    will-change: transform;
}

/* Nombre del modelo que aparece abajo, delante del póster (img:last-child del video) */
.reveal-card-caption {
    position: absolute;
    z-index: 11;
    left: 0;
    right: 0;
    bottom: -4px;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(25%);
    transition: opacity 0.35s ease, transform 0.5s var(--ease-out);
}

.reveal-card-caption strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.9);
}

.reveal-card-caption span {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--c-glow));
}

/* --- Hover / foco / toque --- */
.reveal-card:hover .reveal-card-poster,
.reveal-card:focus-visible .reveal-card-poster,
.reveal-card.is-active .reveal-card-poster {
    transform: perspective(900px) rotateX(16deg) translateY(-3%) scale(0.97);
    border-color: rgb(var(--c-accent) / 0.45);
    box-shadow: 0 60px 60px -40px rgb(var(--c-accent) / 0.55), 0 30px 50px -20px rgba(0, 0, 0, 0.9), inset 0 1px 2px rgba(255, 255, 255, 0.3);
}

.reveal-card:hover .reveal-card-poster::before,
.reveal-card:focus-visible .reveal-card-poster::before,
.reveal-card.is-active .reveal-card-poster::before { opacity: 1; }

.reveal-card:hover .reveal-card-bg,
.reveal-card:focus-visible .reveal-card-bg,
.reveal-card.is-active .reveal-card-bg {
    transform: scale(1.06);
    filter: brightness(0.75) contrast(1.1) saturate(1.1);
}

.reveal-card:hover .reveal-card-car,
.reveal-card:focus-visible .reveal-card-car,
.reveal-card.is-active .reveal-card-car { opacity: 0; }

.reveal-card:hover .reveal-card-info,
.reveal-card:focus-visible .reveal-card-info,
.reveal-card.is-active .reveal-card-info { opacity: 0; transform: translateY(12px); }

.reveal-card:hover .reveal-card-meta,
.reveal-card:focus-visible .reveal-card-meta,
.reveal-card.is-active .reveal-card-meta {
    border-color: rgb(var(--c-accent) / 0.7);
    box-shadow: 0 0 14px rgb(var(--c-accent) / 0.5);
}

.reveal-card:hover .reveal-card-popout,
.reveal-card:focus-visible .reveal-card-popout,
.reveal-card.is-active .reveal-card-popout {
    opacity: 1;
    transform: translate3d(0, 8%, 60px) scale(1.2);
    filter: drop-shadow(0 26px 18px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 28px rgb(var(--c-glow) / 0.35));
}

.reveal-card:hover .reveal-card-caption,
.reveal-card:focus-visible .reveal-card-caption,
.reveal-card.is-active .reveal-card-caption {
    opacity: 1;
    transform: translateY(10%);
}

.reveal-card:focus-visible .reveal-card-poster { outline: 2px solid rgb(var(--c-accent)); outline-offset: 4px; }

@media (max-width: 1100px) {
    .reveal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 680px; margin-inline: auto; }
}

@media (max-width: 560px) {
    .reveal-grid { grid-template-columns: minmax(0, 1fr); max-width: 300px; gap: 64px; }
}

/* ==========================================================================
   Responsive
   ========================================================================== */
@media (max-width: 1180px) {
    .nav-pill-link span { display: none; }
    .nav-pill-link { padding: 9px 11px; }
}

@media (max-width: 860px) {
    .nexora-navbar { padding: 0 8px 0 18px; }
    .nx-nav-toggle { display: inline-flex; }
    .nav-links-menu { display: none; }
    .nav-links-menu.mobile-open {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        right: 0;
        padding: 10px;
        border-radius: 22px;
        background: var(--nav-bg);
        backdrop-filter: blur(24px) saturate(190%);
        -webkit-backdrop-filter: blur(24px) saturate(190%);
        border: 1px solid var(--nav-border);
        box-shadow: var(--shadow-lg);
    }
    .nav-links-menu.mobile-open .nav-pill-link span { display: inline; }
    .nav-links-menu.mobile-open .nav-pill-link { padding: 11px 14px; }
    .navbar-actions .nx-hide-sm { display: none !important; }
    .toast-container { left: 16px; right: 16px; bottom: 16px; align-items: stretch; }
    .toast { min-width: 0; max-width: none; }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
