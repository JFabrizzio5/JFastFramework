    min-width: 680px;
}

.erp-table th, .erp-data-table th, table.apple-table th {
    background: var(--bg-muted);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 14px 18px;
    border-bottom: 1px solid var(--card-border);
    white-space: nowrap;
}

.erp-table td, .erp-data-table td, table.apple-table td {
    padding: 15px 18px;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-dark);
    vertical-align: middle;
    transition: background-color 0.15s ease;
}

.erp-table tbody tr:last-child td,
.erp-data-table tbody tr:last-child td,
table.apple-table tbody tr:last-child td { border-bottom: none; }

.erp-table tbody tr:hover td,
.erp-data-table tbody tr:hover td,
table.apple-table tbody tr:hover td { background: rgb(var(--c-accent) / 0.05); }

.company-cell { display: flex; align-items: center; gap: 12px; }

.company-avatar-badge {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: radial-gradient(circle at 30% 25%, rgb(var(--c-glow)), rgb(var(--c-accent)) 50%, rgb(var(--c-accent-deep)));
    color: rgb(var(--c-on-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
