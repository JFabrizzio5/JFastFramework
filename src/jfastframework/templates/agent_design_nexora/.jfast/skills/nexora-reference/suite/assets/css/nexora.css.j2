}

/* ==========================================================================
   Panel de paleta (sustituye al cajón de personalización)
   ========================================================================== */
.customization-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: transparent;
    opacity: 0;
    visibility: hidden;
}

.customization-drawer-overlay.active { opacity: 1; visibility: visible; }

.customization-drawer {
    position: fixed;
    z-index: 3001;
    top: 90px;
    right: 20px;
    width: 340px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    padding: 18px;
