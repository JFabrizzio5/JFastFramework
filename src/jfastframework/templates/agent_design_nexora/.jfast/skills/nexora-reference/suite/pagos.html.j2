    </header>

    <div class="container">
        <!-- Encabezado -->
        <div class="page-header-row pay-head">
            <div class="page-title">
                <span class="nx-eyebrow"><span class="nx-live-dot"></span>Checkout seguro · PCI-DSS Nivel 1</span>
                <h1>Pasarela de pagos <span class="hero-title-faded">&amp; checkout B2B</span></h1>
                <p>Procesamiento bancario cifrado de punta a punta, con factura CFDI generada al instante.</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="btn-modern btn-outline" onclick="fillTestCard()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;color:rgb(var(--c-accent));"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    Autocompletar tarjeta demo
                </button>
            </div>
        </div>

        <div class="checkout-layout">
            <!-- Columna izquierda: formulario de pago -->
            <div class="liquid-panel checkout-form-panel">
                <div class="step-head">
                    <span class="step-num">01</span>
                    <div>
                        <h2>Método de pago</h2>
                        <p>Elige cómo quieres liquidar este pedido.</p>
                    </div>
                </div>

                <div class="payment-methods-selector" role="group" aria-label="Método de pago">
                    <button type="button" class="pay-tab-btn active" onclick="selectPayMethod('card', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-md" style="stroke-width:2;"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                        <span>Tarjeta</span>
                    </button>
                    <button type="button" class="pay-tab-btn" onclick="selectPayMethod('spei', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-md" style="stroke-width:2;"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/></svg>
                        <span>SPEI / Wire</span>
                    </button>
                    <button type="button" class="pay-tab-btn" onclick="selectPayMethod('paypal', this)">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="icon-md">
                            <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944 3.72a.78.78 0 0 1 .77-.656h6.495c3.217 0 5.405 1.583 5.035 4.966-.356 3.256-2.457 5.09-5.59 5.09H8.76a.78.78 0 0 0-.77.656l-.914 5.557zm4.512-14.887H6.945l-1.92 12.188h2.382l.707-4.478a1.56 1.56 0 0 1 1.54-1.312h1.61c2.518 0 4.2-1.468 4.48-3.978.278-2.493-1.306-3.42-4.156-3.42z"/>
                        </svg>
                        <span>PayPal</span>
                    </button>
                    <button type="button" class="pay-tab-btn" onclick="selectPayMethod('crypto', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-md" style="stroke-width:2;"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 6v2m0 8v2"/></svg>
                        <span>Cripto / USDC</span>
                    </button>
                </div>

                <form id="paymentForm" onsubmit="processPayment(event)">
                    <!-- Tarjeta -->
                    <div id="method-card-panel">
                        <div class="form-group">
                            <label class="form-label" for="cardHolderInput">
                                <span>Nombre en la tarjeta</span>
                                <span class="form-hint">Tal como aparece en el plástico</span>
                            </label>
                            <input type="text" id="cardHolderInput" class="form-input" placeholder="Elena Valenzuela" autocomplete="cc-name" required oninput="syncCardHolder(this.value)">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="cardNumberInput">
                                <span>Número de tarjeta</span>
                                <span id="cardTypeDetect" class="card-detect">VISA / MASTERCARD</span>
                            </label>
                            <div class="input-with-icon">
                                <input type="text" id="cardNumberInput" class="form-input nx-mono" placeholder="4532 •••• •••• 8921" maxlength="19" inputmode="numeric" autocomplete="cc-number" required oninput="handleCardNumberInput(this)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-md" style="stroke-width:2;"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                            </div>
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label class="form-label" for="cardExpiryInput">
                                    <span>Expiración</span>
                                    <span class="form-hint">MM/AA</span>
                                </label>
                                <input type="text" id="cardExpiryInput" class="form-input nx-mono" placeholder="12/28" maxlength="5" inputmode="numeric" autocomplete="cc-exp" required oninput="handleExpiryInput(this)">
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="cardCvcInput">
                                    <span>CVC</span>
                                    <span class="form-hint">3 o 4 dígitos</span>
                                </label>
                                <input type="password" id="cardCvcInput" class="form-input nx-mono" placeholder="•••" maxlength="4" inputmode="numeric" autocomplete="cc-csc" required oninput="syncCvc(this.value)">
                            </div>
                        </div>
                    </div>

                    <!-- SPEI -->
                    <div id="method-spei-panel" class="pay-inset" style="display: none;">
                        <span class="nx-eyebrow">SPEI · Acreditación en segundos</span>
                        <h4>Transferencia bancaria inmediata</h4>
                        <p>Transfiere desde cualquier app bancaria a esta cuenta CLABE autorizada.</p>
                        <div class="spei-sheet">
                            <div class="spei-row spei-clabe">
                                <span class="spei-k">CLABE</span>
                                <span class="spei-clabe-wrap">
                                    <span class="spei-v">012180001928374652</span>
                                    <button type="button" class="btn-modern btn-outline btn-xs" onclick="navigator.clipboard.writeText('012180001928374652'); showToast('Copiado', 'CLABE copiada al portapapeles.', 'success');">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:13px;height:13px;stroke-width:2.2;"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                                        Copiar
                                    </button>
                                </span>
                            </div>
                            <div class="spei-row">
                                <span class="spei-k">Banco receptor</span>
                                <span class="spei-v">BBVA México / JFast Pay STP</span>
                            </div>
                            <div class="spei-row">
                                <span class="spei-k">Beneficiario</span>
                                <span class="spei-v">JFast Technologies S.A. de C.V.</span>
                            </div>
                            <div class="spei-row">
                                <span class="spei-k">Referencia</span>
                                <span class="spei-v nx-mono">NX-2026-9481</span>
                            </div>
                        </div>
                    </div>

                    <div class="step-divider"></div>

                    <div class="step-head">
                        <span class="step-num">02</span>
                        <div>
                            <h2>Facturación</h2>
