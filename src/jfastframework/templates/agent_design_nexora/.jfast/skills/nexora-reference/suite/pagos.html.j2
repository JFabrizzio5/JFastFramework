                        </div>
                    </div>

                    <!-- Factura CFDI -->
                    <div class="pay-inset">
                        <div class="cfdi-row">
                            <div>
                                <strong>¿Requieres factura fiscal (CFDI)?</strong>
                                <p>Generamos automáticamente el XML y el PDF oficiales.</p>
                            </div>
                            <label class="toggle-switch" aria-label="Requiero factura CFDI">
                                <input type="checkbox" id="cfdiToggle" onchange="toggleCfdiFields(this.checked)">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div id="cfdiFields" style="display: none;">
                            <div class="cfdi-grid" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;">
                                <div class="form-group">
                                    <label class="form-label" for="cfdiRfcInput">RFC / Tax ID</label>
                                    <input type="text" id="cfdiRfcInput" class="form-input nx-mono" placeholder="LOUA850423H82" style="text-transform: uppercase;">
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="cfdiRazonInput">Razón social</label>
                                    <input type="text" id="cfdiRazonInput" class="form-input" placeholder="Logística Austral S.A. de C.V.">
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="btnSubmitPayment" class="btn-modern btn-primary btn-pay">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm pay-lock" style="stroke-width:2.2;"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span id="btnPayText">Pagar $4,850.00 USD</span>
                        <span id="btnPaySpinner" class="btn-spinner" style="display: none;"></span>
                    </button>
                </form>

                <div class="security-badges">
                    <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:13px;height:13px;color:var(--success);stroke-width:2.2;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Cifrado AES-256
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:13px;height:13px;color:rgb(var(--c-accent));stroke-width:2.2;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                        3D Secure 2.0
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:13px;height:13px;color:var(--info);stroke-width:2.2;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        Liquidación inmediata
                    </span>
                </div>
            </div>

            <!-- Columna derecha: tarjeta 3D y resumen -->
            <div class="checkout-aside">
                <div class="cc-stage">
                    <div class="cc-scene" id="ccScene" data-tilt>
                        <div class="cc-visual-card" id="visualCreditCard" role="button" tabindex="0" aria-label="Vista previa de la tarjeta. Pulsa para voltearla.">
                            <!-- Frente -->
                            <div class="cc-face cc-front">
                                <div class="cc-top-row">
                                    <span class="cc-issuer">JFast <small>Corporate</small></span>
                                    <span class="cc-brand-badge" id="cardBrandText">CorpCard</span>
                                </div>

                                <div class="cc-chip-row">
                                    <div class="cc-chip"></div>
                                    <svg class="cc-contactless" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2;"><path d="M8.5 7.5a6 6 0 0 1 0 9M12 5a9.5 9.5 0 0 1 0 14M15.5 2.5a13 13 0 0 1 0 19M5 10a2.5 2.5 0 0 1 0 4"/></svg>
                                </div>

                                <div class="cc-field" id="ccFieldNumber">
                                    <div class="cc-number-display" id="ccDisplayNumber">•••• •••• •••• ••••</div>
                                </div>

                                <div class="cc-footer-row">
                                    <div class="cc-field" id="ccFieldHolder">
                                        <div class="cc-label">Titular</div>
                                        <div class="cc-holder-display" id="ccDisplayHolder">ELENA VALENZUELA</div>
                                    </div>
                                    <div class="cc-field" id="ccFieldExpiry">
                                        <div class="cc-label">Válida hasta</div>
                                        <div class="cc-holder-display nx-mono" id="ccDisplayExpiry">12/28</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Reverso -->
                            <div class="cc-face cc-back" aria-hidden="true">
                                <div class="cc-stripe"></div>
                                <span class="cc-cvv-label">CVV</span>
                                <div class="cc-sign-row">
                                    <div class="cc-sign"></div>
                                    <div class="cc-cvv-box"><span id="ccDisplayCvc">•••</span></div>
                                </div>
                                <div class="cc-back-foot">
                                    <p class="cc-legal">JFast Pay · Uso exclusivo corporativo.<br>Soporte 24/7 · +52 55 0000 0000</p>
                                    <div class="cc-holo"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="cc-hint">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:12px;height:12px;stroke-width:2.2;"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
                        El CVC voltea la tarjeta · clic para girarla
                    </div>
                </div>

                <!-- Resumen del pedido -->
                <div class="liquid-panel order-panel">
                    <div class="order-head">
                        <h3>Resumen del pedido</h3>
                        <span class="badge-status status-processing" id="cartItemCountBadge">3 Artículos</span>
                    </div>

                    <div id="orderItemsListContainer">
                        <!-- Se renderiza con JS -->
                    </div>

                    <div class="coupon-box">
                        <input type="text" id="couponCodeInput" class="form-input nx-mono" placeholder="Cupón · prueba JFAST20" aria-label="Código de cupón (prueba JFAST20 o BIENVENIDO10)">
                        <button type="button" class="btn-modern btn-outline" onclick="applyPromoCode()">Aplicar</button>
                    </div>
                    <div id="couponFeedback"></div>

                    <div class="totals-list">
                        <div class="totals-row">
                            <span>Subtotal</span>
                            <span id="subtotalVal">$4,850.00</span>
                        </div>
                        <div class="totals-row is-discount" id="discountRow" style="display: none;">
                            <span>Descuento promocional</span>
                            <span id="discountVal">-$0.00</span>
                        </div>
                        <div class="totals-row">
                            <span>IVA (16 %)</span>
                            <span id="taxVal">$776.00</span>
                        </div>
                        <div class="totals-row totals-total">
                            <span>Total a liquidar</span>
                            <span class="total-amount"><span id="totalFinalVal">$5,626.00</span><small>USD</small></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="modalPaymentSuccess" class="modal-overlay" style="display: none;">
        <div class="modal-card pay-success-card" role="dialog" aria-modal="true" aria-labelledby="paySuccessTitle">
            <div class="modal-header">
                <div>
                    <span class="nx-eyebrow" style="color: var(--success);">Pago aprobado</span>
                    <h3 id="paySuccessTitle">Transacción exitosa</h3>
                </div>
                <button class="modal-close-btn" onclick="closeModal('modalPaymentSuccess')" aria-label="Cerrar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2.2;"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="success-hero">
                    <div class="success-orb">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:30px;height:30px;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;"><path d="M20 6 9 17l-5-5"/></svg>
                    </div>
                    <div id="modalConfirmedAmount">$5,626.00 USD</div>
                    <p>El cobro fue aprobado y liquidado correctamente.</p>
                </div>

                <div class="receipt">
                    <div class="receipt-row">
                        <span>Folio de autorización</span>
                        <strong class="nx-mono" id="authCodeDisplay">AUTH-9482910</strong>
                    </div>
                    <div class="receipt-row">
                        <span>Fecha y hora</span>
                        <span class="nx-mono" id="authDateDisplay">28 Sep 2026, 17:45 hrs</span>
                    </div>
                    <div class="receipt-row">
                        <span>Método</span>
                        <span class="nx-mono" id="authMethodDisplay">Tarjeta terminación 8921</span>
                    </div>
                    <div class="receipt-row">
                        <span>Estado fiscal</span>
                        <span class="badge-status status-completed"><span class="status-dot"></span>CFDI 4.0 generado</span>
                    </div>
                </div>

                <p class="success-note">
                    Enviamos el recibo de compra y los archivos fiscales a tu correo corporativo.
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn-modern btn-outline" onclick="downloadReceipt()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
                    Descargar comprobante PDF
                </button>
                <button class="btn-modern btn-primary" onclick="closeModal('modalPaymentSuccess'); window.location.href='tablas.html'">
                    Ver en Tablas ERP
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2.2;"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Scripts -->
    <script src="assets/js/nexora-common.js"></script>
    <script>
        // Dynamic Cart State
        let cartItems = [
            { id: 1, name: 'Servidor Rack 2U Dell PowerEdge R740', desc: 'Xeon Silver 4210R, 64GB ECC RAM, 2x 960GB NVMe', price: 3850.00, qty: 1 },
            { id: 2, name: 'Módulo Switch Cisco Catalyst 9200', desc: '24 Puertos Gigabit PoE+ Capa 3', price: 750.00, qty: 1 },
            { id: 3, name: 'Licencia JFast ERP Enterprise (Anual)', desc: 'Usuarios ilimitados y soporte crítico 24/7', price: 250.00, qty: 1 }
        ];

        let subtotal = 4850.00;
        let discount = 0.00;
        let taxRate = 0.16;

        function renderCart() {
            const container = document.getElementById('orderItemsListContainer');
            const totalQty = cartItems.reduce((acc, item) => acc + item.qty, 0);
            document.getElementById('cartItemCountBadge').textContent = `${totalQty} Artículo(s)`;

            if (cartItems.length === 0) {
                container.innerHTML = `
                    <div class="order-empty">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:26px;height:26px;stroke-width:1.8;"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        El carrito está vacío. Agrega productos para cotizar.
                    </div>
                `;
                subtotal = 0;
                discount = 0;
                updateTotals();
                return;
            }

            container.innerHTML = cartItems.map((item, idx) => `
                <div class="order-item-row">
                    <span class="order-item-idx">${String(idx + 1).padStart(2, '0')}</span>
                    <div class="order-item-info">
                        <div class="order-item-title">${item.name}</div>
                        <div class="order-item-desc">${item.desc}</div>
                        <div class="order-item-actions">
                            <div class="qty-stepper">
                                <button type="button" class="qty-btn" aria-label="Quitar uno" onclick="changeCartQty(${idx}, -1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:12px;height:12px;stroke-width:2.5;"><path d="M5 12h14"/></svg></button>
                                <span class="qty-val">${item.qty}</span>
                                <button type="button" class="qty-btn" aria-label="Agregar uno" onclick="changeCartQty(${idx}, 1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:12px;height:12px;stroke-width:2.5;"><path d="M12 5v14M5 12h14"/></svg></button>
                            </div>
                            <button type="button" class="order-remove" onclick="removeCartItem(${idx})"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:12px;height:12px;stroke-width:2.2;"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Eliminar</button>
                        </div>
                    </div>
                    <div class="order-item-price">$${(item.price * item.qty).toLocaleString('en-US', {minimumFractionDigits: 2})}</div>
                </div>
            `).join('');

            subtotal = cartItems.reduce((acc, item) => acc + (item.price * item.qty), 0);
            updateTotals();
        }

        function changeCartQty(idx, delta) {
            cartItems[idx].qty += delta;
            if (cartItems[idx].qty <= 0) {
                cartItems.splice(idx, 1);
            }
            renderCart();
        }

        function removeCartItem(idx) {
            const removed = cartItems.splice(idx, 1);
            renderCart();
            showToast('Carrito', `${removed[0].name} retirado del pedido.`, 'info');
        }

        function updateTotals() {
            const tax = (subtotal - discount) * taxRate;
            const total = Math.max(0, (subtotal - discount) + tax);

            document.getElementById('subtotalVal').textContent = `$${subtotal.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('discountVal').textContent = `-$${discount.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('taxVal').textContent = `$${tax.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('totalFinalVal').textContent = `$${total.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('btnPayText').textContent = `Pagar $${total.toLocaleString('en-US', {minimumFractionDigits: 2})} USD`;
            document.getElementById('modalConfirmedAmount').textContent = `$${total.toLocaleString('en-US', {minimumFractionDigits: 2})} USD`;
        }

        // Card sync
        function handleCardNumberInput(input) {
            let val = input.value.replace(/\D/g, '');
            let formatted = val.replace(/(.{4})/g, '$1 ').trim();
            input.value = formatted;

            const display = document.getElementById('ccDisplayNumber');
            display.textContent = formatted.length > 0 ? formatted : '•••• •••• •••• ••••';

            // Detect Visa / Master
            const brand = document.getElementById('cardBrandText');
            if (val.startsWith('4')) {
                brand.textContent = 'VISA';
                document.getElementById('cardTypeDetect').textContent = 'VISA DETECTADA';
            } else if (val.startsWith('5')) {
                brand.textContent = 'MASTERCARD';
                document.getElementById('cardTypeDetect').textContent = 'MASTERCARD DETECTADA';
            } else if (val.startsWith('3')) {
                brand.textContent = 'AMEX';
                document.getElementById('cardTypeDetect').textContent = 'AMERICAN EXPRESS';
            } else {
                brand.textContent = 'CorpCard';
                document.getElementById('cardTypeDetect').textContent = 'TARJETA CRÉDITO / DÉBITO';
            }
        }

        function handleExpiryInput(input) {
            let val = input.value.replace(/\D/g, '');
            if (val.length >= 2) {
                val = val.substring(0, 2) + '/' + val.substring(2, 4);
            }
            input.value = val;
            document.getElementById('ccDisplayExpiry').textContent = val.length > 0 ? val : '12/28';
        }

        function syncCardHolder(val) {
            document.getElementById('ccDisplayHolder').textContent = val.trim().length > 0 ? val.toUpperCase() : 'ELENA VALENZUELA';
        }

        function syncCvc(val) {
            document.getElementById('ccDisplayCvc').textContent = val.length > 0 ? val.replace(/./g, '•') : '•••';
            const card = document.getElementById('visualCreditCard');
            card.classList.toggle('has-cvc', val.length > 0);
        }

        function toggleCfdiFields(checked) {
            document.getElementById('cfdiFields').style.display = checked ? 'block' : 'none';
        }

        function selectPayMethod(method, btn) {
            document.querySelectorAll('.pay-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if (method === 'card') {
                document.getElementById('method-card-panel').style.display = 'block';
                document.getElementById('method-spei-panel').style.display = 'none';
            } else if (method === 'spei') {
                document.getElementById('method-card-panel').style.display = 'none';
                document.getElementById('method-spei-panel').style.display = 'block';
            } else {
                document.getElementById('method-card-panel').style.display = 'block';
                document.getElementById('method-spei-panel').style.display = 'none';
                showToast(method.toUpperCase(), `Método ${method.toUpperCase()} seleccionado.`, 'info');
            }

            // Con SPEI los campos de tarjeta quedan ocultos: si siguen siendo
            // required el navegador bloquea el envío sin mostrar el error.
            document.querySelectorAll('#method-card-panel input').forEach(input => {
                input.required = method !== 'spei';
            });
        }

        function fillTestCard() {
            document.getElementById('cardHolderInput').value = 'Elena Valenzuela';
            syncCardHolder('Elena Valenzuela');

            const numberInput = document.getElementById('cardNumberInput');
            numberInput.value = '4532 8920 1823 8921';
            handleCardNumberInput(numberInput);

            const expInput = document.getElementById('cardExpiryInput');
            expInput.value = '10/29';
            handleExpiryInput(expInput);

            document.getElementById('cardCvcInput').value = '849';
            syncCvc('849');

            showToast('Demo Lista', 'Datos de tarjeta de prueba cargados correctamente.', 'success');
        }

        function applyPromoCode() {
            const code = document.getElementById('couponCodeInput').value.trim().toUpperCase();
            const feedback = document.getElementById('couponFeedback');
            const discountRow = document.getElementById('discountRow');

            if (code === 'JFAST20') {
                discount = subtotal * 0.20;
                discountRow.style.display = 'flex';
                feedback.style.display = 'block';
                feedback.style.color = 'var(--success)';
                feedback.textContent = `✓ ¡Cupón JFAST20 aplicado! 20% de descuento ($${discount.toFixed(2)} USD).`;
                showToast('Cupón Válido', 'Descuento del 20% aplicado a la orden.', 'success');
            } else if (code === 'BIENVENIDO10') {
                discount = subtotal * 0.10;
                discountRow.style.display = 'flex';
                feedback.style.display = 'block';
                feedback.style.color = 'var(--success)';
                feedback.textContent = `✓ ¡Cupón BIENVENIDO10 aplicado! 10% de descuento ($${discount.toFixed(2)} USD).`;
                showToast('Cupón Válido', 'Descuento del 10% aplicado.', 'success');
            } else if (code === 'VIP50') {
                discount = subtotal * 0.50;
                discountRow.style.display = 'flex';
                feedback.style.display = 'block';
                feedback.style.color = 'var(--success)';
                feedback.textContent = `✓ ¡Cupón VIP50 activado! 50% de descuento especial ($${discount.toFixed(2)} USD).`;
                showToast('Cupón VIP', '50% de descuento especial aplicado.', 'success');
            } else if (code === '') {
                feedback.style.display = 'none';
                discount = 0;
                discountRow.style.display = 'none';
            } else {
                discount = 0;
                discountRow.style.display = 'none';
                feedback.style.display = 'block';
                feedback.style.color = 'var(--danger)';
                feedback.textContent = '✕ Código no válido o expirado. Prueba con JFAST20 o BIENVENIDO10';
                showToast('Cupón Inválido', 'El código ingresado no existe.', 'warning');
            }
            updateTotals();
        }

        function processPayment(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitPayment');
            const text = document.getElementById('btnPayText');
            const spinner = document.getElementById('btnPaySpinner');

            text.textContent = 'Autorizando con el Banco Central...';
            spinner.style.display = 'inline-block';
            btn.disabled = true;

            setTimeout(() => {
                spinner.style.display = 'none';
                btn.disabled = false;
                text.textContent = 'Pago Procesado ✓';
                
                // Set modal random auth
                const randomAuth = 'AUTH-' + Math.floor(1000000 + Math.random() * 9000000);
                document.getElementById('authCodeDisplay').textContent = randomAuth;
                const now = new Date();
                document.getElementById('authDateDisplay').textContent = `${now.toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}, ${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')} hrs`;

                openModal('modalPaymentSuccess');
                showToast('Transacción Aprobada', 'El pago fue procesado con éxito.', 'success');
            }, 1600);
        }

        function downloadReceipt() {
            const auth = document.getElementById('authCodeDisplay').textContent;
            showToast('Descargando', `Generando archivo PDF para ${auth}...`, 'info');
            setTimeout(() => {
                showToast('Comprobante', 'Comprobante bancario descargado en tu dispositivo.', 'success');
            }, 1200);
        }

        // Tarjeta 3D: el CVC la voltea, brillo que sigue al cursor y realce del campo que se edita
        (function initCardPreview() {
            const card = document.getElementById('visualCreditCard');
            const scene = document.getElementById('ccScene');
            let pulseTimer;
            const pulse = () => {
                card.classList.add('cc-pulse');
                clearTimeout(pulseTimer);
                pulseTimer = setTimeout(() => card.classList.remove('cc-pulse'), 420);
            };
            const setFlip = (on) => card.classList.toggle('is-flipped', on);

            const fieldMap = { cardNumberInput: 'ccFieldNumber', cardHolderInput: 'ccFieldHolder', cardExpiryInput: 'ccFieldExpiry' };
            Object.entries(fieldMap).forEach(([inputId, fieldId]) => {
                const input = document.getElementById(inputId);
                const field = document.getElementById(fieldId);
                input.addEventListener('focus', () => { setFlip(false); field.classList.add('is-focus'); });
                input.addEventListener('blur', () => field.classList.remove('is-focus'));
                input.addEventListener('input', pulse);
            });

            const cvc = document.getElementById('cardCvcInput');
            cvc.addEventListener('focus', () => setFlip(true));
            cvc.addEventListener('blur', () => setFlip(false));
            cvc.addEventListener('input', pulse);

            card.addEventListener('click', () => card.classList.toggle('is-flipped'));
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.classList.toggle('is-flipped'); }
            });

            scene.addEventListener('mousemove', (e) => {
                const r = scene.getBoundingClientRect();
                card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
                card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
            });
            scene.addEventListener('mouseleave', () => {
                card.style.removeProperty('--mx');
                card.style.removeProperty('--my');
            });
        })();

        // Initialize calculations and cart render
        renderCart();
    </script>
</body>
</html>
