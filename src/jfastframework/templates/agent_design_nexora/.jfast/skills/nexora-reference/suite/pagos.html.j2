<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JFast Suite | Pasarela de Pagos Segura</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
    
    <!-- Unified CSS -->
    <link rel="stylesheet" href="assets/css/nexora.css">

    <style>
        /* ==========================================================
           Pagos — checkout en vidrio líquido
           ========================================================== */
        .pay-head { margin-top: 40px; }
        .pay-head .nx-eyebrow { margin-bottom: 12px; }
        .pay-head h1 .hero-title-faded { font-weight: 800; }

        .checkout-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
            gap: 28px;
            align-items: start;
            margin: 8px 0 72px;
        }

        .checkout-form-panel { padding: 30px; border-radius: var(--radius-xl); }

        .checkout-aside { display: flex; flex-direction: column; gap: 22px; min-width: 0; }

        /* ---- Encabezados de paso ---- */
        .step-head {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 18px;
        }

        .step-num {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: rgb(var(--c-accent));
            padding: 5px 9px;
            border-radius: 9999px;
            background: rgb(var(--c-accent) / 0.1);
            border: 1px solid rgb(var(--c-accent) / 0.28);
            line-height: 1;
            margin-top: 3px;
            flex-shrink: 0;
        }

        .step-head h2 {
            font-size: 1.22rem;
            font-weight: 800;
            letter-spacing: -0.035em;
            line-height: 1.2;
        }

        .step-head p { font-size: 0.8rem; color: var(--text-dim); margin-top: 2px; }

        .step-divider {
            height: 1px;
            background: var(--card-border);
            margin: 26px 0 24px;
        }

        /* ---- Selector de método: control segmentado de vidrio ---- */
        .payment-methods-selector {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 4px;
            padding: 5px;
            margin-bottom: 26px;
            border-radius: 20px;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
        }

        html.nx-light .payment-methods-selector { box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05); }

        .pay-tab-btn {
            background: transparent;
            border: 1px solid transparent;
            border-radius: 15px;
            padding: 12px 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            cursor: pointer;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-dim);
            white-space: nowrap;
            transition: var(--transition-smooth);
        }

        .pay-tab-btn svg { opacity: 0.85; transition: transform 0.25s var(--ease-out), color 0.2s ease; }

        .pay-tab-btn:hover { color: var(--text-main); background: var(--pill-bg); }
        .pay-tab-btn:hover svg { transform: translateY(-1px); }

        .pay-tab-btn.active {
            color: var(--text-main);
            border-color: rgb(var(--c-accent) / 0.45);
            background: linear-gradient(180deg, rgb(var(--c-accent) / 0.2), rgb(var(--c-accent) / 0.06));
            box-shadow: 0 12px 26px -12px rgb(var(--c-accent) / 0.7), inset 0 1px 1px var(--card-specular);
        }

        .pay-tab-btn.active svg {
            color: rgb(var(--c-accent));
            opacity: 1;
            filter: drop-shadow(0 0 6px rgb(var(--c-accent) / 0.55));
        }

        .pay-tab-btn:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }

        /* ---- Formulario ---- */
        .checkout-form-panel .form-label { flex-wrap: wrap; gap: 4px 10px; }

        .form-hint {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 500;
            color: var(--text-sub);
            letter-spacing: 0.02em;
        }

        .card-detect {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgb(var(--c-accent));
        }

        .input-with-icon { position: relative; }
        .input-with-icon .form-input { padding-right: 44px; }

        .input-with-icon > svg {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-sub);
            pointer-events: none;
        }

        .form-input.nx-mono { letter-spacing: 0.06em; }

        .form-row-2 {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        /* Panel interior (SPEI, CFDI) */
        .pay-inset {
            padding: 18px 20px;
            border-radius: 20px;
            background: var(--bg-muted);
            border: 1px solid var(--card-border);
            box-shadow: inset 0 1px 1px var(--card-specular);
        }

        #method-spei-panel { margin-bottom: 4px; }

        .pay-inset h4 {
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -0.025em;
            margin: 8px 0 4px;
        }

        .pay-inset > p { font-size: 0.82rem; color: var(--text-dim); margin-bottom: 14px; }

        .spei-sheet {
            border-radius: 16px;
            border: 1px dashed var(--badge-border);
            background: var(--pill-bg);
            padding: 6px 16px;
        }

        .spei-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid var(--card-border);
            font-size: 0.82rem;
            flex-wrap: wrap;
        }

        .spei-row:last-child { border-bottom: none; }

        .spei-k {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        .spei-v { font-weight: 600; text-align: right; }
        .spei-v.nx-mono { font-size: 0.82rem; letter-spacing: 0.04em; }

        .spei-clabe .spei-v {
            font-family: var(--font-mono);
            font-size: 0.98rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--text-main);
        }

        .spei-clabe-wrap { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

        .btn-xs {
            padding: 5px 12px;
            font-size: 0.72rem;
            gap: 6px;
        }

        .cfdi-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .cfdi-row strong { font-size: 0.9rem; font-weight: 700; }
        .cfdi-row p { font-size: 0.78rem; color: var(--text-dim); margin-top: 2px; }

        #cfdiFields {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--card-border);
        }

        #cfdiFields .form-group { margin-bottom: 0; }

        /* ---- Botón de pago ---- */
        .btn-pay {
            width: 100%;
            margin-top: 22px;
            padding: 17px 24px;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            font-variant-numeric: tabular-nums;
        }

        .btn-pay > span, .btn-pay > svg { position: relative; z-index: 1; }

        .btn-pay:disabled {
            opacity: 1;
            cursor: progress;
            transform: none;
        }

        .btn-pay:disabled .pay-lock { display: none; }

        .btn-pay:disabled::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            background: linear-gradient(100deg, transparent 25%, rgba(255, 255, 255, 0.32) 50%, transparent 75%);
            animation: paySweep 1.15s ease-in-out infinite;
        }

        @keyframes paySweep {
            from { transform: translateX(-100%); }
            to { transform: translateX(100%); }
        }

        .btn-pay .btn-spinner {
            border-color: rgb(var(--c-on-accent) / 0.35);
            border-top-color: rgb(var(--c-on-accent));
        }

        .security-badges {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .security-badges span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 12px;
            border-radius: 9999px;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        /* ==========================================================
           Tarjeta 3D: metal negro con reflejo cáustico del acento
           ========================================================== */
        .cc-stage {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            container-type: inline-size;
        }

        .cc-scene {
            position: relative;
            perspective: 1400px;
            transform-style: preserve-3d;
            transition: transform 0.3s var(--ease-out);
        }

        /* Sombra de piso con tinte de acento */
        .cc-scene::before {
            content: "";
            position: absolute;
            left: 12%;
            right: 12%;
            bottom: -26px;
            height: 46px;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgb(var(--c-accent) / 0.55), rgb(var(--c-accent-deep) / 0.25) 45%, transparent 72%);
            filter: blur(16px);
            transform: translateZ(-60px);
            pointer-events: none;
        }

        html.nx-light .cc-scene::before { opacity: 0.6; }

        .cc-visual-card {
            --mx: 28%;
            --my: 8%;
            position: relative;
            width: 100%;
            aspect-ratio: 1.586;
            border-radius: 22px;
            transform-style: preserve-3d;
            transition: transform 0.85s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
            cursor: pointer;
            color: #ffffff;
            box-shadow:
                0 44px 70px -30px rgb(var(--c-accent) / 0.55),
                0 30px 60px -24px rgba(0, 0, 0, 0.85);
        }

        html.nx-light .cc-visual-card {
            box-shadow:
                0 40px 60px -30px rgb(var(--c-accent) / 0.45),
                0 26px 50px -22px rgba(15, 20, 40, 0.45);
        }

        .cc-visual-card.is-flipped { transform: rotateY(180deg); }

        .cc-visual-card:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 6px; }

        .cc-visual-card.has-cvc {
            box-shadow:
                0 44px 80px -28px rgb(var(--c-accent) / 0.75),
                0 30px 60px -24px rgba(0, 0, 0, 0.85);
        }

        .cc-face {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            overflow: hidden;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            background:
                radial-gradient(120% 95% at 102% -8%, rgb(var(--c-accent) / 0.62) 0%, rgb(var(--c-accent-deep) / 0.42) 30%, transparent 58%),
                radial-gradient(75% 80% at -8% 108%, rgb(var(--c-glow) / 0.26) 0%, transparent 58%),
                repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 4px),
                linear-gradient(152deg, #1d1e25 0%, #0b0b0f 42%, #16171d 68%, #07070a 100%);
            box-shadow:
                inset 0 1px 1px rgba(255, 255, 255, 0.38),
                inset 0 0 0 1px rgba(255, 255, 255, 0.09),
                inset 0 -28px 50px rgba(0, 0, 0, 0.4);
        }

        /* Reflejo cáustico: manchas de luz líquida que se mueven lento */
        .cc-face::before {
            content: "";
            position: absolute;
            inset: -35%;
            background:
                radial-gradient(24% 12% at 64% 32%, rgb(var(--c-glow) / 0.7), transparent 70%),
                radial-gradient(14% 30% at 80% 56%, rgb(var(--c-accent) / 0.6), transparent 70%),
                radial-gradient(34% 9% at 42% 70%, rgb(var(--c-glow) / 0.3), transparent 70%),
                radial-gradient(10% 18% at 24% 40%, rgb(var(--c-accent) / 0.22), transparent 70%);
            filter: blur(14px);
            mix-blend-mode: screen;
            opacity: 0.85;
            animation: ccCaustic 11s ease-in-out infinite alternate;
            pointer-events: none;
            transition: opacity 0.35s ease, filter 0.35s ease;
        }

        /* Brillo especular que sigue al cursor */
        .cc-face::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(55% 60% at var(--mx) var(--my), rgba(255, 255, 255, 0.2), transparent 62%),
                linear-gradient(116deg, transparent 34%, rgba(255, 255, 255, 0.07) 47%, rgba(255, 255, 255, 0.02) 52%, transparent 60%);
            pointer-events: none;
        }

        @keyframes ccCaustic {
            0% { transform: rotate(-8deg) translate(0, 0) scale(1); }
            50% { transform: rotate(4deg) translate(-4%, 3%) scale(1.06); }
            100% { transform: rotate(-2deg) translate(3%, -2%) scale(0.98); }
        }

        /* Reacciona al escribir */
        .cc-visual-card.cc-pulse .cc-face::before {
            opacity: 1;
            filter: blur(12px) brightness(1.35);
        }

        .cc-front {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 6.4cqi 7cqi;
            max-width: 100%;
        }

        .cc-front > *, .cc-back > * { position: relative; z-index: 2; }

        .cc-top-row,
        .cc-chip-row,
        .cc-footer-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .cc-issuer {
            display: flex;
            align-items: baseline;
            gap: 7px;
            font-family: var(--font-script);
            font-size: clamp(1.15rem, 6cqi, 1.7rem);
            font-weight: 700;
            line-height: 1;
            color: #ffffff;
        }

        .cc-issuer small {
            font-family: var(--font-mono);
            font-size: 0.34em;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgb(var(--c-glow));
            transform: translateY(-3px);
        }

        .cc-brand-badge {
            font-family: var(--font-sans);
            font-size: clamp(0.95rem, 4.6cqi, 1.3rem);
            font-weight: 900;
            font-style: italic;
            letter-spacing: 0.02em;
            color: #ffffff;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
            white-space: nowrap;
        }

        .cc-chip-row { justify-content: flex-start; gap: 14px; }

        .cc-chip {
            width: clamp(38px, 11cqi, 50px);
            aspect-ratio: 1.34;
            border-radius: 7px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #f7e7ad 0%, #d6ab4d 32%, #f4dc8f 55%, #b18a36 78%, #e6c774 100%);
            box-shadow: inset 0 0 0 1px rgba(60, 40, 0, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.7), 0 3px 8px rgba(0, 0, 0, 0.45);
        }

        .cc-chip::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(90deg, transparent 31%, rgba(70, 45, 0, 0.35) 31% 34%, transparent 34% 66%, rgba(70, 45, 0, 0.35) 66% 69%, transparent 69%),
                linear-gradient(0deg, transparent 47%, rgba(70, 45, 0, 0.35) 47% 53%, transparent 53%);
        }

        .cc-chip::after {
            content: "";
            position: absolute;
            inset: 26% 38%;
            border: 1px solid rgba(70, 45, 0, 0.4);
            border-radius: 3px;
        }

        .cc-contactless { width: clamp(20px, 6cqi, 26px); height: auto; color: rgba(255, 255, 255, 0.75); }

        .cc-field {
            border-radius: 10px;
            padding: 3px 8px;
            margin: -3px -8px;
            transition: background 0.25s ease, box-shadow 0.25s ease;
            min-width: 0;
        }

        #ccFieldNumber { align-self: flex-start; max-width: calc(100% + 16px); }

        .cc-field.is-focus {
            background: rgba(255, 255, 255, 0.07);
            box-shadow: 0 0 0 1px rgb(var(--c-glow) / 0.6), 0 0 22px -2px rgb(var(--c-accent) / 0.45);
        }

        .cc-number-display {
            font-family: var(--font-mono);
            font-size: clamp(0.95rem, 5.3cqi, 1.6rem);
            font-weight: 600;
            letter-spacing: 0.1em;
            word-spacing: 0.1em;
            white-space: nowrap;
            line-height: 1.2;
            background: linear-gradient(180deg, #ffffff 0%, #e2e4ec 50%, #9da1b0 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.7)) drop-shadow(0 0 14px rgb(var(--c-accent) / 0.3));
        }

        .cc-footer-row { align-items: flex-end; text-transform: uppercase; }
        .cc-footer-row > .cc-field:first-child { flex: 1; }

        .cc-label {
            font-family: var(--font-mono);
            font-size: clamp(0.5rem, 2.1cqi, 0.6rem);
            color: rgba(255, 255, 255, 0.5);
            font-weight: 700;
            letter-spacing: 0.16em;
            margin-bottom: 3px;
        }

        .cc-holder-display {
            font-size: clamp(0.74rem, 3.4cqi, 0.95rem);
            font-weight: 700;
            letter-spacing: 0.08em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #ffffff;
            max-width: 60cqi;
        }

        .cc-holder-display.nx-mono { letter-spacing: 0.06em; }

        /* Reverso */
        .cc-back { transform: rotateY(180deg); }

        .cc-back.cc-face {
            background:
                radial-gradient(110% 90% at -4% -6%, rgb(var(--c-accent) / 0.5) 0%, rgb(var(--c-accent-deep) / 0.4) 30%, transparent 58%),
                radial-gradient(70% 80% at 108% 108%, rgb(var(--c-glow) / 0.22) 0%, transparent 58%),
                repeating-linear-gradient(80deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 4px),
                linear-gradient(208deg, #1d1e25 0%, #0b0b0f 42%, #16171d 68%, #07070a 100%);
        }

        .cc-stripe {
            position: absolute !important;
            left: 0;
            right: 0;
            top: 11%;
            height: 19%;
            background: linear-gradient(180deg, #030304 0%, #17171c 45%, #060607 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(255, 255, 255, 0.05);
        }

        .cc-sign-row {
            position: absolute !important;
            left: 7%;
            right: 7%;
            top: 41%;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cc-sign {
            flex: 1;
            height: clamp(28px, 9cqi, 40px);
            border-radius: 6px;
            background: repeating-linear-gradient(-45deg, #ecedf2 0 6px, #d8d9e0 6px 12px);
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.25);
        }

        .cc-cvv-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: clamp(58px, 17cqi, 78px);
            height: clamp(28px, 9cqi, 40px);
            border-radius: 8px;
            background: #ffffff;
            color: #0b0b10;
            box-shadow: 0 0 0 2px rgb(var(--c-accent)), 0 0 22px rgb(var(--c-accent) / 0.55);
        }

        .cc-cvv-box #ccDisplayCvc {
            font-family: var(--font-mono);
            font-size: clamp(0.8rem, 3.6cqi, 1rem);
            font-weight: 700;
            letter-spacing: 0.18em;
            line-height: 1;
        }

        .cc-cvv-label {
            position: absolute !important;
            right: 7%;
            top: 33%;
            font-family: var(--font-mono);
            font-size: clamp(0.5rem, 2.1cqi, 0.6rem);
            font-weight: 700;
            letter-spacing: 0.16em;
            color: rgba(255, 255, 255, 0.55);
        }

        .cc-back-foot {
            position: absolute !important;
            left: 7%;
            right: 7%;
            bottom: 9%;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 14px;
        }

        .cc-legal {
            font-family: var(--font-mono);
            font-size: clamp(0.46rem, 1.9cqi, 0.56rem);
            line-height: 1.5;
            letter-spacing: 0.04em;
            color: rgba(255, 255, 255, 0.45);
            max-width: 62%;
        }

        .cc-holo {
            width: clamp(38px, 12cqi, 54px);
            aspect-ratio: 1;
            border-radius: 12px;
            background:
                radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.85), transparent 35%),
                conic-gradient(from 200deg, rgb(var(--c-glow)), #ffffff, rgb(var(--c-accent)), rgb(var(--c-accent-deep)), rgb(var(--c-glow)));
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35), 0 6px 16px -4px rgb(var(--c-accent) / 0.6);
            opacity: 0.9;
        }

        .cc-hint {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 34px;
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-sub);
            text-align: center;
        }

        /* ==========================================================
           Resumen del pedido
           ========================================================== */
        .order-panel { padding: 26px; border-radius: var(--radius-xl); }

        .order-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 6px;
        }

        .order-head h3 { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.035em; }
        #cartItemCountBadge { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.04em; }

        .order-item-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 15px 0;
            border-bottom: 1px solid var(--card-border);
            gap: 12px;
        }

        .order-item-idx {
            font-family: var(--font-mono);
            font-size: 0.66rem;
            font-weight: 700;
            color: var(--text-sub);
            width: 30px;
            height: 30px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            flex-shrink: 0;
        }

        .order-item-info { flex: 1; min-width: 0; }

        .order-item-title { font-size: 0.88rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }
        .order-item-desc { font-size: 0.74rem; color: var(--text-dim); margin-top: 2px; }

        .order-item-actions { display: flex; align-items: center; gap: 10px; margin-top: 9px; }

        .qty-stepper {
            display: inline-flex;
            align-items: center;
            padding: 2px;
            border-radius: 9999px;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
        }

        .qty-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-fast);
        }

        .qty-btn:hover { background: var(--pill-hover); color: var(--text-main); }

        .qty-val {
            min-width: 24px;
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.76rem;
            font-weight: 700;
        }

        .order-remove {
            border: none;
            background: none;
            padding: 4px 6px;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-sub);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: var(--transition-fast);
        }

        .order-remove:hover { color: var(--danger); background: var(--danger-light); }

        .order-item-price {
            font-family: var(--font-mono);
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .order-empty {
            padding: 28px 12px;
            text-align: center;
            color: var(--text-dim);
            font-size: 0.84rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .order-empty svg { color: var(--text-sub); }

        .coupon-box { display: flex; gap: 8px; margin: 18px 0 14px; }
        .coupon-box .form-input { flex: 1; min-width: 0; text-transform: uppercase; }
        .coupon-box .btn-modern { flex-shrink: 0; }

        #couponFeedback {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            margin: -4px 0 12px;
            display: none;
        }

        .totals-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 0.84rem;
            margin-top: 4px;
            padding-top: 16px;
            border-top: 1px dashed var(--badge-border);
        }

        .totals-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
        .totals-row > span:first-child { color: var(--text-dim); }

        .totals-row > span:last-child {
            font-family: var(--font-mono);
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .totals-row.is-discount > span { color: var(--success) !important; }

        .totals-total {
            margin-top: 6px;
            padding-top: 16px;
            border-top: 1px solid var(--card-border);
            align-items: flex-end;
        }

        .totals-total > span:first-child {
            color: var(--text-main) !important;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.02em;
        }

        .total-amount { display: inline-flex; align-items: baseline; gap: 6px; }

        #totalFinalVal {
            font-family: var(--font-mono);
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: rgb(var(--c-accent));
            text-shadow: 0 0 26px rgb(var(--c-accent) / 0.35);
            font-variant-numeric: tabular-nums;
        }

        .total-amount small {
            font-family: var(--font-mono);
            font-size: 0.66rem;
            font-weight: 700;
            color: var(--text-dim);
            letter-spacing: 0.08em;
        }

        /* ==========================================================
           Modal de éxito
           ========================================================== */
        .pay-success-card { max-width: 520px; }

        .success-hero { text-align: center; padding: 6px 0 4px; }

        .success-orb {
            width: 68px;
            height: 68px;
            margin: 0 auto 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--success);
            background: var(--success-light);
            border: 1px solid var(--success-border);
            box-shadow: 0 0 0 8px rgba(52, 211, 153, 0.06), 0 18px 40px -12px rgba(52, 211, 153, 0.55);
        }

        .success-orb path {
            stroke-dasharray: 26;
            stroke-dashoffset: 26;
        }

        .modal-overlay.active .success-orb path { animation: drawCheck 0.6s 0.25s var(--ease-out) forwards; }

        @keyframes drawCheck { to { stroke-dashoffset: 0; } }

        #modalConfirmedAmount {
            font-family: var(--font-mono);
            font-size: clamp(1.7rem, 6vw, 2.3rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            color: var(--text-main);
            line-height: 1.1;
        }

        .success-hero p { color: var(--text-dim); font-size: 0.86rem; margin-top: 6px; }

        .receipt {
            border-radius: 18px;
            padding: 6px 18px;
            background: var(--bg-muted);
            border: 1px dashed var(--badge-border);
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid var(--card-border);
            font-size: 0.82rem;
            flex-wrap: wrap;
        }

        .receipt-row:last-child { border-bottom: none; }

        .receipt-row > span:first-child {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        .receipt-row .nx-mono { font-size: 0.8rem; font-weight: 600; }

        .success-note { font-size: 0.8rem; color: var(--text-dim); text-align: center; }

        .pay-success-card .modal-footer { flex-wrap: wrap; }

        /* ==========================================================
           Responsive
           ========================================================== */
        @media (max-width: 950px) {
            .checkout-layout { grid-template-columns: minmax(0, 1fr); }
            /* En móvil la tarjeta va primero para verla mientras se escribe */
            .checkout-aside { display: contents; }
            .cc-stage { order: -1; margin-bottom: 8px; }
            .payment-methods-selector { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 560px) {
            .pay-head { margin-top: 28px; }
            .checkout-form-panel, .order-panel { padding: 20px; }
            .cfdi-grid { grid-template-columns: minmax(0, 1fr) !important; }
            .cc-hint { margin-top: 28px; }
            .pay-success-card .modal-footer .btn-modern { flex: 1 1 100%; }
            .order-item-idx { display: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            .cc-visual-card { transition: none; }
        }
    </style>
</head>
