<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JFast Suite</title>
    <meta name="description" content="CRM, red social corporativa, pagos, widgets y tablas fiscales en una sola suite de vidrio líquido.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="assets/css/nexora.css">

    <style>
        /* ================= Landing ================= */
        .lp-section { padding: 110px 0 40px; }
        .lp-head { max-width: 720px; margin-bottom: 48px; }
        .lp-head.center { margin-inline: auto; text-align: center; }
        .lp-head h2 {
            font-size: clamp(2.2rem, 4.6vw, 3.4rem);
            font-weight: 900;
            letter-spacing: -0.045em;
            line-height: 1.02;
            margin-top: 10px;
        }
        .lp-head p { color: var(--text-dim); font-size: 1.02rem; margin-top: 12px; max-width: 560px; }
        .lp-head.center p { margin-inline: auto; }

        /* ---------- Hero ---------- */
        .hero { padding: 84px 0 30px; }
        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 56px;
            align-items: start;
            margin-bottom: 64px;
        }
        .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
        .hero-copy h1 { font-size: clamp(3rem, 7.2vw, 5.5rem); }
        .hero-lead { font-size: 1.12rem; line-height: 1.65; color: var(--text-dim); max-width: 560px; }
        .hero-chips { display: flex; flex-wrap: wrap; gap: 10px; }
        .hero-chips .nx-pill { font-size: 0.74rem; color: var(--text-dim); }
        .hero-chips .nx-pill span { color: var(--text-main); }
        .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding-top: 6px; }

        .hero-float { display: flex; flex-direction: column; gap: 18px; padding-top: 10px; }
        .float-card { border-radius: 22px; padding: 24px; cursor: default; }
        .float-card .quote-mark { color: rgb(var(--c-accent)); opacity: 0.7; margin-bottom: 12px; }
        .float-card p { font-size: 0.92rem; font-weight: 500; line-height: 1.6; }
        .float-foot {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-top: 14px;
            margin-top: 20px;
            border-top: 1px solid var(--card-border);
        }
        .float-foot img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgb(var(--c-accent) / 0.3); }
        .float-foot h4 { font-size: 0.8rem; font-weight: 700; letter-spacing: 0; }
        .float-foot small { font-size: 0.72rem; color: var(--text-dim); }
        .kpi-line { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
        .kpi-line b { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; }
        .deal-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 14px;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
            font-size: 0.8rem;
        }
        .deal-row + .deal-row { margin-top: 8px; }
        .deal-row small { display: block; font-size: 0.68rem; color: var(--text-dim); }
        .dots-nav { display: flex; align-items: center; justify-content: space-between; padding: 0 12px; color: rgb(var(--c-glow)); }
        .dots-nav span { display: inline-block; height: 6px; border-radius: 9px; background: currentColor; }

        .metrics {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 32px;
            max-width: 760px;
            padding-top: 30px;
            border-top: 1px solid var(--card-border);
        }
        .metrics label { display: block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim); margin-bottom: 4px; }
        .metrics b { font-family: var(--font-mono); font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 800; letter-spacing: -0.03em; }

        /* ---------- Consola (ventana tipo estudio) ---------- */
        .studio-shell { border-radius: 28px; overflow: hidden; }
        .studio-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 12px 18px;
            border-bottom: 1px solid var(--card-border);
            background: var(--bg-muted);
        }
        .studio-dots { display: flex; gap: 7px; }
        .studio-dots span { width: 11px; height: 11px; border-radius: 50%; }
        .studio-url {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-dim);
            padding: 6px 14px;
            border-radius: 9999px;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
        }
        .studio-tabs {
            display: flex;
            gap: 6px;
            padding: 12px 18px;
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
            scrollbar-width: none;
        }
        .studio-tabs::-webkit-scrollbar { display: none; }
        .studio-tab {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 9999px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-dim);
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: var(--transition-fast);
        }
        .studio-tab:hover { color: var(--text-main); background: var(--pill-bg); }
        .studio-tab.active {
            color: var(--text-main);
            background: var(--pill-bg);
            border-color: var(--badge-border);
            box-shadow: inset 0 1px 1px var(--card-specular);
        }
        .studio-tab.active svg { color: rgb(var(--c-accent)); }
        .studio-view { display: none; padding: 40px; animation: viewFade 0.35s var(--ease-out) both; }
        .studio-view.active { display: block; }
        @keyframes viewFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
        .view-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; align-items: center; }
        .view-grid h3 { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.035em; line-height: 1.15; margin: 12px 0 10px; }
        .view-grid p { font-size: 0.92rem; color: var(--text-dim); line-height: 1.65; margin-bottom: 22px; }
        .view-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .view-stage {
            position: relative;
            padding: 22px;
            border-radius: 22px;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
            overflow: hidden;
        }
        .view-stage::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -80px;
            top: -120px;
            border-radius: 50%;
            background: radial-gradient(circle, rgb(var(--c-accent) / 0.22), transparent 70%);
            filter: blur(30px);
            pointer-events: none;
        }
        .stage-head { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; font-weight: 700; margin-bottom: 12px; }
        .stage-head b { font-family: var(--font-mono); color: rgb(var(--c-glow)); }
        html.nx-light .stage-head b { color: rgb(var(--c-accent)); }
        .mono { font-family: var(--font-mono); }

        .mini-card {
            position: relative;
            padding: 22px;
            border-radius: 20px;
            color: #fff;
            background:
                radial-gradient(120% 90% at 100% 0%, rgb(var(--c-accent) / 0.55), transparent 55%),
                radial-gradient(90% 80% at 0% 100%, rgb(var(--c-accent-deep) / 0.9), transparent 60%),
                linear-gradient(135deg, #17181f, #07070a);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 0 30px 50px -20px rgb(var(--c-accent) / 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.25);
            font-family: var(--font-mono);
        }
        .mini-card .chip { width: 38px; height: 28px; border-radius: 6px; background: linear-gradient(135deg, #e7d6a6, #a8864a); margin: 16px 0 14px; }
        .mini-card .num { font-size: 1.1rem; letter-spacing: 0.16em; }
        .mini-card .row { display: flex; justify-content: space-between; font-size: 0.66rem; color: rgba(255, 255, 255, 0.65); margin-top: 12px; letter-spacing: 0.08em; }

        /* ---------- Bento ---------- */
        .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 22px; }
        .bento-item {
            border-radius: 28px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 24px;
            min-height: 280px;
        }
        .span-7 { grid-column: span 7; }
        .span-5 { grid-column: span 5; }
        .span-4 { grid-column: span 4; }
        .span-12 { grid-column: span 12; }
        .bento-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
        .bento-idx { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); }
        .bento-tag {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 9999px;
            background: rgb(var(--c-accent) / 0.1);
            color: rgb(var(--c-accent));
            border: 1px solid rgb(var(--c-accent) / 0.22);
            white-space: nowrap;
        }
        .bento-item h3 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.035em; line-height: 1.2; margin-bottom: 8px; }
        .bento-item.small h3 { font-size: 1.15rem; }
        .bento-item p { font-size: 0.88rem; color: var(--text-dim); line-height: 1.6; max-width: 520px; }
        .bento-item.small p { font-size: 0.8rem; }
        .bento-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding-top: 16px;
            border-top: 1px solid var(--card-border);
            font-family: var(--font-mono);
            font-size: 0.74rem;
            color: var(--text-dim);
        }
        .kanban { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
        .kanban-col { padding: 12px; border-radius: 16px; background: var(--pill-bg); border: 1px solid var(--card-border); }
        .kanban-col > span { display: block; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; }
        .kanban-card { padding: 9px 10px; border-radius: 11px; background: var(--card-bg); border: 1px solid var(--card-border); font-size: 0.72rem; font-weight: 600; }
        .kanban-card + .kanban-card { margin-top: 6px; }
        .kanban-card small { display: block; font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-dim); font-weight: 500; }
        .orb-row { display: flex; align-items: center; gap: 14px; }
        .orb-row .liquid-orb-accent { width: 52px; height: 52px; flex-shrink: 0; transition: transform 0.4s var(--ease-out), filter 0.4s ease; }
        .live-green { color: var(--success); font-weight: 700; display: inline-flex; align-items: center; gap: 7px; }

        .modals-panel {
            border-radius: 28px;
            padding: 30px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            margin-top: 22px;
        }
        .modals-panel h3 { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.03em; margin: 8px 0 6px; }
        .modals-panel p { font-size: 0.88rem; color: var(--text-dim); max-width: 560px; }
        .modals-panel .view-actions .btn-modern { font-size: 0.82rem; }

        /* ---------- Planes ---------- */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
            max-width: 900px;
            margin: 0 auto;
        }
        .plan {
            position: relative;
            border-radius: 28px;
            padding: 34px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            overflow: hidden;
        }
        .plan.featured { border-color: rgb(var(--c-accent) / 0.45); }
        .plan.featured::before {
            content: "";
            position: absolute;
            inset: -40% -30% auto auto;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgb(var(--c-accent) / 0.28), transparent 70%);
            filter: blur(40px);
            pointer-events: none;
        }
        .plan-name { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .plan-name h3 { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.03em; }
        .plan > p { font-size: 0.86rem; color: var(--text-dim); }
        .plan-price { display: flex; align-items: baseline; gap: 8px; }
        .plan-price b { font-family: var(--font-mono); font-size: 3rem; font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
        .plan-price span { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-dim); }
        .plan ul { list-style: none; display: flex; flex-direction: column; gap: 11px; font-size: 0.88rem; padding-top: 18px; border-top: 1px solid var(--card-border); }
        .plan li { display: flex; gap: 10px; align-items: flex-start; }
        .plan li svg { color: rgb(var(--c-accent)); margin-top: 3px; }
        .plan .btn-modern { margin-top: auto; padding: 13px 20px; }
        .billing-seg { width: 280px; margin: 0 auto 36px; }

        /* ---------- CTA + footer ---------- */
        .cta-panel {
            position: relative;
            border-radius: 32px;
            padding: 72px 32px;
            text-align: center;
            overflow: hidden;
        }
        .cta-panel h2 { font-size: clamp(2rem, 4.6vw, 3.3rem); font-weight: 900; letter-spacing: -0.045em; line-height: 1.04; max-width: 640px; margin: 0 auto 16px; }
        .cta-panel p { color: var(--text-dim); max-width: 480px; margin: 0 auto 28px; }
        .cta-panel .view-actions { justify-content: center; }

        .lp-footer {
            margin-top: 90px;
            padding: 40px 0 48px;
            border-top: 1px solid var(--card-border);
            color: var(--text-dim);
            font-size: 0.8rem;
        }
        .lp-footer .container { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
        .lp-footer .nx-logo { font-size: 1.7rem !important; }
        .lp-footer nav { display: flex; gap: 22px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.72rem; }
        .lp-footer nav a:hover { color: var(--text-main); }

        /* ---------- Modales de ejemplo ---------- */
        .info-list { display: flex; flex-direction: column; gap: 10px; padding: 16px; border-radius: 16px; background: var(--pill-bg); border: 1px solid var(--card-border); font-size: 0.84rem; margin-bottom: 16px; }
        .info-list div { display: flex; justify-content: space-between; gap: 12px; }
        .info-list span { color: var(--text-dim); }
        .alert-icon { width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; background: var(--danger-light); color: var(--danger); border: 1px solid var(--danger-border); }
        .alert-actions { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--card-border); }
        .alert-actions button { padding: 15px; background: none; border: none; font-size: 0.88rem; cursor: pointer; transition: background 0.15s ease; }
        .alert-actions button:hover { background: var(--pill-bg); }
        .alert-actions button:first-child { border-right: 1px solid var(--card-border); color: var(--text-dim); font-weight: 600; }
        .alert-actions button:last-child { color: var(--danger); font-weight: 700; }
        .sheet-title { padding: 16px 20px; border-bottom: 1px solid var(--card-border); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
        .apple-sheet-option svg { color: rgb(var(--c-accent)); }
        .apple-sheet-option.destructive svg { color: var(--danger); }

        /* ---------- Responsive ---------- */
        @media (max-width: 1024px) {
            .hero-grid { grid-template-columns: 1fr; gap: 40px; }
            .hero-float { flex-direction: row; }
            .hero-float > .float-card { flex: 1; }
            .hero-float .dots-nav { display: none; }
            .span-7, .span-5 { grid-column: span 12; }
            .span-4 { grid-column: span 6; }
            .span-4:last-child { grid-column: span 12; }
        }
        @media (max-width: 760px) {
            .lp-section { padding-top: 80px; }
            .hero { padding-top: 56px; }
            .hero-float { flex-direction: column; }
            .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
            .view-grid { grid-template-columns: 1fr; }
            .studio-view { padding: 24px; }
            .studio-url { display: none; }
            .span-4 { grid-column: span 12; }
            .bento-item { padding: 24px; min-height: 0; }
            .kanban { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .kanban-col:last-child { display: none; }
            .pricing-grid { grid-template-columns: 1fr; }
            .cta-panel { padding: 52px 22px; }
            .lp-footer .container { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body data-liquid-x="0.6">

    <header class="nexora-navbar">
        <div class="brand-wrapper">
            <a href="index.html" aria-label="JFast Suite, inicio">
                <div class="brand-info">
                    <h1>JFast <span>Suite</span></h1>
                </div>
            </a>
        </div>

        <nav class="nav-links-menu" id="navLinksMenu" aria-label="Módulos">
            <a href="index.html" class="nav-pill-link active" aria-current="page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                <span>Inicio</span>
            </a>
            <a href="crm.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M9 3v18M15 9l3 3-3 3"/></svg>
                <span>CRM</span>
            </a>
            <a href="social.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                <span>Red Social</span>
            </a>
            <a href="pagos.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="20" height="14" x="2" y="5" rx="3"/><path d="M2 10h20"/></svg>
                <span>Pagos</span>
            </a>
            <a href="widgets.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="7" height="7" x="3" y="3" rx="2"/><rect width="7" height="7" x="14" y="3" rx="2"/><rect width="7" height="7" x="14" y="14" rx="2"/><rect width="7" height="7" x="3" y="14" rx="2"/></svg>
                <span>Widgets</span>
            </a>
            <a href="tablas.html" class="nav-pill-link">
