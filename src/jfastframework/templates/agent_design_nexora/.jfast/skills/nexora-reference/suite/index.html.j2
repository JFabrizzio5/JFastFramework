    <script>
        function switchStudioTab(key, btn) {
            document.querySelectorAll('.studio-tab').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.studio-view').forEach(v => v.classList.remove('active'));
            btn.classList.add('active');
            const view = document.getElementById('studio-' + key);
            if (view) view.classList.add('active');
        }

        // Mensual / anual
        const PRICES = { month: ['$49', '$149', '/ mes'], year: ['$39', '$119', '/ mes · anual'] };
        document.getElementById('billingSeg').addEventListener('click', (e) => {
            const btn = e.target.closest('button');
            if (!btn) return;
            const key = btn.dataset.value;
            document.querySelectorAll('#billingSeg button').forEach(b => { b.dataset.active = String(b === btn); });
            const [starter, enterprise, period] = PRICES[key];
            document.getElementById('priceStarter').textContent = starter;
            document.getElementById('priceEnterprise').textContent = enterprise;
            document.getElementById('periodStarter').textContent = period;
            document.getElementById('periodEnterprise').textContent = period;
            if (key === 'year') showToast('Descuento anual', '20% de ahorro aplicado a los planes.', 'success');
        });

        // Swatches del bento
        document.querySelectorAll('[data-landing-preset]').forEach(btn => {
            btn.addEventListener('click', () => NexoraTheme.setPreset(btn.dataset.landingPreset));
        });
        function syncLandingSwatches() {
            const preset = NexoraTheme.state.preset;
            document.querySelectorAll('[data-landing-preset]').forEach(b => b.classList.toggle('active', b.dataset.landingPreset === preset));
        }
        document.addEventListener('nexora:palette', syncLandingSwatches);
        syncLandingSwatches();

        // Pulso del vidrio 3D
        document.getElementById('btnPulse').addEventListener('click', () => {
            if (window.NexoraLiquid) NexoraLiquid.pulse();
            const orb = document.getElementById('bentoOrb');
            orb.style.transform = 'scale(1.18)';
            orb.style.filter = 'saturate(1.6)';
            setTimeout(() => { orb.style.transform = ''; orb.style.filter = ''; }, 450);
        });

        // Métricas vivas
        setInterval(() => {
            document.getElementById('latencyCounter').textContent = `~${10 + Math.floor(Math.random() * 4)}ms`;
        }, 2800);

        (function fpsMeter() {
            const el = document.getElementById('fpsCounter');
            let frames = 0, last = performance.now();
            (function loop(now) {
                frames++;
                if (now - last > 700) {
                    const fps = Math.min(144, Math.round(frames * 1000 / (now - last)));
                    el.textContent = fps;
                    el.style.color = fps >= 50 ? 'var(--success)' : 'rgb(var(--c-glow))';
                    frames = 0;
                    last = now;
                }
                requestAnimationFrame(loop);
            })(last);
        })();
    </script>
