                <span>Tablas ERP</span>
            </a>
        </nav>

        <div class="navbar-actions">
            <a href="crm.html" class="btn-modern btn-primary nx-hide-sm" style="padding: 9px 18px; font-size: 0.8rem;">Abrir CRM<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:14px;height:14px;stroke-width:2.2;"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <button type="button" class="nx-round-btn" data-open-palette aria-label="Personalizar paleta" title="Personalizar paleta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:2;color:rgb(var(--c-accent));"><circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 11.994 2z"/></svg>
            </button>
            <button type="button" class="nx-round-btn theme-toggle-btn" onclick="toggleTheme()" aria-label="Cambiar tema"></button>
        </div>
    </header>

    <main>
        <!-- =============================== HERO =============================== -->
        <section class="hero">
            <div class="container">
                <span class="nx-pill">
                    <span class="nx-live-dot"></span>
                    <span>JFast Suite 2026 &middot; consola en vivo</span>
                </span>

                <div class="hero-grid" style="margin-top: 30px;">
                    <div class="hero-copy">
                        <div>
                            <h1 class="hero-title-main">Poder esencial</h1>
                            <h1 class="hero-title-faded" style="font-size: clamp(3rem, 7.2vw, 5.5rem);">diseño sin</h1>
                            <h1 class="hero-title-main">fricción.</h1>
