        function switchCrmView(viewName, btn) {
            document.querySelectorAll('.crm-view-section').forEach(v => v.classList.remove('active'));
            const target = document.getElementById('crm-view-' + viewName);
            if (target) target.classList.add('active');

            // Sincroniza el item activo de la barra aunque la vista se abra desde un KPI
            const link = btn || document.querySelector(`.crm-sidebar .nav-sublink[onclick*="switchCrmView('${viewName}'"]`);
            if (link) {
                document.querySelectorAll('.crm-sidebar .nav-sublink').forEach(b => b.classList.remove('active'));
                link.classList.add('active');
            }

            if (window.innerWidth <= 950) closeMobileSidebar();
        }

        function renderCrmClients(filter = '') {
            const tbody = document.getElementById('crmClientsTableBody');
            const filtered = crmClients.filter(c => 
                c.name.toLowerCase().includes(filter.toLowerCase()) || 
                c.contact.toLowerCase().includes(filter.toLowerCase()) ||
                c.email.toLowerCase().includes(filter.toLowerCase())
            );

            // Esferas de vidrio en tonos de la paleta activa
            const gradients = [
                'radial-gradient(circle at 30% 25%, rgb(var(--c-glow)), rgb(var(--c-accent)) 50%, rgb(var(--c-accent-deep)))',
                'radial-gradient(circle at 30% 25%, rgb(var(--c-accent)), rgb(var(--c-body)) 55%, rgb(var(--c-accent-deep)))',
                'radial-gradient(circle at 30% 25%, #5b5f6e, #23252e 55%, #0b0c10)'
            ];

            tbody.innerHTML = filtered.map((c, i) => {
                const initials = c.name.split(' ').map(w => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();
                const grad = gradients[i % gradients.length];
                const stageClass = c.stage.includes('Cerrado') ? 'status-completed' : (c.stage.includes('Propuesta') ? 'status-pending' : 'status-review');
                const rfc = `RFC: ${c.name.replace(/[^A-Z]/g, '').slice(0, 4)}26092${i}K${i}`;

                return `
                <tr>
                    <td>
                        <div class="company-cell">
                            <div class="company-avatar-badge" style="background: ${grad};">${initials}</div>
                            <div>
                                <div class="company-name">${c.name}</div>
                                <div class="company-rfc">${rfc} • LTV: <span style="color: rgb(var(--c-glow)); font-weight:700;">${c.ltv}</span></div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="contact-pill">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.6;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span>${c.contact}</span>
                        </div>
                    </td>
                    <td>
                        <a href="mailto:${c.email}" class="email-cell">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            <span>${c.email}</span>
                        </a>
                    </td>
                    <td>
                        <div class="phone-cell">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            <span>${c.phone}</span>
                        </div>
                    </td>
                    <td>
                        <span class="stage-pill ${stageClass}">${c.stage}</span>
                    </td>
                    <td style="text-align: right;">
                        <button class="btn-table-ficha" onclick="viewClientDetail('${c.name}', '${c.email}', '${c.ltv}', '${c.stage}')">
                            <span>Ver Ficha</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                    </td>
                </tr>
            `;
            }).join('');
        }

        function filterCrmClients(val) {
            renderCrmClients(val);
        }

        function viewClientDetail(name, email, ltv, stage) {
            document.getElementById('modalClientName').textContent = name;
            document.getElementById('modalClientEmail').textContent = email;
            document.getElementById('modalClientLtv').textContent = ltv;
            const stageEl = document.getElementById('modalClientStage');
            stageEl.textContent = stage;
            stageEl.className = 'stage-pill ' + (stage.includes('Cerrado') || stage.includes('Auditoría') ? 'status-completed' : (stage.includes('Propuesta') ? 'status-pending' : 'status-review'));
            openModal('modalClientDetail');
        }

        function handleCreateClient(e) {
            e.preventDefault();
            const name = document.getElementById('newClientNameInput').value.trim();
            const contact = document.getElementById('newClientContactInput').value.trim();
            const email = document.getElementById('newClientEmailInput').value.trim();
            const phone = document.getElementById('newClientPhoneInput').value.trim();
            const stage = document.getElementById('newClientStageSelect').value;

            crmClients.unshift({
                id: Date.now(),
                name: name,
                contact: contact,
                email: email,
                phone: phone,
                stage: stage,
                ltv: '$0.00 USD'
            });

            closeModal('modalNewClient');
            e.target.reset();
            renderCrmClients();
            showToast('Cliente Registrado', `${name} guardado en el CRM.`, 'success');
        }

        // Chat
        function switchPeerChat(name, sub, avatarUrl, el) {
            document.querySelectorAll('.channel-btn, .contact-item').forEach(i => i.classList.remove('active'));
            if (el) el.classList.add('active');

            document.getElementById('activeChatName').textContent = name;
            document.getElementById('activeChatSub').textContent = sub;
            document.getElementById('activeChatAvatar').src = avatarUrl;

            const chatBody = document.getElementById('msgConversationBody');
            chatBody.innerHTML = `
                <div class="peer-bubble incoming">
                    Has entrado a la conversación: <strong>${name}</strong> (${sub}).
                </div>
            `;
        }

        function sendChatMessage(e) {
            e.preventDefault();
            const box = document.getElementById('msgInputBox');
            const text = box.value.trim();
            if (!text) return;

            const chatBody = document.getElementById('msgConversationBody');
            chatBody.innerHTML += `<div class="peer-bubble outgoing">${text}</div>`;
            box.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            setTimeout(() => {
                chatBody.innerHTML += `<div class="peer-bubble incoming">Enterado. Me encargo de actualizar la gestión en el CRM.</div>`;
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 800);
        }

        function filterMsgContacts(val) {
            // simple filter for contacts
        }

        // Tema: el cajón propio se retiró; todo pasa por el panel global de
        // nexora-common.js. Se conservan los nombres por si algo más los llama.
        function openThemeDrawer() { openCustomizationDrawer(); }
        function closeThemeDrawer() { closeCustomizationDrawer(); }
        function setThemeMode(isDark) { setThemeModeDirect(isDark); }
        function setAccentColor(hex) { NexoraTheme.setColors({ accent: hex }); }

        function openProfileModal() {
            showToast('Perfil', 'Elena Valenzuela | Administradora General (ID #ADM-902)', 'info');
        }

        // ==========================================
        // COLLAPSIBLE SIDEBAR & ACCORDION SYSTEM
        // (Inspirado en Econt-JFast LayoutAuthenticated & menuAside)
        // ==========================================

        function closeMobileSidebar() {
            const sidebar = document.getElementById('crmSidebar');
            if (sidebar) sidebar.classList.remove('mobile-open');
        }

        function toggleSidebarCollapse() {
            const sidebar = document.getElementById('crmSidebar');
            if (!sidebar) return;

            // En móvil la barra vive fuera de pantalla: el botón la abre completa
            if (window.innerWidth <= 950) {
                sidebar.classList.remove('collapsed');
                document.body.classList.remove('sidebar-collapsed');
                sidebar.classList.toggle('mobile-open');
                return;
            }

            const isCollapsed = sidebar.classList.toggle('collapsed');
            document.body.classList.toggle('sidebar-collapsed', isCollapsed);

            const iconSvg = document.getElementById('collapseIconSvg');
            if (iconSvg) {
                iconSvg.innerHTML = isCollapsed
                    ? '<path d="m9 18 6-6-6-6"/>'
                    : '<path d="m15 18-6-6 6-6"/>';
            }

            const collapseBtn = document.getElementById('sidebarCollapseBtn');
            if (collapseBtn) {
                collapseBtn.setAttribute('title', isCollapsed ? 'Expandir menú lateral' : 'Colapsar menú lateral');
                collapseBtn.setAttribute('aria-label', collapseBtn.getAttribute('title'));
            }

            showToast(
                'Menú Lateral',
                isCollapsed ? 'Modo compacto (iconos) activado' : 'Modo expandido completo activado',
                'info'
            );
        }

        function toggleNavGroup(btn) {
            const group = btn.closest('.nav-group-accordion');
            if (!group) return;
            const items = group.querySelector('.nav-group-items');
            const isOpen = group.classList.toggle('open');
            btn.classList.toggle('open', isOpen);
            if (items) {
                items.classList.toggle('open', isOpen);
            }
        }

        function filterSidebarModules(query) {
            const term = (query || '').toLowerCase().trim();
            const groups = document.querySelectorAll('.nav-group-accordion');
            
            groups.forEach(group => {
                const links = group.querySelectorAll('.nav-sublink');
                let groupHasMatch = false;

                links.forEach(link => {
                    const text = link.textContent.toLowerCase();
                    if (!term || text.includes(term)) {
                        link.style.display = 'flex';
                        groupHasMatch = true;
                    } else {
                        link.style.display = 'none';
                    }
                });

                const header = group.querySelector('.nav-group-header');
                const items = group.querySelector('.nav-group-items');

                if (term) {
                    if (groupHasMatch) {
                        group.style.display = 'block';
                        group.classList.add('open');
                        if (header) header.classList.add('open');
                        if (items) items.classList.add('open');
                    } else {
                        group.style.display = 'none';
                    }
                } else {
                    group.style.display = 'block';
                }
            });
        }

        // ==========================================
        // EMPRESA SELECTOR CONTEXT SWITCHER (E-Cont)
        // ==========================================

        function toggleEmpresaDropdown() {
            const dropdown = document.getElementById('crmEmpresaDropdown');
            if (dropdown) {
                dropdown.classList.toggle('open');
            }
        }

        function selectEmpresa(name, branch, rfc) {
            const label = document.getElementById('activeEmpresaLabel');
            const badge = document.getElementById('activeSucursalBadge');
            if (label) label.textContent = name;
            if (badge) badge.textContent = branch;
            document.querySelectorAll('#empresasDropdownList .empresa-option').forEach(b => {
                b.classList.toggle('active', b.dataset.rfc === rfc);
            });

            const dropdown = document.getElementById('crmEmpresaDropdown');
            if (dropdown) dropdown.classList.remove('open');

            showToast('Contexto de Empresa', `Cambiado a: ${name} (${rfc})`, 'success');
        }

        function filterEmpresasList(query) {
            const term = (query || '').toLowerCase().trim();
            const list = document.getElementById('empresasDropdownList');
            if (!list) return;
            const buttons = list.querySelectorAll('button');
            buttons.forEach(btn => {
                const text = btn.textContent.toLowerCase();
                btn.style.display = (!term || text.includes(term)) ? 'flex' : 'none';
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const wrap = document.getElementById('crmEmpresaSelectorWrap');
            const dropdown = document.getElementById('crmEmpresaDropdown');
            if (wrap && dropdown && !wrap.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });

        // ==========================================
        // ALERTAS DRAWER (E-Cont AlertasDrawer)
        // ==========================================

        function toggleAlertasDrawer() {
            const drawer = document.getElementById('crmAlertasDrawer');
            const overlay = document.getElementById('crmAlertasOverlay');
            if (drawer && overlay) {
                drawer.classList.toggle('open');
                overlay.classList.toggle('open');
            }
        }

        function filterAlerts(category, btn) {
            const container = document.getElementById('alertasListContainer');
            if (!container) return;

            document.querySelectorAll('.alert-filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const cards = container.querySelectorAll('.alert-item-card');
            cards.forEach(card => {
                const cardCat = card.getAttribute('data-category');
                if (category === 'todas' || cardCat === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function markAllAlertsRead() {
            const container = document.getElementById('alertasListContainer');
            if (!container) return;
            const cards = container.querySelectorAll('.alert-item-card');
            cards.forEach(card => card.classList.remove('is-danger', 'is-warning'));
            const badge = document.getElementById('headerAlertsBadge');
            if (badge) badge.style.display = 'none';
            const countAll = document.getElementById('alertCountAll');
            if (countAll) countAll.textContent = '0';
            showToast('Alertas', 'Todas las alertas han sido marcadas como leídas', 'success');
        }

        function updateAlertsBadge() {
            const container = document.getElementById('alertasListContainer');
            if (!container) return;
            const remaining = container.querySelectorAll('.alert-item-card').length;
            const badge = document.getElementById('headerAlertsBadge');
            const countAll = document.getElementById('alertCountAll');
            if (countAll) countAll.textContent = remaining;
            if (badge) {
                if (remaining > 0) {
                    badge.style.display = 'flex';
                    badge.textContent = remaining;
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // ==========================================
        // CONTROL DE COMPRAS & ERP ACTIONS
        // ==========================================

        function openModalControlCompras() {
            openModal('modalControlCompras');
        }

        function handleRegistrarCompra(e) {
            e.preventDefault();
            const prov = document.getElementById('compraProveedorSelect').value;
            const folio = document.getElementById('compraFolioInput').value.trim();
            const monto = parseFloat(document.getElementById('compraMontoInput').value) || 0;
            const moneda = document.getElementById('compraMonedaSelect').value;
            const concepto = document.getElementById('compraConceptoInput').value.trim();

            const recentList = document.getElementById('comprasRecentList');
            if (recentList) {
                const provShort = prov.split('(')[0].trim();
                const newRow = document.createElement('div');
                newRow.className = 'compra-row is-new';
                newRow.innerHTML = `
                    <span style="font-weight: 600;">${provShort}</span>
                    <code>${folio}</code>
                    <span class="mono-amount">$${monto.toLocaleString()} ${moneda}</span>
                    <span><span class="badge-status status-completed">Registrada</span></span>
                `;
                recentList.prepend(newRow);
            }

            closeModal('modalControlCompras');
            e.target.reset();
            showToast('Compra Registrada', `Orden ${folio} vinculada a contabilidad electrónica.`, 'success');
        }

        function scrollAndHighlightWidget(widgetId) {
            switchCrmView('dashboard');
            setTimeout(() => {
                const el = document.getElementById(widgetId);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    el.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
                    el.style.boxShadow = '0 0 0 2px rgb(var(--c-accent) / 0.7), 0 0 40px -6px rgb(var(--c-accent) / 0.55)';
                    setTimeout(() => {
                        el.style.boxShadow = '';
                    }, 1800);
                }
            }, 100);
        }

        // Init
        renderCrmClients();
    </script>
</body>
</html>
