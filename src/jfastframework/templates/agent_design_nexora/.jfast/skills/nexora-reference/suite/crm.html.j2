<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JFast CRM & ERP | Plataforma Empresarial Avanzada</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
    
    <!-- Unified CSS -->
    <link rel="stylesheet" href="assets/css/nexora.css">

    <style>
        /* ==================================================================
           CRM — Liquid Glass
           Barra lateral de vidrio + isla superior flotante sobre el estudio
           negro. Todo sale de los tokens de nexora.css (claro = html.nx-light).
           ================================================================== */
        #crm-app-layout {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Barra lateral de vidrio ---------- */
        aside.crm-sidebar {
            width: var(--sidebar-width);
            background: var(--bg-sidebar);
            backdrop-filter: blur(28px) saturate(170%);
            -webkit-backdrop-filter: blur(28px) saturate(170%);
            border-right: 1px solid var(--card-border);
            box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.03), 18px 0 50px -30px rgba(0, 0, 0, 0.6);
            color: var(--text-main);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: width 0.28s var(--ease-out), left 0.3s var(--ease-out);
        }

        html.nx-light aside.crm-sidebar {
            box-shadow: inset -1px 0 0 #fff, 18px 0 40px -30px rgba(28, 35, 60, 0.18);
        }

        aside.crm-sidebar.collapsed { width: 72px; }

        body.sidebar-collapsed main.crm-main-wrapper {
            margin-left: 72px;
            width: calc(100% - 72px);
        }

        .crm-sidebar-brand {
            height: 76px;
            display: flex;
            align-items: center;
            padding: 0 22px;
            flex-shrink: 0;
            position: relative;
        }

        .crm-brand-link {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            overflow: hidden;
        }

        .crm-brand-link .nx-logo { font-size: 1.9rem !important; }
        .crm-brand-link:hover .nx-logo { transform: scale(1.03); }

        .crm-brand-sub {
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--text-sub);
            margin-top: 3px;
            white-space: nowrap;
        }

        .crm-brand-mark {
            display: none;
            font-family: var(--font-script);
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
            color: var(--text-main);
        }

        .crm-brand-mark::after {
            content: "";
            display: inline-block;
            width: 5px;
            height: 5px;
            margin-left: 2px;
            border-radius: 50%;
            background: rgb(var(--c-accent));
            box-shadow: 0 0 10px rgb(var(--c-accent) / 0.8);
        }

        /* Botón redondo que cabalga el borde de la barra */
        .btn-sidebar-collapse {
            position: absolute;
            top: 24px;
            right: -14px;
            width: 28px;
            height: 28px;
            padding: 0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-solid);
            border: 1px solid var(--badge-border);
            color: var(--text-dim);
            box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.5), inset 0 1px 1px var(--card-specular);
            cursor: pointer;
            z-index: 2;
            transition: transform 0.2s var(--ease-out), color 0.2s ease, border-color 0.2s ease;
        }

        .btn-sidebar-collapse svg { width: 14px; height: 14px; }

        .btn-sidebar-collapse:hover {
            color: rgb(var(--c-accent));
            border-color: var(--card-hover-border);
            transform: scale(1.08);
        }

        /* Buscador de módulos */
        .sidebar-search-box { padding: 2px 16px 8px; }

        .sidebar-search-field { position: relative; }

        .sidebar-search-field svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            color: var(--text-sub);
            pointer-events: none;
        }

        .sidebar-search-input {
            width: 100%;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            border-radius: 9999px;
            padding: 9px 14px 9px 34px;
            color: var(--text-main);
            font-size: 0.8rem;
            outline: none;
            box-shadow: inset 0 1px 1px var(--card-specular);
            transition: var(--transition-fast);
        }

        .sidebar-search-input::placeholder { color: var(--text-sub); }

        .sidebar-search-input:focus {
            border-color: rgb(var(--c-accent) / 0.55);
            box-shadow: 0 0 0 4px rgb(var(--c-accent) / 0.12);
        }

        .crm-sidebar-menu {
            padding: 6px 12px 12px;
            overflow-y: auto;
            overflow-x: hidden;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .nav-group-accordion { margin-bottom: 6px; }

        /* Categorías: etiquetas mono tenues */
        .nav-group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 12px 12px 6px;
            background: transparent;
            border: none;
            color: var(--text-sub);
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            cursor: pointer;
            border-radius: var(--radius-sm);
            transition: color 0.18s ease;
        }

        .nav-group-header:hover { color: var(--text-dim); }

        .nav-chevron {
            width: 12px;
            height: 12px;
            min-width: 12px;
            transition: transform 0.22s var(--ease-out), color 0.2s ease;
        }

        .nav-group-header.open .nav-chevron { transform: rotate(180deg); }

        .nav-group-items {
            display: none;
            flex-direction: column;
            gap: 2px;
        }

        .nav-group-items.open { display: flex; }

        .nav-sublink {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 8px 12px;
            color: var(--text-dim);
            border-radius: 9999px;
            font-size: 0.83rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            background: transparent;
            width: 100%;
            text-align: left;
            white-space: nowrap;
            transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        .nav-sublink > svg:first-child { width: 17px; height: 17px; min-width: 17px; opacity: 0.85; transition: color 0.2s ease; }

        .nav-sublink:hover {
            background: var(--pill-bg);
            color: var(--text-main);
        }

        .nav-sublink.active {
            background: var(--pill-bg);
            border-color: var(--badge-border);
            color: var(--text-main);
            box-shadow: inset 0 1px 1px var(--card-specular);
        }

        .nav-sublink.active > svg:first-child {
            color: rgb(var(--c-accent));
            opacity: 1;
            filter: drop-shadow(0 0 6px rgb(var(--c-accent) / 0.55));
        }

        .nav-sublink .sidebar-text-hide { overflow: hidden; text-overflow: ellipsis; }

        .nav-ext { width: 12px; height: 12px; margin-left: auto; opacity: 0.45; }

        .nav-badge-count {
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 9999px;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            color: var(--text-dim);
        }

        .nav-badge-count.accent {
            background: rgb(var(--c-accent) / 0.14);
            border-color: rgb(var(--c-accent) / 0.3);
            color: rgb(var(--c-glow));
        }

        html.nx-light .nav-badge-count.accent { color: rgb(var(--c-accent)); }

        .nav-badge-count.danger {
            background: var(--danger-light);
            border-color: var(--danger-border);
            color: var(--danger);
        }

        /* Tarjeta de usuario al pie */
        .crm-sidebar-footer {
            margin: 10px 12px 14px;
            padding: 10px 12px;
            border-radius: 18px;
            border: 1px solid var(--card-border);
            background: var(--pill-bg);
            box-shadow: inset 0 1px 1px var(--card-specular);
            display: flex;
            align-items: center;
            gap: 11px;
            cursor: pointer;
            flex-shrink: 0;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .crm-sidebar-footer:hover {
            background: var(--pill-hover);
            border-color: var(--card-hover-border);
        }

        .user-avatar-wrap { position: relative; flex-shrink: 0; }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid rgb(var(--c-accent) / 0.7);
            box-shadow: 0 0 14px rgb(var(--c-accent) / 0.35);
            object-fit: cover;
            display: block;
        }

        .user-status-dot-online {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--success);
            border: 2px solid var(--card-solid);
        }

        .user-details-wrap { overflow: hidden; flex: 1; min-width: 0; }
        .user-name { font-size: 0.84rem; font-weight: 700; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-role { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--text-dim); white-space: nowrap; }
        .user-more { width: 16px; height: 16px; color: var(--text-sub); }

        /* ---------- Estado colapsado (solo iconos) ---------- */
        aside.crm-sidebar.collapsed .sidebar-text-hide,
        aside.crm-sidebar.collapsed .nav-badge-count,
        aside.crm-sidebar.collapsed .nav-ext,
        aside.crm-sidebar.collapsed .sidebar-search-box,
        aside.crm-sidebar.collapsed .brand-title-wrap,
        aside.crm-sidebar.collapsed .user-details-wrap,
        aside.crm-sidebar.collapsed .user-more {
            display: none !important;
        }

        aside.crm-sidebar.collapsed .crm-brand-mark { display: inline-flex; align-items: flex-end; }
        aside.crm-sidebar.collapsed .crm-sidebar-brand { justify-content: center; padding: 0; }
        aside.crm-sidebar.collapsed .crm-sidebar-menu { padding: 6px 10px 12px; }

        aside.crm-sidebar.collapsed .nav-group-header {
            height: 1px;
            padding: 0;
            margin: 10px 8px;
            background: var(--card-border);
            pointer-events: none;
        }

        aside.crm-sidebar.collapsed .nav-group-header > * { display: none; }
        aside.crm-sidebar.collapsed .nav-group-accordion:first-child .nav-group-header { margin-top: 2px; }
        aside.crm-sidebar.collapsed .nav-group-items { display: flex; }

        aside.crm-sidebar.collapsed .nav-sublink {
            justify-content: center;
            padding: 0;
            width: 44px;
            height: 40px;
            margin: 0 auto;
        }

        aside.crm-sidebar.collapsed .crm-sidebar-footer {
            justify-content: center;
            padding: 8px 0;
            margin: 10px 10px 14px;
        }

        /* ---------- Contenido principal ---------- */
        main.crm-main-wrapper {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            min-width: 0;
            width: calc(100% - var(--sidebar-width));
            transition: margin-left 0.28s var(--ease-out), width 0.28s var(--ease-out);
        }

        /* Isla superior de vidrio */
        .crm-top-header {
            position: sticky;
            top: 14px;
            z-index: 90;
            height: var(--header-height);
            margin: 14px 28px 0;
            padding: 0 10px 0 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-radius: 9999px;
            background: var(--nav-bg);
            backdrop-filter: blur(24px) saturate(190%);
            -webkit-backdrop-filter: blur(24px) saturate(190%);
            border: 1px solid var(--nav-border);
            box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.35), inset 0 1px 1px var(--card-specular);
        }

        html.nx-light .crm-top-header {
            box-shadow: 0 16px 36px -12px rgba(28, 35, 60, 0.14), inset 0 1px 1px #fff;
        }

        .crm-header-left,
        .crm-header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .crm-header-right { flex-shrink: 0; }

        .crm-header-btn-new { padding: 9px 18px; font-size: 0.8rem; }

        .header-alert-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: 9999px;
            background: var(--danger);
            color: #fff;
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--card-solid);
            box-shadow: 0 0 10px rgba(255, 77, 94, 0.55);
        }

        /* Selector de empresa */
        .empresa-selector-wrap { position: relative; min-width: 0; }

        .empresa-selector-btn {
            display: flex;
            align-items: center;
            gap: 9px;
            max-width: 100%;
            padding: 7px 12px 7px 14px;
            border-radius: 9999px;
            border: 1px solid var(--badge-border);
            background: var(--pill-bg);
            box-shadow: inset 0 1px 1px var(--card-specular);
            color: var(--text-main);
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .empresa-selector-btn:hover {
            background: var(--pill-hover);
            border-color: var(--card-hover-border);
        }

        .empresa-selector-btn .empresa-icon { color: rgb(var(--c-accent)); }
        .empresa-selector-btn .empresa-caret { width: 13px; height: 13px; color: var(--text-dim); }

        #activeEmpresaLabel { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .empresa-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            left: 0;
            width: 340px;
            background: var(--card-solid);
            border: 1px solid var(--nav-border);
            border-radius: 22px;
            box-shadow: 0 30px 70px -18px rgba(0, 0, 0, 0.7), inset 0 1px 1.5px var(--card-specular);
            display: none;
            flex-direction: column;
            gap: 10px;
            z-index: 200;
            padding: 14px;
        }

        html.nx-light .empresa-dropdown { box-shadow: 0 30px 60px -18px rgba(28, 35, 60, 0.22), inset 0 1px 1.5px #fff; }

        .empresa-dropdown.open { display: flex; animation: nxPop 0.22s var(--ease-out); }

        @keyframes nxPop {
            from { opacity: 0; transform: translateY(-6px) scale(0.98); }
            to { opacity: 1; transform: none; }
        }

        .empresa-dropdown .form-input { padding: 8px 14px; font-size: 0.78rem; border-radius: 9999px; }

        #empresasDropdownList {
            display: flex;
            flex-direction: column;
            gap: 4px;
            max-height: 220px;
            overflow-y: auto;
        }

        .empresa-option {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 10px 12px;
            border-radius: 14px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-main);
            text-align: left;
            cursor: pointer;
            transition: background 0.18s ease, border-color 0.18s ease;
        }

        .empresa-option:hover { background: var(--pill-bg); }

        .empresa-option.active {
            background: rgb(var(--c-accent) / 0.08);
            border-color: rgb(var(--c-accent) / 0.25);
        }

        .empresa-option-name { font-weight: 700; font-size: 0.82rem; }
        .empresa-option-meta { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-dim); margin-top: 2px; }

        .empresa-option-check {
            width: 16px;
            height: 16px;
            margin-left: auto;
            color: rgb(var(--c-accent));
            opacity: 0;
        }

        .empresa-option.active .empresa-option-check { opacity: 1; }

        .crm-content-area {
            padding: 30px 28px 48px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 24px;
            min-width: 0;
        }

        /* Vistas */
        .crm-view-section {
            display: none;
            flex-direction: column;
            gap: 22px;
            min-width: 0;
            animation: viewAppear 0.35s var(--ease-out) forwards;
        }

        .crm-view-section.active { display: flex; }

        .crm-view-section .page-header-row { margin-bottom: 4px; }
        .crm-view-section .page-title .nx-eyebrow { margin-bottom: 10px; }

        @keyframes viewAppear {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .panel-title { font-size: 1.08rem; font-weight: 800; letter-spacing: -0.03em; }
        .panel-sub { font-size: 0.8rem; color: var(--text-dim); margin-top: 3px; }

        .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .mono-amount { font-family: var(--font-mono); font-weight: 700; letter-spacing: -0.02em; }

        /* ---------- KPIs ---------- */
        .kpi-grid-crm {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .kpi-card-crm {
            background: var(--card-bg);
            backdrop-filter: blur(28px) saturate(170%);
            -webkit-backdrop-filter: blur(28px) saturate(170%);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 20px 20px 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            box-shadow: var(--card-shadow), inset 0 1px 1.5px var(--card-specular);
            transition: border-color 0.25s ease, transform 0.25s var(--ease-out);
            position: relative;
            overflow: hidden;
        }

        html.nx-light .kpi-card-crm { box-shadow: var(--card-shadow), inset 0 1px 2px #fff; }

        /* Luz de relleno del acento en la esquina */
        .kpi-card-crm::before {
            content: "";
            position: absolute;
            top: -60px;
            right: -60px;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle, rgb(var(--c-accent) / 0.16), transparent 70%);
            pointer-events: none;
            transition: opacity 0.3s ease;
            opacity: 0.7;
        }

        .kpi-card-crm:hover {
            transform: translateY(-3px);
            border-color: var(--card-hover-border);
        }

        .kpi-card-crm:hover::before { opacity: 1; }
        .kpi-card-crm.is-link { cursor: pointer; }

        .kpi-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .kpi-label {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
        }

        .kpi-value {
            font-family: var(--font-mono);
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.1;
            color: var(--text-main);
        }

        .kpi-value small {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--text-sub);
            margin-left: 4px;
        }

        .kpi-foot { font-size: 0.76rem; color: var(--text-dim); }

        .kpi-card-crm .badge-status { font-family: var(--font-mono); font-size: 0.64rem; }

        /* ---------- Facturación + vencimientos ---------- */
        .fact-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
            gap: 16px;
            border-radius: var(--radius-lg);
        }

        .fact-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 10px;
            font-size: 0.84rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .fact-bar {
            width: 100%;
            height: 12px;
            padding: 2px;
            background: var(--bg-muted);
            border: 1px solid var(--card-border);
            border-radius: 9999px;
            overflow: hidden;
            margin-bottom: 18px;
        }

        .fact-bar > div {
            height: 100%;
            border-radius: 9999px;
        }

        .fact-bar .fill-accent {
            background: linear-gradient(90deg, rgb(var(--c-accent-deep)), rgb(var(--c-accent)) 55%, rgb(var(--c-glow)));
            box-shadow: 0 0 14px rgb(var(--c-accent) / 0.55);
        }

        .fact-bar .fill-success {
            background: linear-gradient(90deg, color-mix(in srgb, var(--success) 45%, transparent), var(--success));
            box-shadow: 0 0 14px color-mix(in srgb, var(--success) 45%, transparent);
        }

        .fact-foot {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
            padding-top: 14px;
            border-top: 1px solid var(--card-border);
            font-size: 0.78rem;
            color: var(--text-dim);
        }

        .fact-foot strong { font-family: var(--font-mono); }

        .venc-list { display: flex; flex-direction: column; gap: 8px; }

        .venc-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 11px 12px;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            font-size: 0.8rem;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .venc-item:hover { border-color: var(--card-hover-border); background: var(--pill-hover); }
        .venc-title { font-weight: 700; }
        .venc-meta { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-dim); margin-top: 2px; }
        .venc-item .badge-status { font-family: var(--font-mono); font-size: 0.64rem; }

        /* ---------- Tablas dentro de paneles ---------- */
        .card-panel .table-responsive,
        .liquid-panel .table-responsive {
            background: transparent;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            box-shadow: none;
            border-radius: 16px;
        }

        .card-panel .erp-table th,
        .card-panel .erp-table td { padding-left: 14px; padding-right: 14px; }

        .cell-title { font-weight: 700; color: var(--text-main); }
        .cell-sub { font-size: 0.74rem; color: var(--text-dim); margin-top: 2px; }
        .cell-amount { font-family: var(--font-mono); font-weight: 700; font-size: 0.86rem; color: var(--text-main); }
        .erp-table .badge-status,
        .erp-table .stage-pill { font-size: 0.68rem; }

        #crmClientsTableBody .company-cell { min-width: 230px; }
        .company-name { font-weight: 700; color: var(--text-main); font-size: 0.88rem; line-height: 1.25; }

        .company-rfc {
            font-family: var(--font-mono);
            font-size: 0.66rem;
            color: var(--text-dim);
            margin-top: 3px;
        }

        .contact-pill,
        .email-cell,
        .phone-cell {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .contact-pill { font-weight: 600; font-size: 0.84rem; }
        .contact-pill svg { color: var(--text-dim); }

        .email-cell {
            font-family: var(--font-mono);
            font-size: 0.76rem;
            color: var(--text-dim);
            transition: color 0.15s ease;
        }

        .email-cell:hover { color: rgb(var(--c-glow)); }
        html.nx-light .email-cell:hover { color: rgb(var(--c-accent)); }

        .phone-cell { font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-main); }
        .phone-cell svg, .email-cell svg { opacity: 0.6; }

        .stage-pill {
            border: 1px solid var(--badge-border);
            background: var(--pill-bg);
            white-space: nowrap;
        }

        .status-review {
            background: var(--info-light);
            color: var(--info);
            border-color: var(--info-border);
        }

        .btn-table-ficha { white-space: nowrap; }
        .erp-table td:last-child { white-space: nowrap; }

        .search-pill { position: relative; max-width: 400px; width: 100%; }

        .search-pill svg {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-dim);
            pointer-events: none;
        }

        .search-pill .form-input { padding-left: 40px; border-radius: 9999px; }

        /* ---------- Pipeline (kanban) ---------- */
        .pipeline-board {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            padding-bottom: 6px;
        }

        .pipeline-col {
            background: var(--card-bg);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border: 1px solid var(--card-border);
            box-shadow: var(--card-shadow), inset 0 1px 1.5px var(--card-specular);
            border-radius: var(--radius-lg);
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 460px;
            min-width: 0;
        }

        html.nx-light .pipeline-col { box-shadow: var(--card-shadow), inset 0 1px 2px #fff; }

        .pipeline-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            padding: 2px 4px 12px;
            margin-bottom: 2px;
            border-bottom: 1px solid var(--card-border);
        }

        .pipeline-stage {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
            min-width: 0;
        }

        .pipeline-stage::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
            background: var(--stage-color, var(--text-sub));
            box-shadow: 0 0 10px var(--stage-color, transparent);
        }

        .pipeline-count {
            font-family: var(--font-mono);
            font-size: 0.62rem;
            padding: 1px 7px;
            border-radius: 9999px;
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
            color: var(--text-main);
            letter-spacing: 0;
        }

        .pipeline-total { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--text-main); }

        .pipeline-col.stage-1 { --stage-color: var(--text-dim); }
        .pipeline-col.stage-2 { --stage-color: rgb(var(--c-glow)); }
        .pipeline-col.stage-3 { --stage-color: rgb(var(--c-accent)); }
        .pipeline-col.stage-won { --stage-color: var(--success); }
        .pipeline-col.stage-won .pipeline-stage { color: var(--success); }

        .deal-card {
            position: relative;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 13px 14px;
            box-shadow: inset 0 1px 1px var(--card-specular);
            cursor: grab;
            transition: transform 0.22s var(--ease-out), border-color 0.2s ease, background 0.2s ease, box-shadow 0.22s ease;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .deal-card:hover {
            transform: translateY(-2px);
            background: var(--pill-hover);
            border-color: var(--card-hover-border);
            box-shadow: 0 14px 28px -14px rgb(var(--c-accent) / 0.45), inset 0 1px 1px var(--card-specular);
        }

        .deal-card.is-won { border-color: var(--success-border); }
        .deal-card.is-won::before {
            content: "";
            position: absolute;
            left: -1px;
            top: 14px;
            bottom: 14px;
            width: 3px;
            border-radius: 3px;
            background: var(--success);
            box-shadow: 0 0 10px var(--success);
        }

        .deal-client { font-weight: 700; font-size: 0.86rem; letter-spacing: -0.01em; }
        .deal-desc { font-size: 0.76rem; color: var(--text-dim); }
        .deal-amount { font-family: var(--font-mono); font-weight: 700; color: rgb(var(--c-glow)); font-size: 0.86rem; margin-top: 2px; }
        html.nx-light .deal-amount { color: rgb(var(--c-accent)); }
        .deal-card.is-won .deal-amount { color: var(--success); }

        /* ---------- Mensajería ---------- */
        .messaging-layout {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            overflow: hidden;
            height: calc(100vh - 230px);
            min-height: 540px;
        }

        .msg-sidebar {
            border-right: 1px solid var(--card-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .msg-sidebar-header { padding: 14px; border-bottom: 1px solid var(--card-border); }
        .msg-sidebar-header .form-input { font-size: 0.8rem; padding: 8px 14px; border-radius: 9999px; }

        .msg-section { padding: 12px 12px; }
        .msg-section + .msg-section { border-top: 1px solid var(--card-border); }
        .msg-section.is-scroll { flex: 1; overflow-y: auto; }

        .msg-section-label {
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--text-sub);
            margin: 0 6px 8px;
        }

        .channel-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 8px 12px;
            border-radius: 9999px;
            background: none;
            border: 1px solid transparent;
            color: var(--text-dim);
            font-size: 0.83rem;
            font-weight: 600;
            cursor: pointer;
            text-align: left;
            transition: var(--transition-fast);
        }

        .channel-btn span { font-family: var(--font-mono); color: var(--text-sub); }

        .channel-btn:hover { background: var(--pill-bg); color: var(--text-main); }

        .channel-btn.active {
            background: var(--pill-bg);
            border-color: var(--badge-border);
            color: var(--text-main);
            box-shadow: inset 0 1px 1px var(--card-specular);
        }

        .channel-btn.active span { color: rgb(var(--c-accent)); }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 9px 10px;
            border-radius: 16px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .contact-item img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid var(--badge-border); }
        .contact-item:hover { background: var(--pill-bg); }

        .contact-item.active {
            background: rgb(var(--c-accent) / 0.08);
            border-color: rgb(var(--c-accent) / 0.22);
        }

        .contact-name { font-size: 0.84rem; font-weight: 700; }
        .contact-preview { font-size: 0.74rem; color: var(--text-dim); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

        .msg-main-chat {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .msg-chat-head {
            padding: 14px 20px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .msg-chat-head img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid var(--badge-border); }
        .msg-chat-name { font-weight: 800; font-size: 0.98rem; letter-spacing: -0.02em; }
        .msg-chat-sub { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-dim); }

        .msg-conversation-body {
            flex: 1;
            padding: 22px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: var(--bg-muted);
        }

        .peer-bubble {
            max-width: 75%;
            padding: 11px 16px;
            border-radius: 20px;
            font-size: 0.86rem;
            line-height: 1.5;
            animation: bubbleFadeIn 0.25s var(--ease-out);
        }

        @keyframes bubbleFadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .peer-bubble.incoming {
            align-self: flex-start;
            background: var(--card-bg);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            box-shadow: inset 0 1px 1px var(--card-specular);
            border-bottom-left-radius: 6px;
        }

        .peer-bubble.outgoing {
            align-self: flex-end;
            background: linear-gradient(135deg, color-mix(in srgb, rgb(var(--c-glow)) 40%, rgb(var(--c-accent))), rgb(var(--c-accent)) 45%, color-mix(in srgb, rgb(var(--c-accent)) 70%, rgb(var(--c-accent-deep))));
            color: rgb(var(--c-on-accent));
            box-shadow: 0 10px 24px -10px rgb(var(--c-accent) / 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.35);
            border-bottom-right-radius: 6px;
        }

        .msg-input-bar {
            padding: 12px 14px;
            border-top: 1px solid var(--card-border);
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .msg-input-bar input {
            flex: 1;
            min-width: 0;
            padding: 11px 18px;
            border-radius: 9999px;
            border: 1px solid var(--card-border);
            background: var(--bg-input);
            color: var(--text-main);
            font-size: 0.86rem;
            outline: none;
            transition: var(--transition-fast);
        }

        .msg-input-bar input::placeholder { color: var(--text-light); }

        .msg-input-bar input:focus {
            border-color: rgb(var(--c-accent) / 0.6);
            box-shadow: 0 0 0 4px rgb(var(--c-accent) / 0.14);
        }

        /* ---------- Modales ---------- */
        .modal-title-row { display: flex; align-items: center; gap: 12px; min-width: 0; }
        .modal-sub { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-dim); letter-spacing: 0.04em; }

        .modal-orb {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .modal-orb svg { width: 18px; height: 18px; }

        .modal-orb.liquid-orb-accent {
            box-shadow: inset -4px -4px 10px rgba(0, 0, 0, 0.55), inset 3px 3px 7px rgba(255, 255, 255, 0.45), 0 8px 18px -6px rgb(var(--c-accent) / 0.6);
        }

        .detail-box {
            background: var(--bg-muted);
            border: 1px solid var(--card-border);
            padding: 6px 16px;
            border-radius: 18px;
            display: flex;
            flex-direction: column;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            font-size: 0.86rem;
        }

        .detail-row + .detail-row { border-top: 1px solid var(--card-border); }
        .detail-row > span:first-child { color: var(--text-dim); font-size: 0.78rem; }

        .detail-email { font-family: var(--font-mono); font-size: 0.8rem; color: rgb(var(--c-glow)); word-break: break-all; text-align: right; }
        html.nx-light .detail-email { color: rgb(var(--c-accent)); }
        .detail-ltv { font-family: var(--font-mono); color: rgb(var(--c-accent)); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.03em; }

        .info-note {
            padding: 12px 14px;
            border-radius: 14px;
            background: var(--info-light);
            border: 1px solid var(--info-border);
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .info-note svg { flex-shrink: 0; margin-top: 2px; color: var(--info); }
        .info-note p { font-size: 0.78rem; color: var(--text-dim); line-height: 1.5; }

        .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
        .form-grid-2 .form-group, .form-grid-3 .form-group { margin-bottom: 0; }
        .modal-body .form-group { margin-bottom: 0; }

        .section-label {
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
            margin-bottom: 8px;
        }

        .compras-table {
            border: 1px solid var(--card-border);
            border-radius: 16px;
            overflow: hidden;
            font-size: 0.78rem;
        }

        .compra-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 8px;
            padding: 10px 14px;
            align-items: center;
        }

        .compra-row + .compra-row,
        #comprasRecentList .compra-row { border-top: 1px solid var(--card-border); }

        .compra-row.is-head {
            background: var(--bg-muted);
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-dim);
            padding: 9px 14px;
        }

        .compra-row.is-new { background: rgb(var(--c-accent) / 0.06); }
        .compra-row code { font-size: 0.72rem; color: var(--text-dim); }
        .compra-row .mono-amount { font-size: 0.76rem; }
        .compra-row .badge-status { font-size: 0.62rem; }

        .modal-footer .btn-live-demo { justify-content: center; font-size: 0.85rem; padding: 10px 20px; }

        /* ---------- Cajón de alertas (panel de vidrio flotante) ---------- */
        .alertas-drawer {
            position: fixed;
            top: 14px;
            right: 14px;
            bottom: 14px;
            width: 400px;
            max-width: calc(100vw - 28px);
            background: var(--card-bg);
            backdrop-filter: blur(36px) saturate(180%);
            -webkit-backdrop-filter: blur(36px) saturate(180%);
            border: 1px solid var(--nav-border);
            border-radius: var(--radius-xl);
            box-shadow: 0 40px 90px -20px rgba(0, 0, 0, 0.7), inset 0 1px 1.5px var(--card-specular);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: translateX(calc(100% + 40px));
            visibility: hidden;
            transition: transform 0.38s var(--ease-out), visibility 0.38s;
        }

        html.nx-light .alertas-drawer { box-shadow: 0 40px 80px -20px rgba(28, 35, 60, 0.25), inset 0 1px 2px #fff; }

        .alertas-drawer.open { transform: none; visibility: visible; }

        .alertas-drawer-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 2, 4, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 999;
            display: none;
        }

        html.nx-light .alertas-drawer-overlay { background: rgba(240, 242, 248, 0.5); }

        .alertas-drawer-overlay.open { display: block; }

        .alertas-head {
            padding: 18px 18px 16px 20px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .alertas-head-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--danger-light);
            border: 1px solid var(--danger-border);
            color: var(--danger);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .alertas-toolbar {
            padding: 12px 18px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            background: var(--bg-muted);
        }

        .alertas-chips { display: flex; gap: 6px; flex-wrap: wrap; }

        .alert-chip {
            padding: 5px 11px;
            border-radius: 9999px;
            border: 1px solid var(--badge-border);
            background: var(--pill-bg);
            color: var(--text-dim);
            font-family: var(--font-mono);
            font-size: 0.64rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: var(--transition-fast);
        }

        .alert-chip:hover { color: var(--text-main); border-color: var(--card-hover-border); }

        .alert-chip.active {
            background: rgb(var(--c-accent));
            border-color: rgb(var(--c-accent));
            color: rgb(var(--c-on-accent));
            box-shadow: 0 4px 12px -2px rgb(var(--c-accent) / 0.5);
        }

        .alert-mark-read {
            background: none;
            border: none;
            color: rgb(var(--c-accent));
            font-family: var(--font-mono);
            font-size: 0.66rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }

        #alertasListContainer {
            padding: 16px 16px 20px;
            overflow-y: auto;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .alert-item-card {
            border: 1px solid var(--card-border);
            background: var(--pill-bg);
            box-shadow: inset 0 1px 1px var(--card-specular);
            border-radius: 18px;
            padding: 14px;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .alert-item-card.is-danger { border-color: var(--danger-border); background: color-mix(in srgb, var(--danger) 6%, transparent); }
        .alert-item-card.is-warning { border-color: var(--warning-border); background: color-mix(in srgb, var(--warning) 5%, transparent); }

        .alert-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
        .alert-top .badge-status { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.04em; }
        .alert-time { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-sub); white-space: nowrap; }
        .alert-title { font-weight: 700; font-size: 0.84rem; margin-bottom: 4px; letter-spacing: -0.01em; }
        .alert-text { font-size: 0.76rem; color: var(--text-dim); line-height: 1.5; }
        .alert-actions { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
        .alert-actions .btn-modern { padding: 6px 12px; font-size: 0.7rem; }

        /* Velo del menú lateral en móvil */
        .crm-sidebar-scrim {
            position: fixed;
            inset: 0;
            z-index: 99;
            background: rgba(2, 2, 4, 0.5);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            display: none;
        }

        html.nx-light .crm-sidebar-scrim { background: rgba(240, 242, 248, 0.5); }

        /* ---------- Responsive ---------- */
        @media (max-width: 1180px) {
            .fact-grid { grid-template-columns: minmax(0, 1fr); }
            .pipeline-board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .pipeline-col { min-height: 0; }
        }

        @media (max-width: 950px) {
            aside.crm-sidebar,
            aside.crm-sidebar.collapsed { left: -290px; width: var(--sidebar-width); }
            aside.crm-sidebar.mobile-open { left: 0; }
            aside.crm-sidebar.mobile-open ~ .crm-sidebar-scrim { display: block; }
            .btn-sidebar-collapse { display: none; }
            main.crm-main-wrapper,
            body.sidebar-collapsed main.crm-main-wrapper { margin-left: 0; width: 100%; }
            .messaging-layout { grid-template-columns: minmax(0, 1fr); height: auto; min-height: 0; }
            .msg-sidebar { border-right: none; border-bottom: 1px solid var(--card-border); max-height: 320px; }
            .msg-conversation-body { min-height: 320px; }
        }

        @media (max-width: 720px) {
            .crm-top-header { margin: 12px 16px 0; top: 12px; padding: 0 8px; }
