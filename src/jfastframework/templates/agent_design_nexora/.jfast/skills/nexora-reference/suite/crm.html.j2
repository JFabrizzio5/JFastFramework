            { id: 3, name: 'Industrias Mineras del Norte', contact: 'Lic. Fernando Garza', email: 'fgarza@minerasnorte.com', phone: '+52 87 1829 4710', stage: 'Cliente Cerrado', ltv: '$128,000 USD' },
            { id: 4, name: 'Banco Panamericano SA', contact: 'Mtro. Héctor Valdés', email: 'hvaldes@bancopan.com', phone: '+52 55 5283 0001', stage: 'Propuesta Enviada', ltv: '$64,900 USD' },
            { id: 5, name: 'Distribuidora Farma Express', contact: 'Q.F.B. Lucía Méndez', email: 'lmendez@farmaexpress.mx', phone: '+52 33 3920 1823', stage: 'Cliente Cerrado', ltv: '$32,400 USD' },
            { id: 6, name: 'Grupo Constructor Altiplano', contact: 'Arq. Javier Domínguez', email: 'jdominguez@altiplano.mx', phone: '+52 44 2819 0392', stage: 'En Contacto', ltv: '$15,000 USD' }
