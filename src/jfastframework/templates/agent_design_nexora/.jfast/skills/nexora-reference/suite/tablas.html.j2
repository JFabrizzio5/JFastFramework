<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JFast Suite | Tablas Empresariales Avanzadas</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
    
    <!-- Unified CSS -->
    <link rel="stylesheet" href="assets/css/nexora.css">

    <style>
        /* ==========================================================
           Tablas ERP — capa de página sobre nexora.css
           ========================================================== */

        /* ---- Encabezado de página ---- */
        .tbl-header {
            margin-top: 34px;
            align-items: flex-end;
        }

        .tbl-header .page-title h1 {
            font-size: clamp(1.9rem, 3.4vw, 2.7rem);
            font-weight: 900;
            letter-spacing: -0.045em;
            line-height: 1.02;
            margin-top: 10px;
        }

        .tbl-header .page-title h1 .faded {
            color: var(--text-sub);
            font-weight: 800;
        }

        .tbl-header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* ---- KPIs: tarjetas de vidrio con métrica mono ---- */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .kpi-stat-card {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            padding: 20px 20px 18px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
        }

        .kpi-stat-card::after {
            /* hilo de luz superior */
            content: "";
            position: absolute;
            left: 20px;
            right: 20px;
            top: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--kpi-tint, rgb(var(--c-accent))), transparent);
            opacity: 0.55;
        }

        .kpi-stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--card-hover-border);
        }

        .kpi-stat-info { min-width: 0; }

        .kpi-stat-info h4 {
            font-family: var(--font-mono);
            font-size: 0.66rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
            margin-bottom: 10px;
            white-space: nowrap;
        }

        .kpi-stat-info .num {
            font-family: var(--font-mono);
            font-size: clamp(1.35rem, 2.1vw, 1.75rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.05;
            font-variant-numeric: tabular-nums;
            color: var(--text-main);
            white-space: nowrap;
        }

        .kpi-meta {
            display: block;
            margin-top: 8px;
            font-family: var(--font-mono);
            font-size: 0.64rem;
            letter-spacing: 0.04em;
            color: var(--text-sub);
        }

        .kpi-stat-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--kpi-tint);
            background:
                radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.22), transparent 58%),
                color-mix(in srgb, var(--kpi-tint) 14%, transparent);
            border: 1px solid color-mix(in srgb, var(--kpi-tint) 32%, transparent);
            box-shadow:
                inset 0 1px 1.5px var(--card-specular),
                inset 0 -6px 12px -6px color-mix(in srgb, var(--kpi-tint) 40%, transparent),
                0 10px 22px -10px color-mix(in srgb, var(--kpi-tint) 70%, transparent);
        }

        .kpi-stat-icon svg { width: 20px; height: 20px; stroke-width: 2; }

        .tint-success { --kpi-tint: var(--success); }
        .tint-warning { --kpi-tint: var(--warning); }
        .tint-accent { --kpi-tint: rgb(var(--c-accent)); }

        /* ---- Barra de filtros ---- */
        .table-filter-bar {
            border-radius: 22px;
            padding: 12px 14px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-left-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            flex: 1;
            min-width: 0;
        }

        .table-search-input-wrap {
            position: relative;
            min-width: min(260px, 100%);
            flex: 1;
            max-width: 380px;
        }

        .table-search-input-wrap svg {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-dim);
            pointer-events: none;
        }

        .table-search-input {
            width: 100%;
            height: 40px;
            padding: 0 16px 0 40px;
            border: 1px solid var(--badge-border);
            border-radius: 9999px;
            background: var(--pill-bg);
            color: var(--text-main);
            font-size: 0.84rem;
            outline: none;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.18);
            transition: var(--transition-fast);
        }

        html.nx-light .table-search-input { box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04); }

        .table-search-input::placeholder { color: var(--text-light); }
        .table-search-input:hover { background: var(--pill-hover); }

        .table-search-input:focus {
            background: var(--pill-hover);
            border-color: rgb(var(--c-accent) / 0.6);
            box-shadow: 0 0 0 4px rgb(var(--c-accent) / 0.14);
        }

        .pill-select.form-select {
            width: auto;
            height: 40px;
            padding: 0 36px 0 16px;
            border-radius: 9999px;
            background-color: var(--pill-bg);
            border: 1px solid var(--badge-border);
            box-shadow: inset 0 1px 1px var(--card-specular);
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }

        .pill-select.form-select:hover {
            background-color: var(--pill-hover);
            border-color: var(--card-hover-border);
        }

        .page-size-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-size-control > span {
            font-family: var(--font-mono);
            font-size: 0.66rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
        }

        /* ---- Isla flotante de acciones masivas ---- */
        .batch-actions-banner {
            position: fixed;
            left: 50%;
            bottom: 26px;
            transform: translateX(-50%);
            z-index: 1500;
            display: none;
            align-items: center;
            gap: 14px;
            padding: 8px 8px 8px 18px;
            border-radius: 9999px;
            background: var(--nav-bg);
            backdrop-filter: blur(26px) saturate(190%);
            -webkit-backdrop-filter: blur(26px) saturate(190%);
            border: 1px solid var(--nav-border);
            box-shadow: 0 22px 50px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px rgb(var(--c-accent) / 0.12), inset 0 1px 1.5px var(--card-specular);
            animation: nxIslandIn 0.35s var(--ease-out);
            max-width: calc(100vw - 32px);
        }

        html.nx-light .batch-actions-banner {
            box-shadow: 0 22px 50px -14px rgba(28, 35, 60, 0.22), 0 0 0 1px rgb(var(--c-accent) / 0.12), inset 0 1px 1.5px #fff;
        }

        @keyframes nxIslandIn {
            from { opacity: 0; transform: translate(-50%, 18px) scale(0.96); }
            to { opacity: 1; transform: translate(-50%, 0) scale(1); }
        }

        .batch-count {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
        }

        .batch-count-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgb(var(--c-accent));
            box-shadow: 0 0 10px rgb(var(--c-accent) / 0.9);
        }

        .batch-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .batch-actions .btn-modern {
            padding: 8px 14px;
            font-size: 0.78rem;
        }

        .batch-actions .btn-modern svg { width: 14px; height: 14px; stroke-width: 2.2; }

        /* ---- Contenedor de la tabla ---- */
        .table-container-card {
            border-radius: 24px;
            overflow: hidden;
        }

        /* nexora.css ya da vidrio a .table-responsive: aquí el vidrio es la tarjeta */
        .table-container-card .table-responsive {
            border: none;
            border-radius: 0;
            background: transparent;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            box-shadow: none;
        }

        .erp-data-table th {
            user-select: none;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .erp-data-table th:hover { color: var(--text-main); }

        .erp-data-table th.non-sortable { cursor: default; }
        .erp-data-table th.non-sortable:hover { color: var(--text-dim); }

        .erp-data-table th.col-check,
        .erp-data-table td.col-check {
            width: 48px;
            padding-left: 20px;
            padding-right: 6px;
            text-align: center;
        }

        .erp-data-table .col-num { text-align: right; }

        .sort-icon {
            display: inline-block;
            margin-left: 4px;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-sub);
            transition: color 0.15s ease;
        }

        .sort-icon.is-sorted { color: rgb(var(--c-accent)); }

        .erp-data-table input[type=checkbox] {
            width: 15px;
            height: 15px;
            cursor: pointer;
            accent-color: rgb(var(--c-accent));
            vertical-align: middle;
        }

        .erp-data-table tbody tr.row-selected td {
            background: rgb(var(--c-accent) / 0.1);
        }

        .erp-data-table tbody tr.row-selected td:first-child {
            box-shadow: inset 3px 0 0 rgb(var(--c-accent));
        }

        .cell-folio {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
        }

        .cell-folio span { color: rgb(var(--c-accent)); }

        .cell-client-name { font-weight: 700; line-height: 1.3; }

        .cell-rfc {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            letter-spacing: 0.03em;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .cell-chip {
            display: inline-flex;
            align-items: center;
            padding: 4px 11px;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 600;
            white-space: nowrap;
            color: var(--text-main);
            background: var(--pill-bg);
            border: 1px solid var(--badge-border);
        }

        .cell-date {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-dim);
            white-space: nowrap;
        }

        .cell-amount {
            font-family: var(--font-mono);
            font-size: 0.84rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: var(--text-main);
            white-space: nowrap;
        }

        .row-actions {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .row-actions .btn-table-ficha svg { width: 13px; height: 13px; stroke-width: 2.2; }

        .btn-row-delete {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-dim);
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .btn-row-delete:hover {
            color: var(--danger);
            background: var(--danger-light);
            border-color: var(--danger-border);
        }

        .btn-row-delete svg { width: 14px; height: 14px; stroke-width: 2; }

        .table-empty {
            text-align: center;
            padding: 52px 20px !important;
            color: var(--text-dim);
        }

        .table-empty-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 12px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgb(var(--c-accent));
            background: rgb(var(--c-accent) / 0.1);
            border: 1px solid rgb(var(--c-accent) / 0.25);
            box-shadow: inset 0 1px 1.5px var(--card-specular);
        }

        .table-empty strong { display: block; color: var(--text-main); font-size: 0.9rem; }
        .table-empty small { font-size: 0.78rem; }

        /* ---- Paginación ---- */
        .table-pagination-footer {
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--card-border);
            background: var(--bg-muted);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-dim);
            flex-wrap: wrap;
            gap: 12px;
        }

        .pagination-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .page-num-btn {
            min-width: 34px;
            height: 34px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            border: 1px solid var(--badge-border);
            background: var(--pill-bg);
            box-shadow: inset 0 1px 1px var(--card-specular);
            color: var(--text-main);
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.74rem;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .page-num-btn:hover {
            background: var(--pill-hover);
            border-color: var(--card-hover-border);
        }

        .page-num-btn.active {
            background: rgb(var(--c-accent));
            color: rgb(var(--c-on-accent));
            border-color: rgb(var(--c-accent));
            box-shadow: 0 8px 20px -6px rgb(var(--c-accent) / 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.35);
        }

        .page-num-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
            pointer-events: none;
        }

        /* ---- Modales ---- */
        .modal-title-block {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .modal-title-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgb(var(--c-accent));
            background:
                radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.22), transparent 58%),
                rgb(var(--c-accent) / 0.12);
            border: 1px solid rgb(var(--c-accent) / 0.3);
            box-shadow: inset 0 1px 1.5px var(--card-specular), 0 10px 22px -10px rgb(var(--c-accent) / 0.7);
        }

        .modal-title-icon svg { width: 18px; height: 18px; stroke-width: 2; }

        .modal-title-block .nx-eyebrow { font-size: 0.62rem; }
        .modal-title-block h3 { margin-top: 2px; }
        .modal-title-block h3.is-mono { font-family: var(--font-mono); font-size: 1.05rem; letter-spacing: -0.02em; }

        .modal-sub {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .inv-summary {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            padding: 16px 18px;
            border-radius: 18px;
            background: var(--pill-bg);
            border: 1px solid var(--card-border);
            box-shadow: inset 0 1px 1px var(--card-specular);
        }

        .inv-label {
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
        }

        .inv-client { font-weight: 800; margin-top: 6px; letter-spacing: -0.01em; }

        .inv-rfc {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .inv-section-title {
            font-size: 0.9rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .inv-items-wrap {
            border: 1px solid var(--card-border);
            border-radius: 16px;
            overflow: hidden;
            overflow-x: auto;
        }

        .inv-items {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
        }

        .inv-items th {
            padding: 10px 14px;
            background: var(--bg-muted);
            font-family: var(--font-mono);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-dim);
            border-bottom: 1px solid var(--card-border);
        }

        .inv-items td {
            padding: 11px 14px;
            border-bottom: 1px solid var(--border-dark);
        }

        .inv-items tr:last-child td { border-bottom: none; }
        .inv-items .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

        .inv-total {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
            padding: 14px 18px;
            border-radius: 16px;
            background: rgb(var(--c-accent) / 0.08);
            border: 1px solid rgb(var(--c-accent) / 0.22);
        }

        .inv-total strong {
            font-family: var(--font-mono);
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: rgb(var(--c-accent));
            font-variant-numeric: tabular-nums;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-grid-2 .form-group { margin-bottom: 0; }
        #modalNewTransaction .modal-body > .form-group { margin-bottom: 0; }
        .form-input.is-mono { font-family: var(--font-mono); }

        /* ---- Responsive ---- */
        @media (max-width: 1024px) {
            .kpi-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 640px) {
            .tbl-header { margin-top: 24px; }
            .tbl-header-actions { width: 100%; }
            .tbl-header-actions .btn-modern { flex: 1; }
            .kpi-row { gap: 12px; }
            .kpi-stat-card { padding: 16px; flex-direction: column-reverse; gap: 12px; }
            .kpi-stat-icon { width: 38px; height: 38px; border-radius: 12px; }
            .kpi-stat-info h4 { white-space: normal; letter-spacing: 0.1em; line-height: 1.35; }
            .kpi-stat-info .num { font-size: 1.3rem; }
            .table-search-input-wrap { max-width: none; flex-basis: 100%; }
            .filter-left-controls .pill-select { flex: 1; min-width: 0; padding: 0 28px 0 14px; font-size: 0.76rem; background-position: right 11px center; }
            .page-size-control { width: 100%; justify-content: space-between; }
            .table-pagination-footer { justify-content: center; text-align: center; }
            .inv-summary, .form-grid-2 { grid-template-columns: 1fr; }
            .batch-actions-banner { bottom: 16px; padding: 8px 8px 8px 14px; gap: 10px; }
            .batch-actions .btn-label { display: none; }
            .batch-actions .btn-modern { padding: 9px; }
        }
    </style>
</head>
<body>

    <!-- Main Navigation Bar -->
    <header class="nexora-navbar">
        <div class="brand-wrapper">
            <a href="index.html" aria-label="JFast Suite, inicio">
                <div class="brand-info">
                    <h1>JFast <span>Suite</span></h1>
                </div>
            </a>
        </div>

        <nav class="nav-links-menu" id="navLinksMenu" aria-label="Módulos">
            <a href="index.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                <span>Inicio</span>
            </a>
            <a href="crm.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M9 3v18M15 9l3 3-3 3"/></svg>
                <span>CRM</span>
            </a>
            <a href="social.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                <span>Red Social</span>
            </a>
            <a href="pagos.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="20" height="14" x="2" y="5" rx="3"/><path d="M2 10h20"/></svg>
                <span>Pagos</span>
            </a>
            <a href="widgets.html" class="nav-pill-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="7" height="7" x="3" y="3" rx="2"/><rect width="7" height="7" x="14" y="3" rx="2"/><rect width="7" height="7" x="14" y="14" rx="2"/><rect width="7" height="7" x="3" y="14" rx="2"/></svg>
                <span>Widgets</span>
            </a>
            <a href="tablas.html" class="nav-pill-link active" aria-current="page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon-sm" style="stroke-width:1.8;"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
                <span>Tablas ERP</span>
            </a>
