    <!-- Scripts -->
    <script src="assets/js/nexora-common.js"></script>
    <script>
        // Database State
        let tableData = [
            { id: 1, folio: 'FAC-2026-904', client: 'Logística Austral S.A.', rfc: 'LAU920311K82', category: 'Hardware & Servidores', date: '2026-09-23', amount: 14850.00, status: 'Completado', items: [{ desc: 'Servidor Dell R740 2U', qty: 3, price: 4950 }] },
            { id: 2, folio: 'FAC-2026-903', client: 'TechGlobal Soluciones Corp', rfc: 'TGS180512M90', category: 'Licencias SaaS', date: '2026-09-22', amount: 8420.00, status: 'Pendiente', items: [{ desc: 'Licencia JFast Pro 50 Seats', qty: 1, price: 8420 }] },
            { id: 3, folio: 'FAC-2026-902', client: 'Industrias Mineras del Norte', rfc: 'IMN080124TR4', category: 'Ciberseguridad', date: '2026-09-22', amount: 32100.00, status: 'En proceso', items: [{ desc: 'Módulo Firewall Fortinet & Setup', qty: 2, price: 16050 }] },
            { id: 4, folio: 'FAC-2026-901', client: 'Banco Panamericano SA', rfc: 'BPA890314L55', category: 'Servicios Cloud', date: '2026-09-21', amount: 64900.00, status: 'Completado', items: [{ desc: 'Clúster Privado Kubernetes Anual', qty: 1, price: 64900 }] },
            { id: 5, folio: 'FAC-2026-900', client: 'Distribuidora Farma Express', rfc: 'DFE120809H22', category: 'Hardware & Servidores', date: '2026-09-20', amount: 9240.00, status: 'Completado', items: [{ desc: 'Switch Cisco Catalyst 9200', qty: 4, price: 2310 }] },
            { id: 6, folio: 'FAC-2026-899', client: 'Grupo Constructor Altiplano', rfc: 'GCA150218U11', category: 'Licencias SaaS', date: '2026-09-19', amount: 5600.00, status: 'Cancelado', items: [{ desc: 'Suscripción ERP Starter Anual', qty: 1, price: 5600 }] },
            { id: 7, folio: 'FAC-2026-898', client: 'OmniLogistics México', rfc: 'OLM190704V88', category: 'Hardware & Servidores', date: '2026-09-18', amount: 28500.00, status: 'Completado', items: [{ desc: 'Sistema UPS APC 3000VA', qty: 3, price: 9500 }] },
            { id: 8, folio: 'FAC-2026-897', client: 'Cervecería Artesanal Modelo', rfc: 'CAM110923P33', category: 'Servicios Cloud', date: '2026-09-17', amount: 22800.00, status: 'Pendiente', items: [{ desc: 'Almacenamiento NVMe en la Nube', qty: 1, price: 22800 }] }
        ];

        let currentSortColumn = 'date';
        let currentSortOrder = 'desc'; // 'asc' or 'desc'
        let currentPage = 1;
        let pageSize = 5;
        let selectedRowIds = new Set();

        // 1. Filtering & Sorting Engine
        function getFilteredData() {
            const query = document.getElementById('globalSearchInput').value.trim().toLowerCase();
            const statusFilter = document.getElementById('statusFilterSelect').value;
            const categoryFilter = document.getElementById('categoryFilterSelect').value;

            return tableData.filter(row => {
                const matchQuery = !query || 
                    row.folio.toLowerCase().includes(query) ||
                    row.client.toLowerCase().includes(query) ||
                    row.rfc.toLowerCase().includes(query) ||
                    row.category.toLowerCase().includes(query) ||
                    row.status.toLowerCase().includes(query);

                const matchStatus = (statusFilter === 'ALL') || (row.status === statusFilter);
                const matchCategory = (categoryFilter === 'ALL') || (row.category === categoryFilter);

                return matchQuery && matchStatus && matchCategory;
            }).sort((a, b) => {
                let valA = a[currentSortColumn];
                let valB = b[currentSortColumn];

                if (typeof valA === 'string') {
                    return currentSortOrder === 'asc' 
                        ? valA.localeCompare(valB) 
                        : valB.localeCompare(valA);
                } else {
                    return currentSortOrder === 'asc' ? valA - valB : valB - valA;
                }
            });
        }

        // 2. Render Table Rows & Pagination
        function renderTable() {
            const filtered = getFilteredData();
            const totalRows = filtered.length;
            const totalPages = Math.ceil(totalRows / pageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalRows);
            const pageSlice = filtered.slice(startIndex, endIndex);

            const tbody = document.getElementById('tableBodyRows');

            if (pageSlice.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="table-empty">
                            <div class="table-empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:20px;height:20px;stroke-width:2;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </div>
                            <strong>No se encontraron transacciones</strong>
                            <small>Prueba con otro término o limpia los filtros.</small>
                        </td>
                    </tr>
                `;
            } else {
                tbody.innerHTML = pageSlice.map(row => {
                    const isSelected = selectedRowIds.has(row.id);
                    let badgeClass = 'status-processing';
                    if (row.status === 'Completado') badgeClass = 'status-completed';
                    else if (row.status === 'Pendiente') badgeClass = 'status-pending';
                    else if (row.status === 'Cancelado') badgeClass = 'status-cancelled';

                    return `
                        <tr class="${isSelected ? 'row-selected' : ''}">
                            <td class="col-check">
                                <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleRowSelect(${row.id}, this.checked)" aria-label="Seleccionar ${row.folio}">
                            </td>
                            <td class="cell-folio"><span>#</span>${row.folio}</td>
                            <td>
                                <div class="cell-client-name">${row.client}</div>
                                <div class="cell-rfc">${row.rfc}</div>
                            </td>
                            <td><span class="cell-chip">${row.category}</span></td>
                            <td class="cell-date">${formatDate(row.date)}</td>
                            <td class="cell-amount col-num">$${row.amount.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                            <td>
                                <span class="badge-status ${badgeClass}"><span class="status-dot"></span>${row.status}</span>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions">
                                    <button type="button" class="btn-table-ficha" onclick="openInvoiceModal(${row.id})" title="Ver factura">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Ver
                                    </button>
                                    <button type="button" class="btn-row-delete" onclick="deleteRow(${row.id})" title="Eliminar" aria-label="Eliminar ${row.folio}">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Update Pagination Text
            const infoText = document.getElementById('paginationInfoText');
            if (totalRows === 0) {
                infoText.textContent = 'Mostrando 0 registros';
            } else {
                infoText.textContent = `Mostrando ${startIndex + 1} a ${endIndex} de ${totalRows} transacciones`;
            }

            // Render Pagination Nav Buttons
            const nav = document.getElementById('paginationControls');
            let paginationHtml = `
                <button class="page-num-btn" ${currentPage === 1 ? 'disabled' : ''} onclick="goToPage(${currentPage - 1})">‹ Ant</button>
            `;

            for (let i = 1; i <= totalPages; i++) {
                paginationHtml += `
                    <button class="page-num-btn ${currentPage === i ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>
                `;
            }

            paginationHtml += `
                <button class="page-num-btn" ${currentPage === totalPages ? 'disabled' : ''} onclick="goToPage(${currentPage + 1})">Sig ›</button>
            `;
            nav.innerHTML = paginationHtml;

            // Master Checkbox state
            const allChecked = pageSlice.length > 0 && pageSlice.every(r => selectedRowIds.has(r.id));
            document.getElementById('selectAllCheckbox').checked = allChecked;

            updateKPIs();
            updateBatchBanner();
        }

        function formatDate(dateStr) {
            const [y, m, d] = dateStr.split('-');
            const months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
            return `${d} ${months[parseInt(m) - 1]} ${y}`;
        }

        // 3. Sorting Mechanism
        function sortTable(column) {
            if (currentSortColumn === column) {
                currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortOrder = 'asc';
            }

            // Update sort icons
            document.querySelectorAll('.sort-icon').forEach(icon => {
                icon.textContent = '↕';
                icon.classList.remove('is-sorted');
            });
            const targetIcon = document.getElementById(`sort-${column}`);
            if (targetIcon) {
                targetIcon.textContent = currentSortOrder === 'asc' ? '↑' : '↓';
                targetIcon.classList.add('is-sorted');
            }

            renderTable();
        }

        // 4. Handlers
        function handleTableSearch(val) {
            currentPage = 1;
            renderTable();
        }

        function applyFilters() {
            currentPage = 1;
            renderTable();
        }

        function changePageSize(size) {
            pageSize = size;
            currentPage = 1;
            renderTable();
        }

        function goToPage(page) {
            currentPage = page;
            renderTable();
        }

        function resetFilters() {
            document.getElementById('globalSearchInput').value = '';
            document.getElementById('statusFilterSelect').value = 'ALL';
            document.getElementById('categoryFilterSelect').value = 'ALL';
            currentPage = 1;
            renderTable();
            showToast('Filtros', 'Filtros restablecidos a la vista global.', 'info');
        }

        // 5. Selection Management
        function toggleRowSelect(id, checked) {
            if (checked) selectedRowIds.add(id);
            else selectedRowIds.delete(id);
            renderTable();
        }

        function toggleSelectAll(checked) {
            const filtered = getFilteredData();
            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, filtered.length);
            const pageSlice = filtered.slice(startIndex, endIndex);

            pageSlice.forEach(row => {
                if (checked) selectedRowIds.add(row.id);
                else selectedRowIds.delete(row.id);
            });

            renderTable();
        }

        function updateBatchBanner() {
            const banner = document.getElementById('batchActionsBar');
            const countText = document.getElementById('selectedCountText');
            if (selectedRowIds.size > 0) {
                banner.style.display = 'flex';
                countText.textContent = `${selectedRowIds.size} transacción(es) seleccionada(s)`;
            } else {
                banner.style.display = 'none';
            }
        }

        function clearSelection() {
            selectedRowIds.clear();
            renderTable();
        }

        function batchMarkCompleted() {
            tableData.forEach(row => {
                if (selectedRowIds.has(row.id)) row.status = 'Completado';
            });
            showToast('Acción en Lote', `${selectedRowIds.size} órdenes marcadas como Completadas.`, 'success');
            selectedRowIds.clear();
            renderTable();
        }

        function batchDeleteRows() {
            tableData = tableData.filter(row => !selectedRowIds.has(row.id));
            showToast('Eliminación', 'Las órdenes seleccionadas fueron eliminadas.', 'warning');
            selectedRowIds.clear();
            renderTable();
        }

        function deleteRow(id) {
            const row = tableData.find(r => r.id === id);
            tableData = tableData.filter(r => r.id !== id);
            selectedRowIds.delete(id);
            renderTable();
            showToast('Registro Eliminado', `La orden ${row ? row.folio : ''} fue eliminada.`, 'danger');
        }

        // 6. Modal View Invoice Detail
        function openInvoiceModal(id) {
            const row = tableData.find(r => r.id === id);
            if (!row) return;

            document.getElementById('invDetailFolio').textContent = `#${row.folio}`;
            document.getElementById('invDetailDate').textContent = `Emitida el ${formatDate(row.date)}`;
            document.getElementById('invDetailClient').textContent = row.client;
            document.getElementById('invDetailRfc').textContent = `RFC: ${row.rfc}`;
            document.getElementById('invDetailTotalAmount').textContent = `$${row.amount.toLocaleString('en-US', {minimumFractionDigits: 2})}`;

            let badgeClass = 'status-processing';
            if (row.status === 'Completado') badgeClass = 'status-completed';
            else if (row.status === 'Pendiente') badgeClass = 'status-pending';
            else if (row.status === 'Cancelado') badgeClass = 'status-cancelled';
            document.getElementById('invDetailStatus').innerHTML = `<span class="badge-status ${badgeClass}"><span class="status-dot"></span>${row.status}</span>`;

            // Items breakdown
            const tbody = document.getElementById('invDetailItemsBody');
            tbody.innerHTML = (row.items || [{ desc: 'Servicios Profesionales Especializados', qty: 1, price: row.amount }]).map(item => `
                <tr>
                    <td>${item.desc}</td>
                    <td class="mono" style="text-align: center;">${item.qty}</td>
                    <td class="mono" style="text-align: right; font-weight: 700;">$${(item.qty * item.price).toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                </tr>
            `).join('');

            openModal('modalInvoiceDetail');
        }

        // 7. Modal Create New Transaction
        function handleCreateTransaction(e) {
            e.preventDefault();
            const client = document.getElementById('newClientInput').value.trim();
            const amount = parseFloat(document.getElementById('newAmountInput').value);
            const category = document.getElementById('newCategorySelect').value;
            const status = document.getElementById('newStatusSelect').value;
            const date = document.getElementById('newDateInput').value;

            const nextNum = 905 + tableData.length;
            const newFolio = `FAC-2026-${nextNum}`;
            const randomRfc = client.substring(0, 3).toUpperCase() + '260928AB1';

            const newRow = {
                id: Date.now(),
                folio: newFolio,
                client: client,
                rfc: randomRfc,
                category: category,
                date: date,
                amount: amount,
                status: status,
                items: [{ desc: `${category} - Asignación`, qty: 1, price: amount }]
            };

            tableData.unshift(newRow);
            closeModal('modalNewTransaction');
            e.target.reset();
            renderTable();
            showToast('Venta Registrada', `Folio #${newFolio} creado exitosamente.`, 'success');
        }

        // 8. Update KPIs
        function updateKPIs() {
            const totalRev = tableData.reduce((acc, r) => acc + r.amount, 0);
            const completed = tableData.filter(r => r.status === 'Completado').length;
            const pending = tableData.filter(r => r.status === 'Pendiente' || r.status === 'En proceso').length;

            document.getElementById('kpiTotalRevenue').textContent = `$${totalRev.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('kpiTotalCount').textContent = `${tableData.length} Folios`;
            document.getElementById('kpiCompletedCount').textContent = completed;
            document.getElementById('kpiPendingCount').textContent = pending;
        }

        // 9. Real CSV Export to Browser Download
        function exportTableToCSV() {
            const filtered = getFilteredData();
            const headers = ['Folio', 'Cliente', 'RFC', 'Categoria', 'Fecha', 'Importe_USD', 'Estado'];
            
            const rows = filtered.map(r => [
                `"${r.folio}"`,
                `"${r.client}"`,
                `"${r.rfc}"`,
                `"${r.category}"`,
                `"${r.date}"`,
                r.amount,
                `"${r.status}"`
            ]);

            const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `Reporte_Facturacion_JFast_${new Date().toISOString().slice(0, 10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showToast('Descarga CSV', 'Archivo CSV generado y descargado exitosamente.', 'success');
        }

        // Initialize today's date in new transaction form
        document.getElementById('newDateInput').value = new Date().toISOString().slice(0, 10);

        // Initial render
        renderTable();
    </script>
</body>
</html>
