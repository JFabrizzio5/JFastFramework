package jfast

import (
	"net/http"
	"net/http/httptest"
	"testing"
)

// newTestTenancy is tenancy with auth on, as every test here authenticates.
func newTestTenancy(t *testing.T, cfg TenancyConfig) *Tenancy {
	t.Helper()
	return buildTestTenancy(t, cfg, newTestAuth(t, secretConfig()))
}

// newPublicTenancy is tenancy in a service without auth: a public site with
// a tenant per subdomain.
func newPublicTenancy(t *testing.T, cfg TenancyConfig) *Tenancy {
	t.Helper()
	return buildTestTenancy(t, cfg, nil)
}

func buildTestTenancy(t *testing.T, cfg TenancyConfig, auth *Auth) *Tenancy {
	t.Helper()
	cfg.Enabled = true
	if cfg.HeaderName == "" {
		cfg.HeaderName = "X-Tenant-ID"
	}
	if cfg.PathPrefix == "" {
		cfg.PathPrefix = "/t"
	}
	if cfg.Reserved == nil {
		cfg.Reserved = reservedSubdomains
	}
	if cfg.ExemptPaths == nil {
		cfg.ExemptPaths = []string{"/health", "/ready"}
	}
	tenancy, err := NewTenancy(cfg, Config{Env: "local"}, auth, newTestLogger())
	if err != nil {
		t.Fatal(err)
	}
	return tenancy
}

// resolved runs one request through auth and tenancy and returns the tenant
// the handler sees and the status of the response.
func resolved(t *testing.T, tenancy *Tenancy, request *http.Request, guard Middleware) (string, int) {
	t.Helper()
	var seen string
	handler := Chain(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		seen, _ = TenantFrom(r.Context())
		w.WriteHeader(http.StatusOK)
	}), Authenticate(newTestAuth(t, secretConfig())), ResolveTenant(tenancy), guard)
	return seen, serve(handler, request).Code
}

func passThrough(next http.Handler) http.Handler { return next }

func withToken(t *testing.T, request *http.Request, claims map[string]any) *http.Request {
	request.Header.Set("Authorization", "Bearer "+mint(t, "HS256", []byte(testSecret), claims))
	return request
}

func TestSourcesAreTriedInOrderWithoutAuth(t *testing.T) {
	// No auth, no caller to check a source against: first hit wins, as in
	// Python without the auth plugin.
	tenancy := newPublicTenancy(t, TenancyConfig{
		Sources:    []string{"subdomain", "header"},
		BaseDomain: "app.example.com",
	})
	request := httptest.NewRequest(http.MethodGet, "http://globex.app.example.com/x", nil)
	request.Header.Set("X-Tenant-ID", "initech")
	if tenant, _ := resolved(t, tenancy, request, passThrough); tenant != "globex" {
		t.Fatalf("tenant = %q, want globex from the host", tenant)
	}
	// A reserved subdomain is never a tenant; the header is last.
	request = httptest.NewRequest(http.MethodGet, "http://www.app.example.com/x", nil)
	request.Header.Set("X-Tenant-ID", "Initech")
	if tenant, _ := resolved(t, tenancy, request, passThrough); tenant != "initech" {
		t.Fatalf("tenant = %q, want initech from the header", tenant)
	}
}

// -- with auth on, an unsigned source names a tenant but never grants one --

func unsignedTenancy(t *testing.T, trust bool) *Tenancy {
	return newTestTenancy(t, TenancyConfig{
		Sources:                 []string{"token", "subdomain", "path", "header"},
		BaseDomain:              "localhost",
		TrustUnscopedPrincipals: trust,
	})
}

func noTenantClaims() map[string]any {
	claims := validClaims()
	delete(claims, "tenant_id")
	return claims
}

func TestTheCurlFromTheLogIsA401(t *testing.T) {
	// curl -H "Host: acme.localhost" localhost:8700/tickets, and its POST.
	tenancy := unsignedTenancy(t, false)
	for _, method := range []string{http.MethodGet, http.MethodPost} {
		request := httptest.NewRequest(method, "http://acme.localhost:8700/tickets", nil)
		if tenant, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusUnauthorized || tenant != "" {
			t.Fatalf("%s anonymous on acme.: %d %q, want 401", method, code, tenant)
		}
	}
	for _, request := range []*http.Request{
		httptest.NewRequest(http.MethodGet, "http://localhost/t/acme/tickets", nil),
		func() *http.Request {
			r := httptest.NewRequest(http.MethodGet, "http://localhost/tickets", nil)
			r.Header.Set("X-Tenant-ID", "acme")
			return r
		}(),
	} {
		if _, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusUnauthorized {
			t.Fatalf("anonymous %s: %d, want 401", request.URL, code)
		}
	}
}

func TestANamedTenantIsNotGrantedToAnAnonymousRequest(t *testing.T) {
	tenancy := unsignedTenancy(t, false)
	var granted, named string
	handler := Chain(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		granted, _ = TenantFrom(r.Context())
		named = TenantRequestedFrom(r.Context())
		w.WriteHeader(http.StatusOK)
	}), Authenticate(newTestAuth(t, secretConfig())), ResolveTenant(tenancy))
	// A route that asks no tenant still answers -- a sign-in page reads the
	// named one.
	if code := serve(handler, httptest.NewRequest(http.MethodGet, "http://acme.localhost/login", nil)).Code; code != http.StatusOK {
		t.Fatalf("public route: %d", code)
	}
	if granted != "" || named != "acme" {
		t.Fatalf("granted %q named %q, want none and acme", granted, named)
	}
}

func TestATokenOnItsOwnSubdomainIsServed(t *testing.T) {
	tenancy := unsignedTenancy(t, false)
	for _, host := range []string{"http://acme.localhost/x", "http://localhost/x"} {
		request := withToken(t, httptest.NewRequest(http.MethodGet, host, nil), validClaims())
		if tenant, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusOK || tenant != "acme" {
			t.Fatalf("%s: %d %q, want acme", host, code, tenant)
		}
	}
}

func TestATokenOfAcmeOnGlobexIsA403(t *testing.T) {
	tenancy := unsignedTenancy(t, false)
	request := withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), validClaims())
	if tenant, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusForbidden || tenant != "" {
		t.Fatalf("acme token on globex: %d %q, want 403", code, tenant)
	}
	// Not served as acme either, even by a handler that skips RequireTenant.
	request = withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), validClaims())
	if tenant, _ := resolved(t, tenancy, request, passThrough); tenant != "" {
		t.Fatalf("TenantFrom = %q on a refused request", tenant)
	}
}

func TestSourceOrderDoesNotLetTheSubdomainOutrankTheToken(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"subdomain", "token"}, BaseDomain: "localhost"})
	request := withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), validClaims())
	if _, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusForbidden {
		t.Fatalf("subdomain listed first: %d, want 403", code)
	}
}

func TestAnUnscopedTokenOnASubdomainIsA403UnlessTrusted(t *testing.T) {
	request := withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), noTenantClaims())
	if _, code := resolved(t, unsignedTenancy(t, false), request, RequireTenant); code != http.StatusForbidden {
		t.Fatalf("unscoped token: %d, want 403", code)
	}

	trusting := unsignedTenancy(t, true)
	request = withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), noTenantClaims())
	if tenant, code := resolved(t, trusting, request, RequireTenant); code != http.StatusOK || tenant != "globex" {
		t.Fatalf("trusted unscoped token: %d %q, want globex", code, tenant)
	}
	// The opt-in is about tokens without a tenant, nothing else.
	if _, code := resolved(t, trusting, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), RequireTenant); code != http.StatusUnauthorized {
		t.Fatalf("trusting, anonymous: %d, want 401", code)
	}
	request = withToken(t, httptest.NewRequest(http.MethodGet, "http://globex.localhost/x", nil), validClaims())
	if _, code := resolved(t, trusting, request, RequireTenant); code != http.StatusForbidden {
		t.Fatalf("trusting, acme token on globex: %d, want 403", code)
	}
}

func TestTheUserSourceIsSignedAndTheSubdomainMustMatch(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token", "user", "subdomain"}, BaseDomain: "localhost"})
	request := withToken(t, httptest.NewRequest(http.MethodGet, "http://acme.localhost/x", nil), noTenantClaims())
	if _, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusForbidden {
		t.Fatalf("user-1 on acme.: %d, want 403", code)
	}
}

func TestRequireTenantSettingLetsANamedTenantThrough(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token", "subdomain"}, BaseDomain: "localhost", RequireTenant: true})
	if _, code := resolved(t, tenancy, httptest.NewRequest(http.MethodGet, "http://acme.localhost/login", nil), passThrough); code != http.StatusOK {
		t.Fatalf("sign-in page on acme.: %d, want 200", code)
	}
	if _, code := resolved(t, tenancy, httptest.NewRequest(http.MethodGet, "http://localhost/login", nil), passThrough); code != http.StatusForbidden {
		t.Fatalf("no tenant named: %d, want 403", code)
	}
}

func TestTheHeaderIsIgnoredUnlessItIsASource(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token"}})
	request := httptest.NewRequest(http.MethodGet, "/x", nil)
	request.Header.Set("X-Tenant-ID", "acme")
	if tenant, _ := resolved(t, tenancy, request, passThrough); tenant != "" {
		t.Fatalf("tenant = %q from an unsigned header", tenant)
	}
}

func TestUserSourceUsesTheSubject(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token", "user"}})
	claims := validClaims()
	delete(claims, "tenant_id")
	request := withToken(t, httptest.NewRequest(http.MethodGet, "/x", nil), claims)
	if tenant, _ := resolved(t, tenancy, request, passThrough); tenant != "user-1" {
		t.Fatalf("tenant = %q, want the subject", tenant)
	}
}

func TestPathSource(t *testing.T) {
	if got := TenantFromPath("/t/Acme/invoices", "/t"); got != "acme" {
		t.Fatalf("path tenant = %q", got)
	}
	if got := TenantFromHost("a.b.app.example.com", "app.example.com", reservedSubdomains); got != "" {
		t.Fatalf("nested subdomain resolved to %q", got)
	}
}

func TestRequireTenantIs401WithoutASessionAnd403WithoutATenant(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token"}})

	if _, code := resolved(t, tenancy, httptest.NewRequest(http.MethodGet, "/x", nil), RequireTenant); code != http.StatusUnauthorized {
		t.Fatalf("no session: %d, want 401", code)
	}

	claims := validClaims()
	delete(claims, "tenant_id")
	request := withToken(t, httptest.NewRequest(http.MethodGet, "/x", nil), claims)
	if _, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusForbidden {
		t.Fatalf("session without a tenant: %d, want 403", code)
	}

	// An expired token is no session: 401, so the client refreshes.
	expired := validClaims()
	expired["exp"] = int64(1)
	request = withToken(t, httptest.NewRequest(http.MethodGet, "/x", nil), expired)
	if _, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusUnauthorized {
		t.Fatalf("expired token: %d, want 401", code)
	}

	request = withToken(t, httptest.NewRequest(http.MethodGet, "/x", nil), validClaims())
	if tenant, code := resolved(t, tenancy, request, RequireTenant); code != http.StatusOK || tenant != "acme" {
		t.Fatalf("session with a tenant: %d %q", code, tenant)
	}
}

func TestWithoutTenancyTheTokenClaimIsTheTenant(t *testing.T) {
	// Python's current_tenant falls back to the token claim when the tenancy
	// plugin is off; so does TenantFrom.
	request := withToken(t, httptest.NewRequest(http.MethodGet, "/x", nil), validClaims())
	if tenant, code := resolved(t, nil, request, RequireTenant); code != http.StatusOK || tenant != "acme" {
		t.Fatalf("no tenancy: %d %q", code, tenant)
	}
}

func TestRequireTenantSettingAnswers403OutsideExemptPaths(t *testing.T) {
	tenancy := newTestTenancy(t, TenancyConfig{Sources: []string{"token"}, RequireTenant: true})

	if _, code := resolved(t, tenancy, httptest.NewRequest(http.MethodGet, "/x", nil), passThrough); code != http.StatusForbidden {
		t.Fatalf("unscoped request: %d, want 403", code)
	}
	if _, code := resolved(t, tenancy, httptest.NewRequest(http.MethodGet, "/health", nil), passThrough); code != http.StatusOK {
		t.Fatalf("/health: %d, want 200", code)
	}
}

func TestTenancyConfigurationsPythonRefusesAreRefused(t *testing.T) {
	for name, cfg := range map[string]TenancyConfig{
		"unknown source":           {Enabled: true, Sources: []string{"cookie"}},
		"subdomain without a base": {Enabled: true, Sources: []string{"subdomain"}},
	} {
		if _, err := NewTenancy(cfg, Config{Env: "local"}, nil, newTestLogger()); err == nil {
			t.Errorf("%s: started, want a startup error", name)
		}
	}
}
