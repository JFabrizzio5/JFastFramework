package {{ module }}

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"{{ service_slug }}/internal/jfast"
)

func newTestMux() *http.ServeMux {
	mux := http.NewServeMux()
	NewModule().Register(mux)
	return mux
}

func TestCreateReturnsTheStoredItem(t *testing.T) {
	mux := newTestMux()
	recorder := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodPost, "/{{ table }}",
		strings.NewReader(`{"id":0,"name":"first","is_active":true}`))
	mux.ServeHTTP(recorder, request)

	if recorder.Code != http.StatusCreated {
		t.Fatalf("status = %d, want 201: %s", recorder.Code, recorder.Body)
	}
	var item {{ Module }}
	if err := json.Unmarshal(recorder.Body.Bytes(), &item); err != nil {
		t.Fatal(err)
	}
	if item.ID != 1 || item.Name != "first" {
		t.Fatalf("item = %+v", item)
	}
}

func TestDuplicateNameIsAConflict(t *testing.T) {
	mux := newTestMux()
	body := `{"id":0,"name":"dup","is_active":true}`
	for range 1 {
		mux.ServeHTTP(httptest.NewRecorder(),
			httptest.NewRequest(http.MethodPost, "/{{ table }}", strings.NewReader(body)))
	}

	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder,
		httptest.NewRequest(http.MethodPost, "/{{ table }}", strings.NewReader(body)))

	if recorder.Code != http.StatusConflict {
		t.Fatalf("status = %d, want 409", recorder.Code)
	}
	if ct := recorder.Header().Get("Content-Type"); ct != "application/problem+json" {
		t.Fatalf("content-type = %q, want problem+json", ct)
	}
}

func TestMissingItemIs404ProblemJSON(t *testing.T) {
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/{{ table }}/404", nil))

	if recorder.Code != http.StatusNotFound {
		t.Fatalf("status = %d, want 404", recorder.Code)
	}
}

func TestUnknownFieldsAreRejected(t *testing.T) {
	// Silently ignoring a misspelled field hides client bugs for months.
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/{{ table }}",
		strings.NewReader(`{"name":"x","nmae":"typo"}`)))

	if recorder.Code != http.StatusBadRequest {
		t.Fatalf("status = %d, want 400", recorder.Code)
	}
}

func TestEmptyNameIsRejected(t *testing.T) {
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/{{ table }}",
		strings.NewReader(`{"name":"","is_active":true}`)))

	if recorder.Code != http.StatusBadRequest {
		t.Fatalf("status = %d, want 400", recorder.Code)
	}
}

func TestTenantsDoNotSeeEachOthersItems(t *testing.T) {
	mux := newTestMux()
	create := httptest.NewRequest(http.MethodPost, "/{{ table }}",
		strings.NewReader(`{"name":"only-acme","is_active":true}`))
	create = create.WithContext(jfast.WithTenant(create.Context(), "acme"))
	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, create)
	if recorder.Code != http.StatusCreated {
		t.Fatalf("status = %d, want 201", recorder.Code)
	}

	for tenant, want := range map[string]int{"acme": 1, "globex": 0, "": 0} {
		list := httptest.NewRequest(http.MethodGet, "/{{ table }}", nil)
		list = list.WithContext(jfast.WithTenant(list.Context(), tenant))
		recorder := httptest.NewRecorder()
		mux.ServeHTTP(recorder, list)

		var items []{{ Module }}
		if err := json.Unmarshal(recorder.Body.Bytes(), &items); err != nil {
			t.Fatal(err)
		}
		if len(items) != want {
			t.Fatalf("tenant %q sees %d items, want %d", tenant, len(items), want)
		}
	}
}
