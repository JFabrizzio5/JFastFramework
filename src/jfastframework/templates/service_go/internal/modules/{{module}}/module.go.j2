// Package {{ module }} is the {{ module_title }} domain module.
//
// Same layering as the Python services: HTTP in, service rules, storage out.
// Keep the boundaries -- an HTTP type reaching the store, or a SQL query
// reaching the handler, is how a Go service turns into one 2000-line file.
package {{ module }}

import (
	"net/http"
	"strconv"
	"sync"

	"{{ service_slug }}/internal/jfast"
)

// {{ Module }} is the entity. Tags are the wire contract; keep them explicit
// so a field rename never silently changes the API.
type {{ Module }} struct {
	ID          int64  `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
	IsActive    bool   `json:"is_active"`
}

// Store is the seam. Swap the in-memory implementation for PostgreSQL by
// implementing this interface -- nothing above it changes.
//
// Every method takes the tenant. It is "" when the service runs without
// tenancy (the default), and then everything lives in one partition; with
// JFAST_TENANCY_SOURCES set, each tenant sees only its own rows. A real store
// puts it in the WHERE clause of every query -- the Python BaseRepository
// does the same with tenant_id.
type Store interface {
	List(tenant string) []{{ Module }}
	Get(tenant string, id int64) ({{ Module }}, bool)
	Create(tenant string, item {{ Module }}) ({{ Module }}, error)
	Delete(tenant string, id int64) bool
}

// MemoryStore keeps the generated service runnable with no database. Replace
// it before this module holds anything you would miss.
type MemoryStore struct {
	mu     sync.RWMutex
	items  map[string]map[int64]{{ Module }}
	nextID int64
}

func NewMemoryStore() *MemoryStore {
	return &MemoryStore{items: map[string]map[int64]{{ Module }}{}, nextID: 1}
}

func (s *MemoryStore) List(tenant string) []{{ Module }} {
	s.mu.RLock()
	defer s.mu.RUnlock()
	out := make([]{{ Module }}, 0, len(s.items[tenant]))
	for _, item := range s.items[tenant] {
		out = append(out, item)
	}
	return out
}

func (s *MemoryStore) Get(tenant string, id int64) ({{ Module }}, bool) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	item, ok := s.items[tenant][id]
	return item, ok
}

func (s *MemoryStore) Create(tenant string, item {{ Module }}) ({{ Module }}, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	for _, existing := range s.items[tenant] {
		if existing.Name == item.Name {
			return {{ Module }}{}, jfast.Conflict("{{ module }} named " + item.Name + " already exists")
		}
	}
	if s.items[tenant] == nil {
		s.items[tenant] = map[int64]{{ Module }}{}
	}
	item.ID = s.nextID
	s.nextID++
	s.items[tenant][item.ID] = item
	return item, nil
}

func (s *MemoryStore) Delete(tenant string, id int64) bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, ok := s.items[tenant][id]; !ok {
		return false
	}
	delete(s.items[tenant], id)
	return true
}

// tenantOf is the request's tenant, or "" without one. The module works
// either way; to make a route refuse requests with no tenant, wrap it in
// jfast.RequireTenant (401 without a session, 403 without a tenant).
func tenantOf(r *http.Request) string {
	tenant, _ := jfast.TenantFrom(r.Context())
	return tenant
}

type Module struct{ store Store }

func NewModule() *Module { return &Module{store: NewMemoryStore()} }

func NewModuleWithStore(store Store) *Module { return &Module{store: store} }

// Register mounts the module. Go 1.22+ patterns carry the method, so there is
// no router dependency and no method-not-allowed handling to write.
//
// Routes are open, like a Python route without a dependency. To require a
// verified caller, a scope or a tenant, wrap the handler:
//
//	mux.Handle("POST /{{ table }}", jfast.RequireAuth(http.HandlerFunc(m.create)))
//	mux.Handle("DELETE /{{ table }}/{id}", jfast.RequireScopes("{{ table }}:write")(http.HandlerFunc(m.delete)))
func (m *Module) Register(mux *http.ServeMux) {
	mux.HandleFunc("GET /{{ table }}", m.list)
	mux.HandleFunc("POST /{{ table }}", m.create)
	mux.HandleFunc("GET /{{ table }}/{id}", m.get)
	mux.HandleFunc("DELETE /{{ table }}/{id}", m.delete)
}

func (m *Module) list(w http.ResponseWriter, r *http.Request) {
	jfast.WriteJSON(w, http.StatusOK, m.store.List(tenantOf(r)))
}

func (m *Module) create(w http.ResponseWriter, r *http.Request) {
	var payload {{ Module }}
	if err := decodeJSON(r, &payload); err != nil {
		jfast.WriteProblem(w, r, jfast.BadRequest(err.Error()))
		return
	}
	if payload.Name == "" {
		jfast.WriteProblem(w, r, jfast.BadRequest("name must not be empty"))
		return
	}

	created, err := m.store.Create(tenantOf(r), payload)
	if err != nil {
		var problem jfast.Problem
		if asProblem(err, &problem) {
			jfast.WriteProblem(w, r, problem)
			return
		}
		jfast.WriteProblem(w, r, jfast.NewProblem(http.StatusInternalServerError, "create failed"))
		return
	}
	jfast.WriteJSON(w, http.StatusCreated, created)
}

func (m *Module) get(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
	if err != nil {
		jfast.WriteProblem(w, r, jfast.BadRequest("id must be an integer"))
		return
	}
	item, ok := m.store.Get(tenantOf(r), id)
	if !ok {
		jfast.WriteProblem(w, r, jfast.NotFound("{{ module }} not found"))
		return
	}
	jfast.WriteJSON(w, http.StatusOK, item)
}

func (m *Module) delete(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
	if err != nil {
		jfast.WriteProblem(w, r, jfast.BadRequest("id must be an integer"))
		return
	}
	if !m.store.Delete(tenantOf(r), id) {
		jfast.WriteProblem(w, r, jfast.NotFound("{{ module }} not found"))
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
