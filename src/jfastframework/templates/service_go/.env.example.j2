# Copy to .env. Same JFAST_* names the Python services use, so one deployment
# convention covers both languages.

JFAST_APP_NAME={{ service_slug }}
JFAST_ENV=local
JFAST_DEBUG=false          # true lets panic messages reach clients
JFAST_PORT={{ port }}
JFAST_LOG_JSON_LOGS=true

# Auth -- off unless configured, like the Python auth plugin. Same variable
# names, so copy the values of the service that mints the tokens (its .env and
# its [plugin.auth] block). Revoked tokens are NOT checked here: a revoked
# access token is accepted until it expires (15 minutes by default).
# JFAST_AUTH_MODE=secret             # secret | public_key (jwks: use a JWKS library)
# JFAST_AUTH_ALGORITHMS=["HS256"]
# JFAST_AUTH_SECRET=CHANGEME-the-minting-service-secret
# JFAST_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JFAST_AUTH_ISSUER=
# JFAST_AUTH_AUDIENCE=               # the aud the issuer writes; empty accepts any
# JFAST_AUTH_LEEWAY=30

# Tenancy -- off unless JFAST_TENANCY_SOURCES is set. Ordered by trust.
# JFAST_TENANCY_SOURCES=["token"]    # token, user, subdomain, path, header
# JFAST_TENANCY_BASE_DOMAIN=         # needed by the subdomain source
# JFAST_TENANCY_REQUIRE_TENANT=false
# With auth on, a subdomain/path/header names a tenant but only the token grants it.
# JFAST_TENANCY_TRUST_UNSCOPED_PRINCIPALS=false   # true: tokens without a tenant may act in the named one
{% if 'database' in datastores %}

DATABASE_URL=postgres://app:CHANGEME@localhost:{{ port + 1 }}/app?sslmode=disable
POSTGRES_PASSWORD=CHANGEME
{% endif %}
{% if 'cache' in datastores %}

REDIS_URL=redis://localhost:{{ port + 3 }}/0
{% endif %}
