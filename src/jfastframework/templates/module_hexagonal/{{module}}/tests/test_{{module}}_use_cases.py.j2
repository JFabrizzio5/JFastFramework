async def test_update_revalidates_the_merged_entity(use_cases: {{ Module }}UseCases) -> None:
    entity = await use_cases.create(first())
    with pytest.raises(ValidationError):
        await use_cases.update(stored_id(entity), {"{{ violations[0].name }}": {{ violations[0].too_long }}})
