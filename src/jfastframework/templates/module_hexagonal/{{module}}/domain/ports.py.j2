@dataclass
class {{ Module }}Page:
    """One page of {{ module_plural }}, owned by the domain.

    ``jfastframework.db.Page`` has the same fields and would do the same job.
    It is not used here because importing it pulls SQLAlchemy into the domain,
    and a type annotation is as real a dependency as a call. The shape is kept
    in step with it deliberately: the adapter maps field by field, so a field
    that exists on one and not the other is a mapping that stops compiling.

    ``total`` is None on a page fetched without a COUNT. A list that only
    draws a "next" button does not need the exact number and should not make
    the database produce one; ``more`` answers that question instead.
    """

    items: list[{{ Module }}]
    total: int | None
    limit: int
    offset: int
    more: bool | None = None

    def __post_init__(self) -> None:
        if self.total is None and self.more is None:
            raise ValueError(
                "a page with no total must say whether more rows follow: pass more=True/False"
            )

    @property
    def has_more(self) -> bool:
        if self.more is not None:
            return self.more
        total = self.total
        return total is not None and self.offset + len(self.items) < total


@runtime_checkable
class {{ Module }}Repository(Protocol):
    """Everything the application layer needs from storage. Nothing more.

    Keep it this narrow. Every method added here has to be implemented again by
    the in-memory fake and by any adapter written later, so a port that grows a
    convenience method costs more than the query it saved.

    ``runtime_checkable`` buys an ``isinstance`` check that verifies the method
    names are present -- not their signatures. It catches a fake that fell
    behind the port; it does not catch one whose arguments drifted. For that,
    ``infrastructure/repository.py`` keeps a static seam a type checker reads.
    """

