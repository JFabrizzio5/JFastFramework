# An unbounded page size is how one client takes the service down for
# everyone, so the cap is enforced here rather than trusted to the caller.
MAX_PAGE_SIZE = 200


def _as_dict(payload: Any, *, partial: bool = False) -> dict[str, Any]:
    """Accept a Pydantic model or a plain mapping.

    The HTTP adapter sends a model, the HTMX overlay and background jobs send a
    dict, and neither deserves its own use case. Duck-typed on ``model_dump``
    rather than an ``isinstance`` check, because the application layer must not
    import Pydantic to find out which one it got.
    """
    if hasattr(payload, "model_dump"):
        return payload.model_dump(exclude_unset=partial)  # type: ignore[no-any-return]
    if isinstance(payload, Mapping):
        return dict(payload)
    raise ValidationError("payload must be a mapping or a pydantic model")


