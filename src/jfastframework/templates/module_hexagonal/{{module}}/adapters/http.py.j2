"""HTTP adapter for {{ module_title }}.

Router and wire schemas together, because they change together. The router
translates HTTP into use-case calls and nothing else: no rules here, and no
queries either.

This is also the composition root for the HTTP entry point -- the one place
allowed to name a use case and a concrete adapter in the same file. That is
what a composition root is for, and confining it to two lines in
``get_use_cases`` is what keeps everything inside ``application/`` free of it.
"""

from __future__ import annotations

from datetime import datetime

from fastapi import APIRouter, Depends, Query, Request, status
from pydantic import BaseModel, ConfigDict, Field

from jfastframework.plugins.builtin.database import DbSession

from ..application.use_cases import {{ Module }}UseCases
from ..infrastructure.repository import Sql{{ Module }}Repository

router = APIRouter(prefix="/{{ table }}", tags=["{{ module }}"])


class {{ Module }}Create(BaseModel):
    name: str = Field(min_length=1, max_length=200)
    description: str | None = Field(default=None, max_length=2000)
    is_active: bool = True


class {{ Module }}Update(BaseModel):
    name: str | None = Field(default=None, min_length=1, max_length=200)
    description: str | None = Field(default=None, max_length=2000)
    is_active: bool | None = None


class {{ Module }}Read(BaseModel):
    # from_attributes because the use cases return domain dataclasses, not
    # rows and not dicts. Pydantic reads either the same way.
    model_config = ConfigDict(from_attributes=True)

    id: int
    name: str
    description: str | None
    is_active: bool
    # Nullable on the entity, because an entity that has not been stored yet
    # has no timestamps. Everything this router returns has been.
    created_at: datetime | None
    updated_at: datetime | None


# DbSession commits when the endpoint returns, before the response is sent,
# so a write that fails to commit is a 500 and not a 201 for a missing row.
# `async def`, not `def`, although nothing here awaits: FastAPI runs a plain
# `def` dependency in its threadpool, a hop that costs more per request than
# the whole middleware stack.
async def get_use_cases(request: Request, session: DbSession) -> {{ Module }}UseCases:
    tenant_id = getattr(request.state, "tenant_id", None)
    return {{ Module }}UseCases(Sql{{ Module }}Repository(session, tenant_id=tenant_id))


@router.get("", response_model=list[{{ Module }}Read], summary="List {{ module }}")
async def list_endpoint(
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
    use_cases: {{ Module }}UseCases = Depends(get_use_cases),
) -> list[{{ Module }}Read]:
    page = await use_cases.list(limit=limit, offset=offset)
    return [{{ Module }}Read.model_validate(entity) for entity in page.items]


@router.get("/{item_id}", response_model={{ Module }}Read, summary="Get one {{ module }}")
async def get_endpoint(
    item_id: int,
    use_cases: {{ Module }}UseCases = Depends(get_use_cases),
) -> {{ Module }}Read:
    return {{ Module }}Read.model_validate(await use_cases.get(item_id))


@router.post(
    "",
    response_model={{ Module }}Read,
    status_code=status.HTTP_201_CREATED,
    summary="Create a {{ module }}",
)
async def create_endpoint(
    payload: {{ Module }}Create,
    use_cases: {{ Module }}UseCases = Depends(get_use_cases),
) -> {{ Module }}Read:
    return {{ Module }}Read.model_validate(await use_cases.create(payload))


@router.patch("/{item_id}", response_model={{ Module }}Read, summary="Update a {{ module }}")
async def update_endpoint(
    item_id: int,
    payload: {{ Module }}Update,
    use_cases: {{ Module }}UseCases = Depends(get_use_cases),
) -> {{ Module }}Read:
    return {{ Module }}Read.model_validate(await use_cases.update(item_id, payload))


@router.delete(
    "/{item_id}",
    status_code=status.HTTP_204_NO_CONTENT,
    summary="Delete a {{ module }}",
)
async def delete_endpoint(
    item_id: int,
    use_cases: {{ Module }}UseCases = Depends(get_use_cases),
) -> None:
    await use_cases.delete(item_id)
