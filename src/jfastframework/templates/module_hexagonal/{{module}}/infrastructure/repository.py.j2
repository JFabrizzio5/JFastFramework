from ..domain.ports import {{ Module }}Page
from .orm import {{ Module }}Row, to_columns

if TYPE_CHECKING:
    from ..domain.ports import {{ Module }}Repository


class _{{ Module }}Rows(BaseRepository[{{ Module }}Row]):
    """Row-level access. Private: rows do not leave this module."""

    model = {{ Module }}Row


class Sql{{ Module }}Repository:
    def __init__(self, session: AsyncSession, *, tenant_id: str | None = None) -> None:
        self.rows = _{{ Module }}Rows(session, tenant_id=tenant_id)

    async def list(
        self, *, limit: int = 50, offset: int = 0, with_total: bool = True
    ) -> {{ Module }}Page:
        # `with_total=False` skips the COUNT and pays for one extra row
        # instead. Pass it from any caller that renders a "next" button rather
        # than "1-50 of 4,812".
        page = await self.rows.paginate(limit=limit, offset=offset, with_total=with_total)
        return {{ Module }}Page(
            items=[row.to_domain() for row in page.items],
            total=page.total,
            limit=page.limit,
            offset=page.offset,
            more=page.more,
        )

    async def get(self, item_id: int) -> {{ Module }} | None:
        row = await self.rows.get(item_id)
        return row.to_domain() if row is not None else None

{% for unique in uniques %}
    {{ fit("async def " ~ unique.port_finder ~ "(", ["self"] + unique.parameter_list, ") -> " ~ Module ~ " | None:", indent=4) }}
        row = await self.rows.find_one({{ unique.keywords }})
        return row.to_domain() if row is not None else None

{% endfor %}
    async def add(self, entity: {{ Module }}) -> {{ Module }}:
        row = await self.rows.create(**to_columns(entity))
        return row.to_domain()

    async def save(self, entity: {{ Module }}) -> {{ Module }}:
        # get_or_raise rather than get: the row can be gone by the time a use
        # case writes back what it read, and creating one here would resurrect
        # a deleted {{ module }} under a new id.
        row = await self.rows.get_or_raise(entity.id)
        return (await self.rows.update(row, **to_columns(entity))).to_domain()

    async def remove(self, item_id: int) -> None:
        await self.rows.delete(await self.rows.get_or_raise(item_id))


if TYPE_CHECKING:
    # Static proof the adapter still satisfies the port. A signature that
    # drifts fails type-checking on this line rather than at runtime in
    # production, which is the reason the port is a typed Protocol and not a
    # convention written in a README.
    def _satisfies_port(repository: Sql{{ Module }}Repository) -> {{ Module }}Repository:
        return repository
