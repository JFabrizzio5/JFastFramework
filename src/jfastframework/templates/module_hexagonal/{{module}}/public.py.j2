"""The {{ module_title }} module's public facade.

The only file another module may import from this one. Everything else here --
the domain, the use cases, the adapters -- is private, and `jfast contracts
check` rejects an import of it from outside.

Three rules keep this file worth having:

* **It returns DTOs, never an entity or a row.** The entity is this module's
  to change; a DTO is a promise to its callers, and the two should not move
  together by accident.
* **It takes the caller's session and an explicit tenant_id.** The read joins
  the caller's transaction instead of opening a second one, and the tenant is
  an argument rather than something inferred from a request that a worker or
  another module does not have.
* **Queries only.** To make another module react to something that happened
  here, publish an event through the outbox; do not call back into it.

Like ``build_service`` this is a composition root, the one other place allowed
to name the concrete adapter. A caller in another hexagonal module should reach
it from an infrastructure adapter behind a port of its own, so its application
layer keeps depending on its domain alone.

The payoff comes later: when this module becomes its own service, this file
becomes an HTTP client with the same signatures, and no caller changes.

A caller declares the dependency in contracts.toml:

    [modules.<caller>]
    depends_on = ["{{ module }}"]
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import TYPE_CHECKING

from .infrastructure.repository import Sql{{ Module }}Repository

if TYPE_CHECKING:
    from sqlalchemy.ext.asyncio import AsyncSession


@dataclass(frozen=True, slots=True)
class {{ Module }}Summary:
    """What other modules may know about a {{ module }}. Add fields deliberately."""

    id: int
    name: str
    is_active: bool


async def get_{{ module }}(
    session: AsyncSession, *, tenant_id: str | None, {{ module }}_id: int
) -> {{ Module }}Summary | None:
    """One {{ module }}, or None when it does not exist for this tenant."""
    # Through the port's adapter, which already turns rows into entities: the
    # facade only decides which of the entity's fields are promised outside.
    # A write added here calls the use case, so the rules run whoever asked.
    entity = await Sql{{ Module }}Repository(session, tenant_id=tenant_id).get({{ module }}_id)
    if entity is None or entity.id is None:
        return None
    return {{ Module }}Summary(id=entity.id, name=entity.name, is_active=entity.is_active)
