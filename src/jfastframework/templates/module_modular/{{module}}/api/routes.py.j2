"""HTTP layer for the {{ module_title }} module.

Routes do three things: validate input, call the service, shape the response.
Business logic belongs in ``services/``, the rules it enforces in
``validations/``, data access in ``repositories/``.
"""

from __future__ import annotations

from fastapi import APIRouter, Depends, Query, Request, status

from jfastframework.plugins.builtin.database import DbSession

from ..models import {{ Module }}Create, {{ Module }}Read, {{ Module }}Update
from ..repositories import {{ Module }}Repository
from ..services import {{ Module }}Service

router = APIRouter(prefix="/{{ table }}", tags=["{{ module }}"])


# DbSession commits when the endpoint returns, before the response is sent,
# so a write that fails to commit is a 500 and not a 201 for a missing row.
def get_service(request: Request, session: DbSession) -> {{ Module }}Service:
    tenant_id = getattr(request.state, "tenant_id", None)
    return {{ Module }}Service({{ Module }}Repository(session, tenant_id=tenant_id))


@router.get("", response_model=list[{{ Module }}Read], summary="List {{ module }}")
async def list_{{ module }}(
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
    service: {{ Module }}Service = Depends(get_service),
) -> list[{{ Module }}Read]:
    page = await service.list(limit=limit, offset=offset)
    return [{{ Module }}Read.model_validate(item, from_attributes=True) for item in page.items]


@router.get("/{item_id}", response_model={{ Module }}Read, summary="Get one {{ module }}")
async def get_{{ module }}(
    item_id: int,
    service: {{ Module }}Service = Depends(get_service),
) -> {{ Module }}Read:
    item = await service.get(item_id)
    return {{ Module }}Read.model_validate(item, from_attributes=True)


@router.post(
    "",
    response_model={{ Module }}Read,
    status_code=status.HTTP_201_CREATED,
    summary="Create a {{ module }}",
)
async def create_{{ module }}(
    payload: {{ Module }}Create,
    service: {{ Module }}Service = Depends(get_service),
) -> {{ Module }}Read:
    item = await service.create(payload)
    return {{ Module }}Read.model_validate(item, from_attributes=True)


@router.patch("/{item_id}", response_model={{ Module }}Read, summary="Update a {{ module }}")
async def update_{{ module }}(
    item_id: int,
    payload: {{ Module }}Update,
    service: {{ Module }}Service = Depends(get_service),
) -> {{ Module }}Read:
    item = await service.update(item_id, payload)
    return {{ Module }}Read.model_validate(item, from_attributes=True)


@router.delete(
    "/{item_id}",
    status_code=status.HTTP_204_NO_CONTENT,
    summary="Delete a {{ module }}",
)
async def delete_{{ module }}(
    item_id: int,
    service: {{ Module }}Service = Depends(get_service),
) -> None:
    await service.delete(item_id)
