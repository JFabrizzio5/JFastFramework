"""Enums for the {{ module }} module.

A flat file, not a package: an enum is one name and one list of values, and
wrapping each in its own module buys nothing. Values only this module speaks.
The moment a second module needs one, move it to `shared/enums.py` -- `jfast
contracts check` reports the cross-import and says so, so you do not have to
predict which ones those will be.

Two rules worth keeping:

**The value is the wire format.** It is stored in a column, serialised into
JSON and read by a frontend. Renaming a member is free; changing its value is a
data migration.

**`StrEnum`, not `Enum`.** A plain Enum serialises as `Status.DRAFT` in some
paths and `"DRAFT"` in others. A `StrEnum` member is its value everywhere,
including in JSON, in SQL and in an f-string.
"""

from __future__ import annotations
{% if example %}

from enum import StrEnum


class {{ Module }}Stage(StrEnum):
    """Example, named so it does not collide with the enum you meant to add.

    Replace it: `jfast new enum {{ Module }}Status --module {{ module }}`.
    """

    DRAFT = "draft"
    ACTIVE = "active"
    ARCHIVED = "archived"
