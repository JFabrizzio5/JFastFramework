def ensure_can_deactivate(item: Any) -> None:
    """Reject deactivating a {{ module }} that is already inactive.

    A schema cannot express this: ``is_active=False`` is a valid field value.
    Whether it is a valid *transition* depends on the row being written.
    """
    if not item.is_active:
        raise ValidationError(f"{{ Module }} {item.id!r} is already inactive")
