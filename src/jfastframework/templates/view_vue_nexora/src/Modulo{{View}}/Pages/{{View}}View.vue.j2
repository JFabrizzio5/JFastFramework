[# Scaffold-time values use square brackets; Vue keeps its own {{ }}. #]
<template>
  <LayoutAuthenticated>
    <SectionMain>
      <SectionTitleLineWithButton :icon="mdiViewDashboardOutline" title="[[ view_title ]]" main>
        <BaseButton variant="outline" :loading="loading" @click="fetchData">Refresh</BaseButton>
      </SectionTitleLineWithButton>

      <CardBox>
        <SkeletonLoader v-if="loading && !items.length" :lines="4" />
        <p v-else-if="error" class="form-error" role="alert">{{ error }}</p>
        <EmptyState v-else-if="!items.length" :icon="mdiViewDashboardOutline" title="Nothing here yet"
          description="Records from [[ view_path ]] are listed here as soon as the API returns one." />
        <div v-else class="table-responsive">
          <table class="erp-table">
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="item in items" :key="item.id">
                <td class="cell-title">{{ item.name }}</td>
                <td class="nx-dim">{{ item.description }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </CardBox>
    </SectionMain>
  </LayoutAuthenticated>
</template>

<script setup>
import { mdiViewDashboardOutline } from '@mdi/js'
import { onMounted, ref } from 'vue'

import BaseButton from '@/components/BaseButton.vue'
import CardBox from '@/components/CardBox.vue'
import EmptyState from '@/components/EmptyState.vue'
import SectionMain from '@/components/SectionMain.vue'
import SectionTitleLineWithButton from '@/components/SectionTitleLineWithButton.vue'
import SkeletonLoader from '@/components/SkeletonLoader.vue'
import LayoutAuthenticated from '@/layouts/LayoutAuthenticated.vue'
import { list[[ View ]] } from '@/Modulo[[ View ]]/Services/[[ view_slug ]].service.js'

const items = ref([])
const loading = ref(false)
const error = ref(null)

// HTTP lives in the service, not here. The component owns loading and error
// state; the service owns the request.
const fetchData = async () => {
  loading.value = true
  error.value = null
  try {
    items.value = await list[[ View ]]()
  } catch (err) {
    error.value = err.message
  } finally {
    loading.value = false
  }
}

onMounted(fetchData)
</script>
