# ---------------------------------------------------------------------------
# Placement: how modules talk to each other.
#
# Queries through a facade, effects through events, nothing through shared/.
#
# A module that needs another's data imports modules/<other>/public.py and
# nothing else of it: a few functions that take the caller's session and an
# explicit tenant_id and return DTOs. Reaching into another module's services,
# repositories or entities makes the two one module with a folder between
# them -- neither can be extracted into a service later, and a change to one
# breaks the other in a way no test covers. Raw SQL against a table another
# module owns is the same coupling with nothing to see it, so it is reported
# too. To react to something another module did, subscribe to its event
# through the outbox instead of being called.
#
# shared/ is vocabulary only: the enum, type or pure function two modules both
# speak -- and the check names the file when that is what was imported. The
# direction is one-way: modules import shared/, shared/ imports no module.
# Without that, shared/ becomes where everything ends up and the graph is a
# circle.
#
# One switch for every rule here: cross-module, undeclared-dependency,
# module-cycle, public-leak, cross-module-sql and shared-direction.
# ---------------------------------------------------------------------------

[rules.placement]
enabled = true

[layers.shared]
paths = ["shared/*.py"]
# Empty, and it is the entry that makes every other one safe. Each layer above
# may import shared/; the moment shared/ could import one of them back, the
# graph is a circle and shared/ becomes where everything ends up.
may_import = []
forbid_packages = ["sqlalchemy", "fastapi"]
description = "Enums, types and pure functions more than one module needs."

# ---------------------------------------------------------------------------
# Event-loop safety.
#
# A blocking call inside `async def` does not raise and does not log. It stalls
# every other request on the worker for its duration, and the symptom shows up
# as latency on endpoints that have nothing to do with the cause.
# ---------------------------------------------------------------------------

[rules.async_safety]
enabled = true
# Two rules share this table. `naive-datetime` is not about the event loop at
# all -- it rejects a datetime built with no time zone, whose meaning is
# whatever zone the process happens to run in. It gets its own switch so that
# silencing it does not silence the async check with it.
naive_datetime = true
allow_in = ["tests/*", "conftest.py", "scripts/*", "migrations/*"]
follow_local_helpers = true

[rules.async_safety.extra_blocking]
# "myapp.legacy.render_pdf" = "await asyncio.to_thread(render_pdf, ...)"

# ---------------------------------------------------------------------------
# Invariants the checker cannot verify.
# ---------------------------------------------------------------------------

[invariants]
rules = [
  "A port is defined in the domain and implemented in infrastructure. Never the reverse.",
  "The domain test suite runs with no database and no network.",
  "Money is stored in minor units as an integer. Never a float.",
  "TODO: replace these with the rules that actually matter here.",
]

# ---------------------------------------------------------------------------
# Modules: whose public.py each module may call.
#
# One block per module. depends_on lists the modules whose
# modules/<name>/public.py this one may import; a module with no block depends
# on nothing. `jfast new module` appends an empty block for every module it
# generates, so adding an edge is always a line a reviewer sees change.
#
# The blocks together are the module graph. `jfast contracts check` rejects a
# call to a facade that is not listed here (undeclared-dependency) and any
# cycle (module-cycle): two modules that call each other cannot be extracted
# apart. Break a cycle by turning one direction into an event: the upstream
# module lists the event under publishes, the downstream one reacts with
# @subscribe("<type>") in its tasks.py and declares no depends_on for it.
# A subscription nobody declares publishing (orphan-subscription), an event a
# module builds without declaring it (undeclared-event) and a depends_on
# entry nothing uses (unused-dependency) are reported too.
#
#     [modules.advisor]
#     depends_on = ["receipt", "wallet"]
#
#     [modules.receipt]
#     publishes = ["receipt.registered"]
# ---------------------------------------------------------------------------
