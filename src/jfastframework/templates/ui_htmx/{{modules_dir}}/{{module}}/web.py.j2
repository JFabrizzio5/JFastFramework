"""HTML surface for {{ module_title }}, rendered server-side with HTMX.

Layout-agnostic: it talks to ``build_service``, the factory every module layout
exposes, so this file is identical whether the module is layered or screaming.

Partial rendering is the whole trick. A browser navigation to `/{{ table }}`
gets the full page; an ``hx-get`` from the page gets only the rows fragment.
One handler, one context, no duplicated markup.
"""

from __future__ import annotations

from fastapi import APIRouter, Form, Query, Request, Response, status

from jfastframework.plugins.builtin.database import DbSession

from . import CreatePayload, build_service

# /ui/ rather than /{{ table }}: the JSON router already owns that path and
# declares the same verbs on it. Two routers on one prefix means the one
# registered first answers, so browsing returned JSON and the form POSTed
# into the API handler.
router = APIRouter(prefix="/ui/{{ table }}", tags=["{{ module }}-web"])

PAGE = "{{ module }}/index.html"
ROWS = "{{ module }}/_rows.html"
ROW = "{{ module }}/_row.html"


def _services(request: Request, session):
    tenant_id = getattr(request.state, "tenant_id", None)
    return build_service(session, tenant_id), request.app.state.jfast.require("render")


@router.get("", response_class=Response, summary="{{ module_title }} page")
async def index(
    request: Request,
    session: DbSession,
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
) -> Response:
    service, render = _services(request, session)
    page = await service.list(limit=limit, offset=offset)
    return render(request, PAGE, {"page": page}, partial=ROWS)


@router.post("", response_class=Response, summary="Create from the form")
async def create(
    request: Request,
    session: DbSession,
    name: str = Form(...),
    description: str = Form(""),
) -> Response:
    service, render = _services(request, session)
    # The validated model, not a dict. Every layout's service reads attributes
    # off its payload, so a dict reached `payload.name` and raised
    # AttributeError on the first form submission -- the one path a browser
    # takes, and the one no test covered.
    row = await service.create(CreatePayload(name=name, description=description or None))
    # Return just the new row: HTMX swaps it into the table with hx-swap.
    return render(request, ROW, {"item": row}, status_code=status.HTTP_201_CREATED)


@router.delete("/{item_id}", response_class=Response, summary="Delete from the table")
async def delete(
    request: Request,
    session: DbSession,
    item_id: int,
) -> Response:
    service, _ = _services(request, session)
    await service.delete(item_id)
    # Empty body plus hx-swap="outerHTML" on the row removes it from the DOM.
    return Response(status_code=status.HTTP_200_OK)
