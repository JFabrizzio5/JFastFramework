async def test_create_surfaces_domain_rules_as_validation_errors(
    use_cases: {{ Module }}UseCases,
) -> None:
    with pytest.raises(ValidationError):
        await use_cases.create(first() | {"{{ violations[0].name }}": {{ violations[0].too_long }}})


async def test_update_revalidates_the_merged_entity(use_cases: {{ Module }}UseCases) -> None:
    row = await use_cases.create(first())
    with pytest.raises(ValidationError):
        await use_cases.update(row.id, {"{{ violations[0].name }}": {{ violations[0].too_long }}})
