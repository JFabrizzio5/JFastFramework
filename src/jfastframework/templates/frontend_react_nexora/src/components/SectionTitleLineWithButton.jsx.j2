import BaseIcon from '@/components/BaseIcon.jsx'
import { APP_NAME } from '@/nexora/brand.js'

// The same props as every JFast frontend, so a page generated by
// `jfast new view` renders in either look. `eyebrow` and `description` are
// Nexora's additions: the mono label over the title, and one line under it.
export default function SectionTitleLineWithButton({
  title,
  icon,
  main = false,
  eyebrow = null,
  description = null,
  children,
}) {
  const Heading = main ? 'h1' : 'h2'
  return (
    <div className="page-header-row">
      <div className="page-title">
        {icon || eyebrow ? (
          <span className="nx-eyebrow">
            {icon ? <BaseIcon path={icon} size="sm" /> : null}
            {eyebrow ?? APP_NAME}
          </span>
        ) : null}
        <Heading>{title}</Heading>
        {description ? <p>{description}</p> : null}
      </div>
      {children ? <div className="page-actions">{children}</div> : null}
    </div>
  )
}
