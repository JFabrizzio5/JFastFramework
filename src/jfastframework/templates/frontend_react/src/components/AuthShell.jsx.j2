import CardBox from '@/components/CardBox.jsx'

/**
 * Every signed-out page -- sign in, sign up, the email links, the second step
 * -- is drawn inside this one frame, so the look lives in one file. Another
 * look ships its own AuthShell.jsx with the same props; the pages do not know
 * which one they got.
 *
 * `eyebrow`, `hero`, `heroFaded` and `heroText` feed a look with a hero
 * beside the form; this card has none and ignores them.
 */
export default function AuthShell({ title, lead = '', footer = null, children }) {
  const appName = import.meta.env.VITE_APP_NAME
  return (
    <div className="flex min-h-full items-center justify-center bg-surface p-4 text-ink">
      <CardBox className="w-full max-w-sm">
        <h1 className="text-lg font-semibold">{title}</h1>
        <p className="mt-1 mb-6 text-sm text-ink-faint">{lead || appName}</p>
        {children}
        {footer && <div className="mt-6 flex flex-col gap-2 text-sm text-ink-soft">{footer}</div>}
      </CardBox>
    </div>
  )
}
