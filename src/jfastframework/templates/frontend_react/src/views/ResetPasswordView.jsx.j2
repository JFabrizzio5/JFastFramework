import { useEffect, useRef, useState } from 'react'
import { useNavigate, useSearchParams } from 'react-router-dom'

import AuthShell from '@/components/AuthShell.jsx'
import BaseButton from '@/components/BaseButton.jsx'
import BaseInput from '@/components/BaseInput.jsx'
import { resetPassword } from '@/services/auth.service.js'
import { LOGIN_ROUTE } from '@/stores/auth.store.js'

/**
 * Where the link in the reset email lands: /reset-password?token=...
 * ([plugin.accounts] reset_password_path). The token is read once and taken
 * out of the address bar, so it is not left in the history or sent on as a
 * Referer by the next link clicked.
 */
export default function ResetPasswordView() {
  const navigate = useNavigate()
  const [params] = useSearchParams()
  const token = useRef(params.get('token') ?? '')
  const [password, setPassword] = useState('')
  const [error, setError] = useState('')
  const [pending, setPending] = useState(false)
  const [done, setDone] = useState(false)

  useEffect(() => {
    navigate('/reset-password', { replace: true })
  }, [navigate])

  async function submit(event) {
    event.preventDefault()
    setError('')
    setPending(true)
    try {
      await resetPassword(token.current, password)
      setDone(true)
    } catch (failure) {
      setError(failure.message)
    } finally {
      setPending(false)
    }
  }

  return (
    <AuthShell
      title={done ? 'Password changed' : 'Choose a new password'}
      eyebrow="Password"
      hero={done ? 'All set.' : 'New password.'}
      lead={
        done
          ? 'You are signed out everywhere. Sign in with the new password.'
          : 'Choosing it signs you out on every device.'
      }
    >
      {done ? (
        <BaseButton className="w-full" onClick={() => navigate(LOGIN_ROUTE, { replace: true })}>
          Sign in
        </BaseButton>
      ) : (
        <form noValidate className="flex flex-col gap-4" onSubmit={submit}>
          <BaseInput
            label="New password"
            type="password"
            autoComplete="new-password"
            required
            error={error}
            value={password}
            onChange={(event) => setPassword(event.target.value)}
          />
          <BaseButton type="submit" className="mt-2 w-full" loading={pending}>
            Change password
          </BaseButton>
        </form>
      )}
    </AuthShell>
  )
}
