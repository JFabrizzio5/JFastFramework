import { useState } from 'react'
import { Link } from 'react-router-dom'

import AuthShell from '@/components/AuthShell.jsx'
import BaseButton from '@/components/BaseButton.jsx'
import BaseInput from '@/components/BaseInput.jsx'
import { forgotPassword } from '@/services/auth.service.js'
import { LOGIN_ROUTE } from '@/stores/auth.store.js'

/**
 * The backend answers the same whether or not the address has an account, and
 * so does this page: "if it has one". Saying more would tell anybody who types
 * an address whether its owner is a customer.
 */
export default function ForgotPasswordView() {
  const [email, setEmail] = useState('')
  const [sent, setSent] = useState(false)
  const [error, setError] = useState('')
  const [pending, setPending] = useState(false)

  async function submit(event) {
    event.preventDefault()
    setError('')
    setPending(true)
    try {
      await forgotPassword(email)
      setSent(true)
    } catch (failure) {
      setError(failure.message)
    } finally {
      setPending(false)
    }
  }

  return (
    <AuthShell
      title="Reset your password"
      eyebrow="Password"
      hero="Forgot it?"
      heroFaded="It happens."
      lead={
        sent
          ? `If ${email} has an account, a link to choose a new password is on its way. It works once, for a short while.`
          : 'We will email you a link to choose a new one.'
      }
      footer={
        <Link to={LOGIN_ROUTE} className="hover:text-ink">
          Back to sign in
        </Link>
      }
    >
      {!sent && (
        <form noValidate className="flex flex-col gap-4" onSubmit={submit}>
          <BaseInput
            label="Email"
            type="email"
            autoComplete="email"
            required
            error={error}
            value={email}
            onChange={(event) => setEmail(event.target.value)}
          />
          <BaseButton type="submit" className="mt-2 w-full" loading={pending}>
            Send the link
          </BaseButton>
        </form>
      )}
    </AuthShell>
  )
}
