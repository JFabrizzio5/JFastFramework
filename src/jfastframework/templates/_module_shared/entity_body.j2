  The table: its columns and its unique keys. Rendered inside the class body
  of every layout's entity or row, which differ only in their name and bases.
  `entity_class` and `entity_bases` come from the including file's `set`,
  and the include goes on the line right after the last import: this file
  writes the blank lines, because how many depends on what comes first.
#}
{% if spec.needs_jsonb %}

# JSONB on PostgreSQL, where it can be indexed and compared; plain JSON on any
# other backend, so the in-memory SQLite a test may use still creates the table.
JSON_COLUMN = JSON().with_variant(JSONB(), "postgresql")
{% endif %}
{% if spec.enum_fields %}


def _by_value(enum: type[StrEnum]) -> Enum:
    """A column holding a member's value -- the wire format -- rather than its name.

    VARCHAR with a CHECK (``_one_of``), not a native PostgreSQL ENUM: a new
    member is then a migration that replaces one CHECK, not an ALTER TYPE, and
    the in-memory SQLite a test may use creates the same table.
    """
    return Enum(
        enum,
        native_enum=False,
        values_callable=lambda members: [member.value for member in members],
    )


def _one_of(column: str, enum: type[StrEnum]) -> str:
    """``tipo IN ('personal', 'empresa')``: the CHECK that keeps a column to an enum.

    Autogenerate does not compare CHECK constraints, so a member added to the
    enum needs a migration that drops ``ck_<table>_<column>`` and creates it
    again with this text.
    """
    values = ", ".join("'" + member.value.replace("'", "''") + "'" for member in enum)
    return f"{column} IN ({values})"
{% endif %}


