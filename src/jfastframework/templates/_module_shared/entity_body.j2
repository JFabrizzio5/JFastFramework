        # The rule the service checks, made true by the database: two requests
        # can both pass the check, only one can pass the constraint. tenant_id
        # first, and NULLS NOT DISTINCT so it also holds for rows with no tenant
        # (PostgreSQL 15+). Named, because the naming convention would give
        # every tenant-first constraint on this table the same name.
{% for unique in uniques %}
{% if unique.nullable_names %}
        # {{ unique.nullable_names|join(", ") }} may be empty, and an empty value is not a
        # value: two rows without one do not collide. A partial index, because
        # NULLS NOT DISTINCT would treat every missing value as the same one.
        Index(
            "{{ unique.constraint_name }}",
{% for column in ["tenant_id"] + unique.names|list %}
            "{{ column }}",
{% endfor %}
            unique=True,
            postgresql_nulls_not_distinct=True,
            postgresql_where=text("{{ unique.present }}"),
            sqlite_where=text("{{ unique.present }}"),
        ),
{% else %}
        UniqueConstraint(
{% for column in ["tenant_id"] + unique.names|list %}
            "{{ column }}",
{% endfor %}
            name="{{ unique.constraint_name }}",
            postgresql_nulls_not_distinct=True,
        ),
{% endif %}
{% endfor %}
{% endif %}
