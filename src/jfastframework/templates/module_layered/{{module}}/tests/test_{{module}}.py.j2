"""Tests for the {{ module_title }} module.

Service-level tests use a fake repository so they run without a database.
Router tests need the `database` plugin and a live PostgreSQL; mark them
`@pytest.mark.integration` and keep them out of the fast suite.

Run from the project root so that `modules` is importable::

    pytest modules/{{ module }}/tests
"""

from __future__ import annotations

import pytest

from jfastframework.errors import ConflictError, NotFoundError, PreconditionFailedError

from modules.{{ module }}.schemas import {{ Module }}Create, {{ Module }}Update
from modules.{{ module }}.service import {{ Module }}Service

# Explicit rather than relying on `asyncio_mode = auto`, so these tests pass in
# a project that has not configured pytest-asyncio yet.
pytestmark = pytest.mark.asyncio


class Fake{{ Module }}:
    def __init__(self, item_id: int, **values: object) -> None:
        self.id = item_id
        for key, value in values.items():
            setattr(self, key, value)


class FakeRepository:
    """In-memory stand-in for {{ Module }}Repository."""

    def __init__(self) -> None:
        self.items: dict[int, Fake{{ Module }}] = {}
        self._next_id = 1

    async def paginate(self, *, limit: int = 50, offset: int = 0, **_: object):
        from jfastframework.db import Page

        values = list(self.items.values())
        return Page(items=values[offset : offset + limit], total=len(values), limit=limit, offset=offset)

    async def get_or_raise(self, item_id: int) -> Fake{{ Module }}:
        try:
            return self.items[item_id]
        except KeyError:
            raise NotFoundError(f"{{ Module }} {item_id!r} not found") from None

    async def by_name(self, name: str) -> Fake{{ Module }} | None:
        return next((i for i in self.items.values() if i.name == name), None)

    async def create(self, **values: object) -> Fake{{ Module }}:
        item = Fake{{ Module }}(self._next_id, version=1, **values)
        self.items[self._next_id] = item
        self._next_id += 1
        return item

    async def update(
        self, instance: Fake{{ Module }}, *, expected_version: int | None = None, **values: object
    ) -> Fake{{ Module }}:
        if expected_version is not None and expected_version != instance.version:
            raise PreconditionFailedError("stale version")
        for key, value in values.items():
            setattr(instance, key, value)
        instance.version += 1
        return instance

    async def delete(self, instance: Fake{{ Module }}) -> None:
        self.items.pop(instance.id, None)


@pytest.fixture
def service() -> {{ Module }}Service:
    return {{ Module }}Service(FakeRepository())  # type: ignore[arg-type]


async def test_create_returns_persisted_item(service: {{ Module }}Service) -> None:
    item = await service.create({{ Module }}Create(name="first"))
    assert item.id == 1
    assert item.name == "first"


async def test_create_rejects_duplicate_name(service: {{ Module }}Service) -> None:
    await service.create({{ Module }}Create(name="dup"))
    with pytest.raises(ConflictError):
        await service.create({{ Module }}Create(name="dup"))


async def test_get_missing_raises_not_found(service: {{ Module }}Service) -> None:
    with pytest.raises(NotFoundError):
        await service.get(404)


async def test_update_applies_only_set_fields(service: {{ Module }}Service) -> None:
    item = await service.create({{ Module }}Create(name="before", description="keep"))
    updated = await service.update(item.id, {{ Module }}Update(name="after"))
    assert updated.name == "after"
    assert updated.description == "keep"


async def test_update_with_a_stale_version_is_refused(service: {{ Module }}Service) -> None:
    item = await service.create({{ Module }}Create(name="shared"))
    await service.update(item.id, {{ Module }}Update(name="first save", version=1))
    with pytest.raises(PreconditionFailedError):
        await service.update(item.id, {{ Module }}Update(name="second save", version=1))


async def test_delete_removes_item(service: {{ Module }}Service) -> None:
    item = await service.create({{ Module }}Create(name="gone"))
    await service.delete(item.id)
    with pytest.raises(NotFoundError):
        await service.get(item.id)
