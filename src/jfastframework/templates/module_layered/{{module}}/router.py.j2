# A page nobody asked for is a table dump someone can ask for.
MAX_PAGE_SIZE = 200


{{ access_m.dependency("get_service", Module ~ "Service", Module ~ "Service(" ~ Module ~ "Repository(session, tenant_id=tenant_id))")|trim }}


@router.get("", response_model=list[{{ Module }}Read], summary="List {{ module }}")
async def list_{{ module }}(
    response: Response,
    limit: int = Query(50, ge=1, le=MAX_PAGE_SIZE),
    offset: int = Query(0, ge=0),
    service: {{ Module }}Service = Depends(get_service),
) -> list[{{ Module }}Read]:
    page = await service.list(limit=limit, offset=offset)
    # The body stays a list; the total rides in a header so a client can
    # page without a second request.
    if page.total is not None:
        response.headers["X-Total-Count"] = str(page.total)
    return [{{ Module }}Read.model_validate(item, from_attributes=True) for item in page.items]


@router.get("/{item_id}", response_model={{ Module }}Read, summary="Get one {{ module }}")
async def get_{{ module }}(
    item_id: int,
    service: {{ Module }}Service = Depends(get_service),
) -> {{ Module }}Read:
    item = await service.get(item_id)
    return {{ Module }}Read.model_validate(item, from_attributes=True)


