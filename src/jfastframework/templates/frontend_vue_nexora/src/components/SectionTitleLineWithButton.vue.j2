<template>
  <div class="page-header-row">
    <div class="page-title">
      <span v-if="icon || eyebrow" class="nx-eyebrow">
        <BaseIcon v-if="icon" :path="icon" size="sm" />
        {{ eyebrow ?? appName }}
      </span>
      <component :is="main ? 'h1' : 'h2'">{{ title }}</component>
      <p v-if="description">{{ description }}</p>
    </div>
    <div v-if="$slots.default" class="page-actions">
      <slot />
    </div>
  </div>
</template>

<script setup>
import BaseIcon from '@/components/BaseIcon.vue'
import { APP_NAME as appName } from '@/nexora/brand.js'

// The same three props as every JFast frontend, so a page generated by
// `jfast new view` renders in either look. `eyebrow` and `description` are
// Nexora's additions: the mono label over the title, and one line under it.
defineProps({
  title: { type: String, required: true },
  icon: { type: String, default: null },
  main: Boolean,
  eyebrow: { type: String, default: null },
  description: { type: String, default: null },
})
</script>
