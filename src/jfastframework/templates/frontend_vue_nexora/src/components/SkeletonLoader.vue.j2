<template>
  <div role="status" aria-busy="true">
    <span class="sr-only">{{ label }}</span>

    <div v-if="shape === 'circle'" class="nx-skeleton rounded-full" :class="size" aria-hidden="true" />

    <div v-else-if="shape === 'block'" class="nx-skeleton rounded-2xl" :class="height"
      aria-hidden="true" />

    <div v-else class="space-y-3" aria-hidden="true">
      <div v-for="line in lines" :key="line" class="nx-skeleton h-3 rounded-full"
        :class="line === lines && lines > 1 ? 'w-2/3' : 'w-full'" />
    </div>
  </div>
</template>

<script setup>
// Shape it like the content that is coming, otherwise the layout jumps when the
// data lands and the wait was for nothing.
//
// One sr-only announcement on the wrapper and the bars hidden: left visible to
// assistive tech, a five-line skeleton announces as five empty items.
//
// `height` and `size` take a Tailwind class, not a number. Tailwind reads class
// names out of the source at build time, so a computed `h-[240px]` built from a
// prop is invisible to it and compiles to no CSS at all.
defineProps({
  shape: { type: String, default: 'text' },
  lines: { type: Number, default: 3 },
  height: { type: String, default: 'h-32' },
  size: { type: String, default: 'size-10' },
  label: { type: String, default: 'Loading…' },
})
</script>
