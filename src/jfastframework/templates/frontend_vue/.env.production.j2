# Production build. Behind Caddy every backend lives under /api, whether or
# not there is a gateway — so this one value keeps working the day a second
# service appears and a gateway is generated.
#
# A relative URL also means no CORS and no rebuild per environment.
VITE_API_URL=/api
VITE_APP_NAME={{ service_title }}
# Milliseconds before a request gives up. Long enough for an endpoint that
# calls a language model; shorten it only if none of yours does.
VITE_API_TIMEOUT=60000
{% if frontend_template == "nexora" %}
# The accent for anyone who has not picked one in the app, as a hex colour
# in quotes -- unquoted, the # starts a comment: VITE_ACCENT="#3B82F6".
# Empty keeps Nexora's ruby.
VITE_ACCENT=
# The background for anyone who has not picked one in the app: liquid (the
# 3D ribbon), still (a 2D frame) or none. Empty is liquid.
VITE_BACKGROUND=
{% endif %}
