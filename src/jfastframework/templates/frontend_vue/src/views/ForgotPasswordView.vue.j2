<template>
  <AuthShell title="Reset your password" eyebrow="Password" hero="Forgot it?" hero-faded="It happens."
    :lead="sent ? `If ${email} has an account, a link to choose a new password is on its way. It works once, for a short while.` : 'We will email you a link to choose a new one.'">
    <form v-if="!sent" novalidate class="flex flex-col gap-4" @submit.prevent="submit">
      <BaseInput v-model="email" label="Email" type="email" autocomplete="email" required :error="error" />
      <BaseButton type="submit" class="mt-2 w-full" :loading="pending">Send the link</BaseButton>
    </form>
    <template #footer>
      <RouterLink :to="LOGIN_ROUTE" class="hover:text-ink">Back to sign in</RouterLink>
    </template>
  </AuthShell>
</template>

<script setup>
import { ref } from 'vue'
import { RouterLink } from 'vue-router'

import AuthShell from '@/components/AuthShell.vue'
import BaseButton from '@/components/BaseButton.vue'
import BaseInput from '@/components/BaseInput.vue'
import { LOGIN_ROUTE, useAuthStore } from '@/stores/auth.store.js'

// The backend answers the same whether or not the address has an account,
// and so does this page: "if it has one". Saying more would tell anybody who
// types an address whether its owner is a customer.
const auth = useAuthStore()
const email = ref('')
const sent = ref(false)
const error = ref(null)
const pending = ref(false)

async function submit() {
  error.value = null
  pending.value = true
  try {
    await auth.forgotPassword(email.value)
    sent.value = true
  } catch (failure) {
    error.value = failure.message
  } finally {
    pending.value = false
  }
}
</script>
