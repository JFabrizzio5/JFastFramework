<template>
  <AuthShell v-if="step === 'password'" title="Sign in" eyebrow="Secure sign-in" hero="Welcome back."
    hero-faded="Sign in to continue." hero-text="Your session stays on this device until you sign out or it expires.">
    <form novalidate class="flex flex-col gap-4" @submit.prevent="submitPassword">
      <BaseInput v-model="email" label="Email" type="email" autocomplete="username" required />
      <BaseInput v-model="password" label="Password" type="password" autocomplete="current-password"
        required :error="error" />
      <BaseButton type="submit" class="mt-2 w-full" :loading="pending">Sign in</BaseButton>
    </form>
    <div v-if="unverified" class="mt-4 text-sm text-ink-soft">
      <BaseButton variant="outline" class="w-full" :loading="resending" :disabled="resent" @click="resend">
        {{ resent ? 'Sent -- check your inbox' : 'Send the link again' }}
      </BaseButton>
    </div>

    <template v-if="features?.password_reset || features?.registration" #footer>
      <RouterLink v-if="features.password_reset" to="/forgot-password" class="hover:text-ink">
        Forgot your password?
      </RouterLink>
      <RouterLink v-if="features.registration" to="/register" class="hover:text-ink">
        No account yet? Create one
      </RouterLink>
    </template>
  </AuthShell>

  <AuthShell v-else title="Two-step verification" eyebrow="Second step" hero="One more step."
    hero-faded="Open your authenticator app." lead="Type the six-digit code from your authenticator app, or one of your recovery codes.">
    <form novalidate class="flex flex-col gap-4" @submit.prevent="submitCode">
      <BaseInput v-model="code" label="Code" inputmode="numeric" autocomplete="one-time-code" required
        :error="error" />
      <BaseButton type="submit" class="mt-2 w-full" :loading="pending">Verify</BaseButton>
    </form>
    <template #footer>
      <button type="button" class="text-left hover:text-ink" @click="restart">Use another account</button>
    </template>
  </AuthShell>
</template>

<script setup>
import { onMounted, ref } from 'vue'
import { RouterLink, useRoute, useRouter } from 'vue-router'

import AuthShell from '@/components/AuthShell.vue'
import BaseButton from '@/components/BaseButton.vue'
import BaseInput from '@/components/BaseInput.vue'
import { safeNext, useAuthStore } from '@/stores/auth.store.js'

const route = useRoute()
const router = useRouter()
const auth = useAuthStore()

const step = ref('password')
const email = ref('')
const password = ref('')
const code = ref('')
const mfaToken = ref(null)
const error = ref(null)
const pending = ref(false)
const features = ref(null)
const unverified = ref(false)
const resending = ref(false)
const resent = ref(false)

// Which links to offer -- forgotten password, sign-up -- is the backend's
// call (GET /auth/features), so a link never leads to a 404.
onMounted(async () => {
  features.value = await auth.loadFeatures()
})

// replace, not push: the back button must not return to a sign-in form that
// is already satisfied.
function done() {
  return router.replace(safeNext(route.query.next))
}

async function submitPassword() {
  error.value = null
  unverified.value = false
  pending.value = true
  try {
    const result = await auth.login({ email: email.value, password: password.value })
    if (result.status === 'mfa') {
      mfaToken.value = result.mfaToken
      password.value = ''
      step.value = 'mfa'
    } else if (result.status === 'enrol') {
      // History state, not the address: the token must not land in the
      // browser's history or a Referer header.
      await router.push({ name: 'mfa-enrol', query: route.query, state: { mfaToken: result.mfaToken } })
    } else {
      await done()
    }
  } catch (failure) {
    error.value = failure.message
    unverified.value = failure.code === 'email_not_verified'
  } finally {
    pending.value = false
  }
}

async function submitCode() {
  error.value = null
  pending.value = true
  try {
    await auth.completeMfa(mfaToken.value, code.value)
    await done()
  } catch (failure) {
    if (failure.code === 'mfa_token_invalid') {
      // Too many wrong codes, or too slow: the password has to be typed again.
      restart()
    }
    error.value = failure.message
  } finally {
    pending.value = false
  }
}

function restart() {
  step.value = 'password'
  mfaToken.value = null
  code.value = ''
  error.value = null
}

async function resend() {
  resending.value = true
  try {
    await auth.resendVerification(email.value)
    resent.value = true
  } catch (failure) {
    error.value = failure.message
  } finally {
    resending.value = false
  }
}
</script>
