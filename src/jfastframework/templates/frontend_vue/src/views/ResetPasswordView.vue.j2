<template>
  <AuthShell :title="done ? 'Password changed' : 'Choose a new password'" eyebrow="Password"
    :hero="done ? 'All set.' : 'New password.'"
    :lead="done ? 'You are signed out everywhere. Sign in with the new password.' : 'Choosing it signs you out on every device.'">
    <form v-if="!done" novalidate class="flex flex-col gap-4" @submit.prevent="submit">
      <BaseInput v-model="password" label="New password" type="password" autocomplete="new-password" required
        :error="error" />
      <BaseButton type="submit" class="mt-2 w-full" :loading="pending">Change password</BaseButton>
    </form>
    <BaseButton v-else class="w-full" @click="router.replace(LOGIN_ROUTE)">Sign in</BaseButton>
  </AuthShell>
</template>

<script setup>
import { onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import AuthShell from '@/components/AuthShell.vue'
import BaseButton from '@/components/BaseButton.vue'
import BaseInput from '@/components/BaseInput.vue'
import { LOGIN_ROUTE, useAuthStore } from '@/stores/auth.store.js'

// Where the link in the reset email lands: /reset-password?token=...
// ([plugin.accounts] reset_password_path). The token is read once and taken
// out of the address bar, so it is not left in the history or sent on as a
// Referer by the next link clicked.
const route = useRoute()
const router = useRouter()
const auth = useAuthStore()

const token = ref('')
const password = ref('')
const error = ref(null)
const pending = ref(false)
const done = ref(false)

onMounted(async () => {
  token.value = typeof route.query.token === 'string' ? route.query.token : ''
  await router.replace({ query: {} })
})

async function submit() {
  error.value = null
  pending.value = true
  try {
    await auth.resetPassword(token.value, password.value)
    done.value = true
  } catch (failure) {
    error.value = failure.message
  } finally {
    pending.value = false
  }
}
</script>
