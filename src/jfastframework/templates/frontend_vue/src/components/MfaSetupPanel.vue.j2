<template>
  <!-- 1. Start: the password, when signed in and the account has one. -->
  <form v-if="step === 'start'" novalidate class="flex flex-col gap-4" @submit.prevent="start">
    <p class="text-sm text-ink-soft">
      Use an authenticator app -- 1Password, Google Authenticator, Authy -- to get a
      six-digit code at every sign-in.
    </p>
    <BaseInput v-if="needsPassword" v-model="password" label="Current password" type="password"
      autocomplete="current-password" required :error="error" />
    <p v-else-if="error" class="text-sm text-brand-600" role="alert">{{ error }}</p>
    <BaseButton type="submit" class="w-full" :loading="pending">Set up the app</BaseButton>
  </form>

  <!-- 2. Scan, then prove it with a code. -->
  <form v-else-if="step === 'confirm'" novalidate class="flex flex-col gap-4" @submit.prevent="confirm">
    <p class="text-sm text-ink-soft">
      On this phone, <a :href="uri" class="font-medium text-brand-600 underline">open it in
      your authenticator app</a>. Elsewhere, add an account by hand with this key:
    </p>
    <code class="block rounded-lg bg-elevated px-3 py-2 text-center font-mono text-sm tracking-wider break-all
      text-ink">{{ grouped }}</code>
    <BaseInput v-model="code" label="The six-digit code the app shows" inputmode="numeric"
      autocomplete="one-time-code" maxlength="6" required :error="error" />
    <BaseButton type="submit" class="w-full" :loading="pending">Turn it on</BaseButton>
  </form>

  <!-- 3. The recovery codes: shown once, never again. -->
  <div v-else class="flex flex-col gap-4">
    <p class="text-sm text-ink-soft">
      Two-factor authentication is on. Keep these recovery codes somewhere safe: each one
      signs you in once if you lose your phone, and they are not shown again.
    </p>
    <ul class="grid grid-cols-2 gap-2 rounded-lg bg-elevated p-3 font-mono text-sm text-ink">
      <li v-for="item in codes" :key="item">{{ item }}</li>
    </ul>
    <BaseButton variant="outline" class="w-full" @click="copy">{{ copied ? 'Copied' : 'Copy the codes' }}</BaseButton>
    <BaseButton class="w-full" @click="emit('done')">I have saved them</BaseButton>
  </div>
</template>

<script setup>
import { computed, ref } from 'vue'

import BaseButton from '@/components/BaseButton.vue'
import BaseInput from '@/components/BaseInput.vue'
import { useAuthStore } from '@/stores/auth.store.js'

// Enrolment in three steps: start, scan and confirm, save the recovery codes.
// Used signed in (the Security page) and at sign-in for a role that requires
// MFA, where `mfaToken` stands in for the session the user does not have yet.
//
// No QR code is drawn: that would be a dependency for one image. The
// otpauth:// link opens the app on a phone, and the key can be typed on any
// other device. Add a QR library here if your users expect one.
const props = defineProps({
  mfaToken: { type: String, default: null },
})
const emit = defineEmits(['done'])

const auth = useAuthStore()
const step = ref('start')
const password = ref('')
const code = ref('')
const secret = ref('')
const uri = ref('')
const codes = ref([])
const error = ref(null)
const pending = ref(false)
const copied = ref(false)

// An account created through a provider has no password to ask for.
const needsPassword = computed(() => !props.mfaToken && auth.user?.has_password !== false)
const grouped = computed(() => secret.value.replace(/(.{4})/g, '$1 ').trim())

async function run(action) {
  error.value = null
  pending.value = true
  try {
    await action()
  } catch (failure) {
    error.value = failure.message
  } finally {
    pending.value = false
  }
}

function start() {
  return run(async () => {
    const data = await auth.mfaSetup({ password: password.value || null, mfaToken: props.mfaToken })
    secret.value = data.secret
    uri.value = data.otpauth_uri
    password.value = ''
    step.value = 'confirm'
  })
}

function confirm() {
  return run(async () => {
    codes.value = await auth.mfaConfirm(code.value, props.mfaToken)
    step.value = 'codes'
  })
}

async function copy() {
  try {
    await navigator.clipboard.writeText(codes.value.join('\n'))
    copied.value = true
  } catch {
    // No clipboard permission: the codes are on screen to copy by hand.
  }
}
</script>
