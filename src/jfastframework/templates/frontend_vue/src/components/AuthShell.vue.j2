<template>
  <div class="flex min-h-full items-center justify-center bg-surface p-4 text-ink">
    <CardBox class="w-full max-w-sm">
      <h1 class="text-lg font-semibold">{{ title }}</h1>
      <p class="mt-1 mb-6 text-sm text-ink-faint">{{ lead || appName }}</p>
      <slot />
      <div v-if="$slots.footer" class="mt-6 flex flex-col gap-2 text-sm text-ink-soft">
        <slot name="footer" />
      </div>
    </CardBox>
  </div>
</template>

<script setup>
import CardBox from '@/components/CardBox.vue'

// Every signed-out page -- sign in, sign up, the email links, the second step
// -- is drawn inside this one frame, so the look lives in one file. Another
// look ships its own AuthShell.vue with the same props; the pages do not know
// which one they got.
//
// `eyebrow`, `hero`, `heroFaded` and `heroText` feed a look with a hero
// beside the form; this card has none and ignores them.
defineProps({
  title: { type: String, required: true },
  lead: { type: String, default: '' },
  eyebrow: { type: String, default: '' },
  hero: { type: String, default: '' },
  heroFaded: { type: String, default: '' },
  heroText: { type: String, default: '' },
})

const appName = import.meta.env.VITE_APP_NAME
</script>
