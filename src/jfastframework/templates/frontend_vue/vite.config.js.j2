import { fileURLToPath, URL } from 'node:url'

import tailwindcss from '@tailwindcss/vite'
import vue from '@vitejs/plugin-vue'
import { defineConfig } from 'vite'

export default defineConfig({
  plugins: [vue(), tailwindcss()],
  resolve: {
    // '@' points at src/, which is what the generated module imports assume.
    alias: { '@': fileURLToPath(new URL('./src', import.meta.url)) },
  },
{% if frontend_template == "nexora" %}
  build: {
    // three.js is a chunk of its own, fetched after the first paint and only
    // where the ribbon will run (src/nexora/background.js). It is over Vite's
    // 500 kB warning by itself, and the warning is meant for the entry chunk.
    chunkSizeWarningLimit: 600,
  },
{% endif %}
  server: {
    port: {{ port }},
    // The API base URL comes from VITE_API_URL, written by `jfast` from the
    // workspace file. A proxy here would only mask CORS in development and
    // let it break in production instead.
  },
})
