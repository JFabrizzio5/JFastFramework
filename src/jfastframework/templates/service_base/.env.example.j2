# Copy to .env and fill in. Never commit .env.

JFAST_APP_NAME={{ service_slug }}
JFAST_ENV=local            # local | dev | staging | prod
JFAST_DEBUG=false          # true leaks exception messages to clients
JFAST_PORT={{ port }}

JFAST_LOG_LEVEL=INFO
{% if has_database %}

# database plugin — also read by migrations/env.py, so a migration can never
# run against a different database than the service.
JFAST_DB_DSN=postgresql+asyncpg://app:CHANGEME@localhost:{{ port + 1 }}/app
POSTGRES_PASSWORD=CHANGEME
{% endif %}
{% if has_cache %}

# cache plugin
JFAST_CACHE_URL=redis://localhost:{{ port + 3 }}/0
{% endif %}
{% if has_mongo %}

# mongo plugin
JFAST_MONGO_DSN=mongodb://root:CHANGEME@localhost:{{ port + 4 }}
MONGO_PASSWORD=CHANGEME
{% endif %}
{% if has_qdrant %}

# qdrant plugin
JFAST_QDRANT_URL=http://localhost:{{ port + 7 }}
{% endif %}
{% if has_auth %}

{% if has_accounts %}
# auth plugin -- mode = "secret": this service mints and verifies its tokens.
# Generate one:  openssl rand -hex 32
JFAST_AUTH_SECRET=CHANGEME-at-least-32-bytes-of-random
# accounts plugin -- the first admin's password, read on the first start only.
JFAST_ACCOUNTS_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME
{% else %}
# auth plugin -- verification only; issuance needs a private key
JFAST_AUTH_JWKS_URL=https://id.example.com/.well-known/jwks.json
JFAST_AUTH_ISSUER=https://id.example.com/
# For mode = "secret" instead (single service, HMAC):
# JFAST_AUTH_SECRET=CHANGEME-at-least-32-bytes-of-random
{% endif %}
{% endif %}
{% if has_llm %}

# llm plugin -- any OpenAI-compatible API.
JFAST_LLM_API_KEY=CHANGEME
{% endif %}
{% if has_telemetry %}

# telemetry plugin -- unset exports nothing. A local Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
{% endif %}
{% if has_rag %}

# rag plugin
JFAST_RAG_STORE={{ rag_store }}
JFAST_RAG_DIMENSIONS=768
JFAST_RAG_OLLAMA_URL=http://localhost:11434
{% endif %}

{% if has_storage %}

# storage plugin -- signs the temporary URLs that private disks hand out.
# Generate one:  openssl rand -hex 32
JFAST_STORAGE_SIGNING_KEY=CHANGEME
{% endif %}
{% if has_tenancy %}

# tenancy plugin -- acme.<base_domain> resolves to the tenant "acme".
# JFAST_TENANCY_BASE_DOMAIN=app.example.com
{% endif %}
{% if has_notifications %}

# notifications plugin -- only needed with backend = "fcm".
# JFAST_NOTIFICATIONS_PROJECT_ID=
{% endif %}

# sentry plugin (enable it in jfast.toml first)
# JFAST_SENTRY_DSN=
