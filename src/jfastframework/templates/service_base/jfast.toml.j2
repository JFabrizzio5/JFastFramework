# {{ service_title }} configuration.
# Committed to git -- never put secrets here. Secrets come from the
# environment and are typed SecretStr, which keeps them out of
# `jfast describe` and the /info endpoint.

[app]
name = "{{ service_slug }}"
version = "0.1.0"
env = "local"
port = {{ port }}
# The *business* zone: what "today" means for a report, an invoice period or a
# daily quota. Not the server's zone and not the container's -- rows are stored
# in UTC and every database session computes in UTC, so this is the only place
# a local day is decided. An unknown IANA name stops the boot.
timezone = "UTC"
{% if has_storage %}
# The kernel already resolves this pair for any service with `storage`
# enabled; written out because an upload limit is a decision, and a decision
# nobody can see in the config file is one nobody revisits. Lower both to
# what this service really accepts.
max_body_bytes = 26214400   # 25 MiB
request_timeout = 120.0
{% else %}
# Not set, so the kernel defaults apply: a 2 MiB body limit, a 30s request
# timeout, security headers on every response, and X-Forwarded-For believed
# only from loopback and the private ranges -- where the generated Caddy
# sits. max_body_bytes = 0 lifts the limit; see docs/deploy.md first.
{% endif %}

[plugins]
enabled = [{% for name in enabled_plugins %}"{{ name }}"{{ ", " if not loop.last }}{% endfor %}]
disabled = []

[plugin.observability]
level = "INFO"
json_logs = false   # readable in a dev terminal; set true in deployed envs

{% if has_database %}
[plugin.database]
# Per process, and the generated image runs one worker per CPU up to eight --
# so what this service can hold is (pool_size + max_overflow) x workers, 80
# here. server_max_connections is what the other end accepts; `jfast check`
# fails when the product goes past it, because the symptom otherwise is
# `FATAL: sorry, too many clients already`, raised against whichever service
# connected after this one rather than this one. 0 turns that check off.
pool_size = 5
max_overflow = 5
server_max_connections = 100
# DSN comes from JFAST_DB_DSN, not from here.
# Every session computes in this zone whatever the server is set to, so
# date_trunc('day', ...) and CURRENT_DATE answer the same on every replica.
# Change it only if something outside this service guarantees the server's.
session_timezone = "UTC"
{% endif %}
{% if has_cache %}

[plugin.cache]
default_ttl = 300
{% endif %}
{% if has_mongo %}

[plugin.mongo]
database = "{{ service_slug }}"
{% endif %}
{% if has_qdrant %}

[plugin.qdrant]
# URL comes from JFAST_QDRANT_URL.
{% endif %}
{% if has_rag %}

[plugin.rag]
store = "{{ rag_store }}"
collection = "rag_chunks"
dimensions = 768        # must match the embedding model
ollama_model = "nomic-embed-text"
{% if multitenant %}
# Every chunk carries its tenant and every search is filtered by it; a read
# or write with no tenant is refused rather than answered from everyone's.
tenant_scoped = true
{% else %}
# One customer: chunks carry no tenant. Turning tenancy on later means
# re-keying the chunks to a tenant and setting this to true.
tenant_scoped = false
{% endif %}
{% endif %}
{% if has_llm %}

[plugin.llm]
# The key comes from JFAST_LLM_API_KEY. Spending stops at the cap for the
# period instead of at the end of the month's invoice.
budget_usd = 10.0
budget_period = "month"
{% if multitenant %}
# Per tenant, within the same period, so one customer cannot spend the
# others' share. 0 turns the per-tenant cap off.
tenant_budget_usd = 2.0
{% endif %}
{% endif %}
{% if has_queue %}

[plugin.queue]
backend = "{{ queue_backend }}"   # postgres | redis | rabbitmq
name = "jfast_jobs"
max_attempts = 3
{% endif %}
{% if has_auth %}

[plugin.auth]
{% if has_accounts %}
# This service signs its own users in (the accounts plugin), so it also mints
# the tokens. HMAC with one secret is right while one service verifies them;
# move to an RS256 key pair and jwks once a second service has to.
# The secret comes from JFAST_AUTH_SECRET, at least 32 bytes.
mode = "secret"
algorithms = ["HS256"]
issue_tokens = true
{% else %}
# jwks       : fetch public keys from an identity service. Right for more than
#              one service -- no shared secret to leak.
# public_key : a pinned PEM. Same trust model, no network dependency.
# secret     : HMAC. Simple, and every holder can also MINT tokens.
mode = "jwks"
algorithms = ["RS256"]
# jwks_url comes from JFAST_AUTH_JWKS_URL.
issuer = ""
{% endif %}
audience = "{{ service_slug }}"   # without this, a token for any sibling service is accepted
{% endif %}
{% if has_accounts %}

[plugin.accounts]
# The first admin is created on the first start; its password comes from
# JFAST_ACCOUNTS_BOOTSTRAP_ADMIN_PASSWORD and never from this file.
bootstrap_admin_email = "admin@example.com"
allow_registration = {{ "true" if multitenant else "false" }}
{% endif %}
{% if has_telemetry %}

[plugin.telemetry]
# Exports nothing until OTEL_EXPORTER_OTLP_ENDPOINT is set, so it is free in
# development. Point it at a collector, Jaeger, Tempo, Honeycomb or Datadog.
{% endif %}
{% if has_events %}

[plugin.events]
bootstrap_servers = "localhost:{{ port + 2 }}"
consumer_group = "{{ service_slug }}"
{% endif %}
{% if has_web %}

[plugin.web]
templates_dir = "templates"
static_dir = "static"
auto_reload = true      # development only: stats the filesystem per render
{% endif %}

{% if has_storage %}

[plugin.storage]
default = "public"
serve_local = true      # development only: Caddy or a CDN serves these in prod
# signing_key comes from JFAST_STORAGE_SIGNING_KEY. Without it, private disks
# cannot produce a temporary URL and every download link fails.

[plugin.storage.disks.public]
driver = "local"
root = "storage/public"
visibility = "public"   # permanent URLs

[plugin.storage.disks.private]
driver = "local"
root = "storage/private"
visibility = "private"  # signed URLs that expire
{% endif %}
{% if has_tenancy %}

[plugin.tenancy]
# Ordered by trust: the first source that yields a tenant wins. "header" is
# absent on purpose -- X-Tenant-ID is one curl away from another tenant's data.
{% if multitenant %}
# token: the tenant claim of a signed token, when an organisation owns the
# data. user: the signed-in user is the tenant, when every account owns its
# own. Both are signed; neither can be chosen by the client.
{% endif %}
sources = [{% for source in tenancy_sources %}"{{ source }}"{{ ", " if not loop.last }}{% endfor %}]
{% if "subdomain" in tenancy_sources %}
# Required, or every hostname looks like a tenant and the service refuses to
# start. acme.<base_domain> then resolves to the tenant "acme".
base_domain = "localhost"
{% endif %}
# Routes generated here take the tenant from `current_tenant`, which answers
# 401/403 without one; this is for everything else, and false keeps /health
# and the sign-in routes reachable.
require_tenant = false
# One deployment, tenants in different countries, each seeing its own day
# boundaries. A tenant with no entry here uses [app] timezone.
# [plugin.tenancy.timezones]
# acme = "America/Santiago"
{% endif %}
{% if has_notifications %}

[plugin.notifications]
# console logs instead of sending: no Firebase project needed in development.
backend = "console"     # console | fcm
project_id = ""
{% endif %}

# Not enabled. Add the name to [plugins].enabled, and install its extra if
# it has one:
{% for name, extra in available_plugins %}
#   {{ "%-13s"|format(name) }} {{ 'pip install "jfastframework[%s]"'|format(extra) if extra else 'no extra needed' }}
{% endfor %}

# How `jfast new module` names tables: "en" (orders) or "es" (camiones,
# sucursales). --table overrides either for one module.
# [scaffold]
# language = "es"
