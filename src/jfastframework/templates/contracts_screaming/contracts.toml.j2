# Contracts for {{ Project }}.
#
# Declared by you. Enforced by `jfast contracts check`. Read by agents through
# `jfast contracts show --json`.
#
# The defaults below are a floor. The lines worth writing are the ones only you
# know: what this service does NOT own, which interfaces are promises, and the
# invariants a checker cannot see.

[project]
name = "{{ project }}"
language = "python"
owns = "TODO: one sentence. If it takes two, the service is doing two jobs."
does_not_own = "TODO: name the neighbouring concerns and who owns them."

# ---------------------------------------------------------------------------
# Layers. Imports point inward only: http -> use_cases -> domain, and the
# domain knows nothing but the vocabulary.
#
# `shared` is in every may_import below and in none of its own. That is not
# generosity: shared/ ships with the service and `[rules.placement]` further
# down tells you to move the twice-wanted enum into it, so a layer that cannot
# import shared/ has no legal way to follow the instruction the checker itself
# prints. It stays safe because shared/ is a leaf -- it imports no layer and no
# ORM -- so nothing reaches a database or a router through it.
# ---------------------------------------------------------------------------

[layers.domain]
description = "Entities and their rules. Framework-free."
paths = ["modules/*/[!_]*.py"]
# shared/ and nothing else, and this is the one worth arguing about. The domain
# is bought with a property -- an entity testable in microseconds with no
# database and no network -- and shared/ costs none of it: it forbids
# SQLAlchemy and FastAPI on itself and may import no layer. Leaving it off is
# the more expensive mistake here, because this pattern is the catch-all for
# module files: without it a `status: Status` field on the entity, which is the
# whole reason the enum went to shared/, is a violation.
may_import = ["shared"]
# This is the rule that keeps the screaming layout honest. A domain file that
# imports SQLAlchemy has stopped being a domain file.
forbid_packages = ["fastapi", "starlette", "sqlalchemy", "pydantic", "redis", "httpx"]

[layers.use_cases]
description = "One file per capability. Orchestrates the domain and a repository."
paths = ["modules/*/use_cases/*.py"]
may_import = ["domain", "shared"]
forbid_packages = ["fastapi", "starlette", "sqlalchemy"]

[layers.storage]
description = "SQLAlchemy model and repository. to_domain() is the seam."
paths = ["modules/*/storage.py"]
may_import = ["domain", "shared"]
forbid_packages = ["fastapi", "starlette"]

[layers.http]
description = "Router and wire schemas. Translates HTTP into use-case calls."
paths = ["modules/*/http.py", "modules/*/web.py"]
may_import = ["use_cases", "domain", "storage", "shared"]
# A handler that queries cannot be tested without a database, and the
# business logic follows the query in. The ORM belongs one layer down.
forbid_packages = ["sqlalchemy"]

[layers.public]
description = "The module's facade: the one file other modules may import. Returns DTOs, never entities."
paths = ["modules/*/public.py"]
# More specific than the domain's catch-all above, so the facade is not held
# to the domain's rules: it has to name storage to read, and a use case to
# write. It returns DTOs built from domain objects, never a row. Nothing inside
# the module imports it back -- it is the way out, not a shortcut in. Which
# layer of *another* module calls it is not a layer question: [modules.*]
# governs that edge.
may_import = ["use_cases", "storage", "domain", "shared"]

[layers.tasks]
description = "Background work and event subscribers the module owns: @task and @subscribe."
paths = ["modules/*/tasks.py", "modules/*/tasks/*.py"]
# An entry point like a route, so it reaches as far as a route does and no
# further: it calls the use cases, so a rule holds for a job exactly as it does for
# a request. The worker imports these files at boot, API or not; a task that
# builds a query or a response has taken a layer's job.
may_import = ["use_cases", "domain", "storage", "shared"]
forbid_packages = ["fastapi", "starlette", "sqlalchemy"]

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

[[rules.forbid_call]]
pattern = "os.getenv"
except_in = ["settings.py", "config/*.py", "migrations/env.py"]
why = "Configuration is typed. Add a field to a settings model so a bad value fails at boot."

[[rules.forbid_call]]
pattern = "print"
# scripts/ holds command-line entry points -- a seed, an e2e run, a one-off
# fix -- that a person runs in a terminal and reads: stdout is their interface,
# and there is no request for a structured log line to belong to. The async
# rules below exempt the same directory for the same reason.
except_in = ["scripts/**"]
why = "Use the structured logger; print output has no request id and no level."

[[rules.require]]
path = "tests"
applies_to = "modules/*"
why = "A module with no tests is a module nobody can change safely."

[[rules.require]]
path = "use_cases"
applies_to = "modules/*"
why = "The screaming layout is the point: capabilities are files, not methods."

[[rules.require]]
path = "README.md"
applies_to = "modules/*"
why = "One paragraph on what the module owns. If it takes two, split it."

# ---------------------------------------------------------------------------
# Interfaces
# ---------------------------------------------------------------------------

# [[provides]]
# name = "invoices-api"
# kind = "http"
# path = "/invoices"
# stability = "stable"    # experimental | stable | deprecated

# [[consumes]]
# name = "catalog"
# kind = "http"
# via_env = "API_CATALOG_URL"

# ---------------------------------------------------------------------------
# Placement: how modules talk to each other.
#
# Queries through a facade, effects through events, nothing through shared/.
#
# A module that needs another's data imports modules/<other>/public.py and
# nothing else of it: a few functions that take the caller's session and an
# explicit tenant_id and return DTOs. Reaching into another module's services,
# repositories or entities makes the two one module with a folder between
# them -- neither can be extracted into a service later, and a change to one
# breaks the other in a way no test covers. Raw SQL against a table another
# module owns is the same coupling with nothing to see it, so it is reported
# too. To react to something another module did, subscribe to its event
# through the outbox instead of being called.
#
# shared/ is vocabulary only: the enum, type or pure function two modules both
# speak -- and the check names the file when that is what was imported. The
# direction is one-way: modules import shared/, shared/ imports no module.
# Without that, shared/ becomes where everything ends up and the graph is a
# circle.
#
# One switch for every rule here: cross-module, undeclared-dependency,
# module-cycle, public-leak, cross-module-sql and shared-direction.
# ---------------------------------------------------------------------------

[rules.placement]
enabled = true

[layers.shared]
paths = ["shared/*.py"]
# Empty, and it is the entry that makes every other one safe. Each layer above
# may import shared/; the moment shared/ could import one of them back, the
# graph is a circle and shared/ becomes where everything ends up.
may_import = []
# Nothing here touches a database. Two modules sharing a repository is two
# modules sharing a table, which is how services become a distributed monolith.
forbid_packages = ["sqlalchemy", "fastapi"]
description = "Enums, types and pure functions more than one module needs."

# ---------------------------------------------------------------------------
# Event-loop safety.
#
# A blocking call inside `async def` does not raise and does not log. It stalls
# every other request on the worker for its duration, and the symptom shows up
# as latency on endpoints that have nothing to do with the cause. `jfast
# contracts check` reports them; ruff's ASYNC rules cover the standard library
# if you also run ruff.
#
# Waive one inline when blocking is genuinely correct:
#     time.sleep(0)  # contracts: allow one-off, at startup, not per request
# ---------------------------------------------------------------------------

[rules.async_safety]
enabled = true
# Two rules share this table. `naive-datetime` is not about the event loop at
# all -- it rejects a datetime built with no time zone, whose meaning is
# whatever zone the process happens to run in. It gets its own switch so that
# silencing it does not silence the async check with it.
naive_datetime = true
# Paths not worth checking. Replaces the default rather than adding to it, so
# what is listed here is the whole list.
allow_in = ["tests/*", "conftest.py", "scripts/*", "migrations/*"]
# Follow a synchronous helper defined in the same file into its async callers.
follow_local_helpers = true

# Calls in YOUR code that block, and what to reach for instead. The checker
# knows about boto3, pymongo, psycopg2, sync redis and sqlite3 already.
[rules.async_safety.extra_blocking]
# "myapp.legacy.render_pdf" = "await asyncio.to_thread(render_pdf, ...)"

# ---------------------------------------------------------------------------
# Invariants the checker cannot verify.
# ---------------------------------------------------------------------------

[invariants]
rules = [
  "A rule about one object's own state lives in the entity; a rule needing the repository lives in a use case.",
  "A new capability is a new file in use_cases/, not another method on an existing class.",
  "Money is stored in minor units as an integer. Never a float.",
  "TODO: replace these with the rules that actually matter here.",
]

# ---------------------------------------------------------------------------
# Modules: whose public.py each module may call.
#
# One block per module. depends_on lists the modules whose
# modules/<name>/public.py this one may import; a module with no block depends
# on nothing. `jfast new module` appends an empty block for every module it
# generates, so adding an edge is always a line a reviewer sees change.
#
# The blocks together are the module graph. `jfast contracts check` rejects a
# call to a facade that is not listed here (undeclared-dependency) and any
# cycle (module-cycle): two modules that call each other cannot be extracted
# apart. Break a cycle by turning one direction into an event: the upstream
# module lists the event under publishes, the downstream one reacts with
# @subscribe("<type>") in its tasks.py and declares no depends_on for it.
# A subscription nobody declares publishing (orphan-subscription), an event a
# module builds without declaring it (undeclared-event) and a depends_on
# entry nothing uses (unused-dependency) are reported too.
#
#     [modules.advisor]
#     depends_on = ["receipt", "wallet"]
#
#     [modules.receipt]
#     publishes = ["receipt.registered"]
# ---------------------------------------------------------------------------
