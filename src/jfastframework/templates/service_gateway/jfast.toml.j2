# {{ service_title }} — API gateway configuration.
#
# The routes below are generated from jfast.workspace.toml. Re-run
# `jfast workspace gateway --force` after adding a service rather than editing
# this list by hand.

[app]
name = "{{ service_slug }}"
version = "0.1.0"
# No `env` here on purpose: it is a property of the deployment, not of the
# code. It defaults to "local"; a deployment sets JFAST_ENV=prod, which also
# wins over an `env` written in this file. See docs/deploy.md.
port = {{ port }}

[plugins]
enabled = ["observability", "metrics", "gateway"]
disabled = []

[plugin.observability]
# Development defaults: JFAST_LOG_LEVEL and JFAST_LOG_JSON_LOGS win over both
# (docs/deploy.md, "Which wins"). A deployment sets JFAST_LOG_JSON_LOGS=true.
level = "INFO"
json_logs = false   # readable in a dev terminal

[plugin.gateway]
timeout = 30.0
expose_routes = true

{% for route in routes %}
[[plugin.gateway.routes]]
prefix = "{{ route.prefix }}"
target = "{{ route.target }}"
strip_prefix = true

{% endfor %}
